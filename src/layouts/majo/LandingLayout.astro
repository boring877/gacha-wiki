---
// Landing layout for MAJO: Witches Night (mirrors desire-immortal-realm's LandingLayout).
import MajoBaseHead from '../../components/majo/MajoBaseHead.astro';
import GameSEO from '../../components/GameSEO.astro';
import Analytics from '../../components/Analytics.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameNavigationHeader from '../../components/GameNavigationHeader.astro';
import MobileMenu from '../../components/MobileMenu.astro';
import CustomScrollbar from '../../components/CustomScrollbar.astro';
import DecorativeLines from '../../components/DecorativeLines.astro';
import MajoBreadcrumb from '../../components/majo/MajoBreadcrumb.astro';
import { Image } from 'astro:assets';

import '../../styles/games/majo/majo-colors.css';
import '../../styles/global.css';
import '../../styles/typography.css';
import '../../styles/games/majo/majo-layout.css';
import '../../styles/games/majo/majo-common.css';

export interface Props {
  title: string;
  description?: string;
  gameTitle?: string;
  heroImage?: any;
  crumbName?: string;
  seoKeywords?: readonly string[];
}

const { title, description, gameTitle, heroImage, crumbName, seoKeywords } = Astro.props;
const seoTitle = `${title} | MAJO: Witches Night`;
const seoDescription =
  description ||
  'Complete guide for MAJO: Witches Night. Witch character database, skills, gacha rates, and lore for the R18 strategy gacha on EROLABS.';
---

<html lang="en">
  <head>
    <MajoBaseHead title={seoTitle} description={seoDescription} />
    <GameSEO
      gameKey="majo"
      title={seoTitle}
      description={seoDescription}
      additionalKeywords={seoKeywords}
    />
    <Analytics />
  </head>
  <body class="majo-body">
    <CustomScrollbar />
    <div class="bg-layer majo-bg-primary"></div>

    <div class="majo-content">
      <Header />
      <GameNavigationHeader currentPath={Astro.url.pathname} gameKey="majo" />
      <MobileMenu />

      <div class="majo-container">
        <main class="majo-main" id="main-content">
          {heroImage && gameTitle && (
            <section class="majo-hero-section">
              <div class="majo-hero-image-container">
                <Image
                  src={heroImage}
                  alt={gameTitle}
                  class="majo-hero-image"
                  width={1800}
                  height={640}
                  loading="eager"
                  decoding="async"
                />
                <div class="majo-hero-overlay" />
              </div>
              <h1 class="majo-title-only-heading">{gameTitle}</h1>
              <DecorativeLines />
            </section>
          )}

          {!heroImage && gameTitle && (
            <section class="majo-title-only-section">
              <h1 class="majo-title-only-heading">{gameTitle}</h1>
              <DecorativeLines />
            </section>
          )}

          <MajoBreadcrumb
            autoGenerate={true}
            gameKey="majo"
            showBackButton={true}
            currentPageName={crumbName}
          />

          <div class="content-area">
            <slot />
          </div>
        </main>
      </div>

      <Footer />
    </div>
  </body>
</html>
