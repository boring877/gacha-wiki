        <script is:inline>
          (function() {
            document.querySelectorAll('.rarity-stage-selector').forEach(function(sel) {
              var stages;
              try { stages = JSON.parse(sel.getAttribute('data-stages') || '{}'); } catch (e) { return; }
              var box = sel.closest('.character-stats-box');
              if (!box) return;
              sel.querySelectorAll('.rarity-stage-chip').forEach(function(chip) {
