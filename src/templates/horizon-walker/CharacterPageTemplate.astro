{
  characterData.weapon && (
    <section class="content-section weapon-section">
      <h2 class="section-title">Weapon: {characterData.weapon.name}</h2>
      <p class="character-stats-explanation">{(characterData.weapon as any).levelStats ? 'Base stats grow with weapon level (Lv 1 to Lv 60). EX raises (EX 1 to EX 5) only improve the unique skill.' : 'Stats and skills shown at Level 60 and full EX'}</p>

      <div class="weapon-flex">
        {/* Left: weapon art + basic stats */}
        <div class="weapon-image-container">
          <div class="weapon-image-box">
            <div class="weapon-image-wrapper">
              <WeaponImage
                imageName={characterData.weapon.image}
                alt={characterData.weapon.name}
                width={300}
                height={350}
                format="webp"
                quality={85}
                loading="lazy"
              />
            </div>
            <div class="weapon-meta-row">
              <span class="hw-badge" data-type="WeaponType">{characterData.weapon.type}</span>
              <HWRarityIcon rarity={characterData.weapon.rarity} width={48} height={24} />
            </div>
          </div>

          {(characterData.weapon as any).levelStats ? (
            <div class="weapon-basic-card">
              <h3 class="weapon-basic-title">Basic Stats (Lv 1 {'→'} Lv 60)</h3>
              <div class="stats-table">
                {Object.entries((characterData.weapon as any).levelStats).map(([stat, vals]: [string, any]) => {
                  const isPct = stat.includes('(%)');
                  const fmt = (v: number) => (isPct ? `+${v}%` : `${v}`);
                  return (
                    <div class="stats-row">
                      <span class="stats-row-label">{stat.replace(' (weapon)', ' (rating)')}</span>
                      <span class="stats-row-value">{fmt(vals[0])} {'→'} {fmt(vals[1])}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          ) : null}
        </div>

        {/* Right: unique skill (EX tabs) + signature skill */}
        <div class="weapon-skills-container">
          {highlightedWeaponSkills &&
            Object.entries(highlightedWeaponSkills).map(([key, skill]: [string, any]) => {
              const isSignature = String(skill.type || '').includes('Signature');
              const shortName = isSignature ? String(skill.name || '').replace(/^[^:]+Signature:\s*/, '') : skill.name;
              return (
                <div class={`weapon-skill-card2${isSignature ? ' weapon-skill-card2-sig' : ''}`}>
                  <div class="weapon-skill-head">
                    <h3 class="weapon-skill-head-title">{isSignature ? `Signature Skill: ${shortName}` : `Unique Skill: ${skill.name}`}</h3>
                    <span class="hw-badge" data-type={skill.type || 'Unique'}>{skill.type || 'Unique'}</span>
                  </div>

                  {!isSignature && (characterData.weapon as any).exLevels && (
                    <div class="weapon-ex-row">
                      <span class="weapon-ex-label">Skill values at raise:</span>
                      <div class="weapon-level-selector weapon-ex-tabs">
                        {[1, 2, 3, 4, 5].map((lv) => (
                          <button
                            type="button"
                            class={`weapon-level-chip${lv === 5 ? ' active' : ''}`}
                            data-weapon-level={lv}
                            title={`EX ${lv}`}
                            aria-label={`EX ${lv}`}
                          >
                            <img src={r2Url('horizon-walker', `tier-icons/UI_Tier_Icon_${String(5 + lv).padStart(2, '0')}.png`)} alt={`EX ${lv}`} width={40} height={38} loading="lazy" />
                          </button>
                        ))}
                      </div>
                      <span class="weapon-ex-view" data-ex-view>EX 5</span>
                    </div>
                  )}

                  <div class="weapon-skill-panel">
                    <p class="weapon-skill-description" data-desc-levels={!isSignature && (characterData.weapon as any).exLevels?.descByLevel ? JSON.stringify((characterData.weapon as any).exLevels.descByLevel) : undefined} set:html={safeRenderHtml(String(skill.description ?? "").replace(/\{\s*([-0-9.][-0-9.,%\s]*?)\s*\}/g, (_w, list) => { const vals = list.replace(/\s+/g, '').split(','); return `<span class="weapon-arr" data-vals="${list.replace(/\s+/g, '')}">${vals[vals.length - 1]}</span>`; })).content} />
                  </div>

                  {isSignature && (
                    <p class="weapon-skill-reqnote">
                      Requires {characterData.name}: only takes effect while {characterData.name} has this weapon equipped. Fixed: no weapon level or EX scaling.
                    </p>
                  )}
                  {skill.note && (
                    <div class="weapon-skill-note">
                      <strong>Note:</strong> {skill.note}
                    </div>
                  )}
                </div>
              );
            })}
        </div>
      </div>

        <script is:inline>
          (function() {
            document.querySelectorAll('.weapon-level-selector').forEach(function(sel) {
              var wrap = sel.closest('.weapon-section');
              if (!wrap) return;
              sel.querySelectorAll('.weapon-level-chip').forEach(function(chip) {
                chip.addEventListener('click', function() {
                  sel.querySelectorAll('.weapon-level-chip').forEach(function(c) { c.classList.remove('active'); });
                  chip.classList.add('active');
                  var lv = parseInt(chip.getAttribute('data-weapon-level')) || 5;
                  wrap.querySelectorAll('.weapon-arr').forEach(function(el) {
                    var vals = (el.getAttribute('data-vals') || '').split(',');
                    if (vals.length) el.textContent = vals[Math.min(lv, vals.length) - 1];
                  });
                  wrap.querySelectorAll('[data-effect-values]').forEach(function(el) {
                    var vals = (el.getAttribute('data-effect-values') || '').split('/');
                    if (vals.length) el.textContent = vals[Math.min(lv, vals.length) - 1].trim();
                  });
                  wrap.querySelectorAll('[data-desc-levels]').forEach(function(el) {
                    try {
                      var descs = JSON.parse(el.getAttribute('data-desc-levels'));
                      if (descs && descs.length) el.textContent = descs[Math.min(lv, descs.length) - 1];
                    } catch (e) {}
                  });
                  var view = wrap.querySelector('[data-ex-view]');
                  if (view) view.textContent = 'EX ' + lv;
                });
              });
            });
          })();
        </script>
    </section>
  )
}

<!-- Character Skins Section -->
{
  heroSkins.length > 1 && (
    <section class="content-section character-skins-section">
      <h2 class="section-title">Skins</h2>
      <div class="skins-grid">
        {heroSkins.filter((skin: any) => skin.promo).map((skin: any) => (
          <div class="skin-promo-card">
            <a href={r2Url('horizon-walker', skin.promo)} target="_blank" rel="noopener" class="skin-promo-link">
              <img
                src={r2Url('horizon-walker', skin.promo)}
                alt={`${characterData.name} ${skin.name} skin announcement art`}
                class="skin-promo-image"
                loading="lazy"
              />
            </a>
            <div class="skin-promo-caption">
              <span class="skin-number">{skin.number}</span>
              <span class="skin-promo-name">{skin.name}</span>
              {skin.promoCaption && <span class="skin-promo-note">{skin.promoCaption}</span>}
            </div>
          </div>
        ))}
        {heroSkins.map((skin) => (
          <div class={`skin-card${skin.isDefault ? ' skin-default' : ''}`}>
            <div class="skin-icon-wrap">
              <img
                src={r2Url('horizon-walker', `heroes/${skin.fullIcon || skin.icon}`)}
                alt={`${characterData.name} ${skin.name} skin`}
                width={150}
                height={220}
                loading="lazy"
                data-skin-icon={skin.icon}
                onerror={`if(this.dataset.step!=='i'){this.dataset.step='i';this.src='${r2Url('horizon-walker', `heroes/${skin.icon}`)}';}else if(this.dataset.step!=='d'){this.dataset.step='d';this.src='${r2Url('horizon-walker', `heroes/${heroSkins[0].icon}`)}';}else{this.onerror=null;}`}
              />
              <span class="skin-number">{skin.number}</span>
              <img
                class="skin-face-icon"
                src={r2Url('horizon-walker', `heroes/${skin.icon}`)}
                alt={`${characterData.name} ${skin.name} portrait icon`}
                width={56}
                height={56}
                loading="lazy"
                onerror={`this.onerror=null;this.style.display='none';`}
              />
            </div>
            <p class="skin-name">{skin.name}</p>
          </div>
        ))}
      </div>
    </section>
  )
}

<!-- Gift Preferences Section -->
<section class="content-section gift-section">
  <h2 class="section-title">Gift Preferences</h2>
  <p class="gift-explanation">
    Need 2000 points of affection to reach Level 5 to unlock trait bonus and also get gold and game
    currency too
  </p>

  {
    giftData ? (
      <div class="gift-container">
        {/* Level 5 Bonus */}
        {giftData.level5Bonus && (
          <div class="level5-bonus-card">
            <div class="level5-bonus-header">
              <h3 class="level5-bonus-title">Level 5 Affection Bonus</h3>
              <span class="hw-badge" data-type="Bonus">
                Affection Bonus
              </span>
            </div>
            <div class="level5-bonus-content">
              <span class="bonus-type">{giftData.level5Bonus.type}:</span>
              <span class="bonus-value">+{giftData.level5Bonus.value}</span>
            </div>
          </div>
        )}

        {/* High-Value Gifts */}
        {highValueGifts.length > 0 && (
          <div class="gift-category">
            <h3 class="gift-category-title">High-Value Gifts</h3>
            <p class="gift-category-description">
              These rare gifts provide exceptional affection points (80+ total) and are extremely
              valuable
            </p>
            <div class="gifts-grid">
              {highValueGifts.map((gift: any) => {
                const giftBoxes = findAllGiftBoxes(gift.id, gift.name);
                return (
                  <div class="gift-card high-value-gift">
                    <div class="gift-image-container">
                      <GiftImage
                        imageName={gift.image}
                        alt={gift.name}
                        width={80}
                        height={80}
                        format="webp"
                        quality={85}
                        loading="lazy"
                        class="gift-image"
                      />
                      <HWRarityIcon rarity={gift.rarity} width={36} height={18} class="gift-rarity-badge" />
                    </div>
                    <div class="gift-info">
                      <h4 class="gift-name">{gift.name}</h4>
                      <div class="gift-points">
                        <span class="points-label">Base:</span>
                        <span class="points-value">{gift.basePoints}</span>
                        <span class="points-label">+ Bonus:</span>
                        <span class="points-value bonus-points">+{gift.bonusPoints}</span>
                        <span class="points-label">= Total:</span>
                        <span class="points-total">{gift.totalPoints}</span>
                      </div>
                      <div class="gift-max-affection">
                        <span class="points-label">For Max Affection:</span>
                        <span class="points-value">{calculateGiftsNeeded(gift)} gifts</span>
                      </div>
                      {giftBoxes && (
                        <div class="gift-sources">
                          <span class="sources-label">Found in:</span>
                          <div class="gift-boxes">
                            {giftBoxes.map((boxInfo: any) => (
                              <div class="gift-box-item">
                                <GiftImage
                                  imageName={boxInfo.box.image}
                                  alt={boxInfo.box.name}
                                  width={32}
                                  height={32}
                                  format="webp"
                                  quality={85}
                                  loading="lazy"
                                  class="gift-box-image"
                                />
                                <span class="gift-box-name">{boxInfo.box.name}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* Favorite Gifts */}
        {regularFavoriteGifts.length > 0 && (
          <div class="gift-category">
            <h3 class="gift-category-title">Favorite Gifts</h3>
            <p class="gift-category-description">
              These gifts give bonus points (20+ more) and are highly valued by this character
            </p>
            <div class="gifts-grid">
              {regularFavoriteGifts.map((gift: any) => {
                const giftBoxes = findAllGiftBoxes(gift.id, gift.name);
                return (
                  <div class="gift-card favorite-gift">
                    <div class="gift-image-container">
                      <GiftImage
                        imageName={gift.image}
                        alt={gift.name}
                        width={80}
                        height={80}
                        format="webp"
                        quality={85}
                        loading="lazy"
                        class="gift-image"
                      />
                      <HWRarityIcon rarity={gift.rarity} width={36} height={18} class="gift-rarity-badge" />
                    </div>
                    <div class="gift-info">
                      <h4 class="gift-name">{gift.name}</h4>
                      <div class="gift-points">
                        <span class="points-label">Base:</span>
                        <span class="points-value">{gift.basePoints}</span>
                        <span class="points-label">+ Bonus:</span>
                        <span class="points-value bonus-points">+{gift.bonusPoints}</span>
                        <span class="points-label">= Total:</span>
                        <span class="points-total">{gift.totalPoints}</span>
                      </div>
                      <div class="gift-max-affection">
                        <span class="points-label">For Max Affection:</span>
                        <span class="points-value">{calculateGiftsNeeded(gift)} gifts</span>
                      </div>
                      {giftBoxes && (
                        <div class="gift-sources">
                          <span class="sources-label">Found in:</span>
                          <div class="gift-boxes">
                            {giftBoxes.map((boxInfo: any) => (
                              <div class="gift-box-item">
                                <GiftImage
                                  imageName={boxInfo.box.image}
                                  alt={boxInfo.box.name}
                                  width={32}
                                  height={32}
                                  format="webp"
                                  quality={85}
                                  loading="lazy"
                                  class="gift-box-image"
                                />
                                <span class="gift-box-name">{boxInfo.box.name}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* Liked Gifts */}
        {regularLikedGifts.length > 0 && (
          <div class="gift-category">
            <h3 class="gift-category-title">Liked Gifts</h3>
            <p class="gift-category-description">
              These gifts give 10 points more and are appreciated by this character
            </p>
            <div class="gifts-grid">
              {regularLikedGifts.map((gift: any) => {
                const giftBoxes = findAllGiftBoxes(gift.id, gift.name);
                return (
                  <div class="gift-card liked-gift">
                    <div class="gift-image-container">
                      <GiftImage
                        imageName={gift.image}
                        alt={gift.name}
                        width={200}
                        height={200}
                        format="webp"
                        quality={90}
                        loading="lazy"
                        class="gift-image"
                      />
                      <HWRarityIcon rarity={gift.rarity} width={36} height={18} class="gift-rarity-badge" />
                    </div>
                    <div class="gift-info">
                      <h4 class="gift-name">{gift.name}</h4>
                      <div class="gift-points">
                        <span class="points-label">Base:</span>
                        <span class="points-value">{gift.basePoints}</span>
                        <span class="points-label">+ Bonus:</span>
                        <span class="points-value bonus-points">+{gift.bonusPoints}</span>
                        <span class="points-label">= Total:</span>
                        <span class="points-total">{gift.totalPoints}</span>
                      </div>
                      <div class="gift-max-affection">
                        <span class="points-label">For Max Affection:</span>
                        <span class="points-value">{calculateGiftsNeeded(gift)} gifts</span>
                      </div>
                      {giftBoxes && (
                        <div class="gift-sources">
                          <span class="sources-label">Found in:</span>
                          <div class="gift-boxes">
                            {giftBoxes.map((boxInfo: any) => (
                              <div class="gift-box-item">
                                <GiftImage
                                  imageName={boxInfo.box.image}
                                  alt={boxInfo.box.name}
                                  width={32}
                                  height={32}
                                  format="webp"
                                  quality={85}
                                  loading="lazy"
                                  class="gift-box-image"
                                />
                                <span class="gift-box-name">{boxInfo.box.name}</span>
                              </div>
                            ))}
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* Alternative High-Value Option */}
        {!hasQueensTiara(giftData) &&
          giftData &&
          (regularFavoriteGifts.length > 0 || regularLikedGifts.length > 0) && (
            <div class="gift-category">
              <h3 class="gift-category-title">Alternative High-Value Option</h3>
              <p class="gift-category-description">
                Queen's Tiara provides the highest affection points (100) for any character,
                regardless of preferences
              </p>
              <div class="gifts-grid">
                <div class="gift-card high-value-gift">
                  <div class="gift-image-container">
                    <GiftImage
                      imageName={queensTiaraGift.image}
                      alt={queensTiaraGift.name}
                      width={80}
                      height={80}
                      format="webp"
                      quality={85}
                      loading="lazy"
                      class="gift-image"
                    />
                    <HWRarityIcon rarity={queensTiaraGift.rarity} width={36} height={18} class="gift-rarity-badge" />
                  </div>
                  <div class="gift-info">
                    <h4 class="gift-name">{queensTiaraGift.name}</h4>
                    <div class="gift-points">
                      <span class="points-label">Base:</span>
                      <span class="points-value">{queensTiaraGift.basePoints}</span>
                      <span class="points-label">+ Bonus:</span>
                      <span class="points-value bonus-points">+{queensTiaraGift.bonusPoints}</span>
                      <span class="points-label">= Total:</span>
                      <span class="points-total">{queensTiaraGift.totalPoints}</span>
                    </div>
                    <div class="gift-max-affection">
                      <span class="points-label">For Max Affection:</span>
                      <span class="points-value">
                        {calculateGiftsNeeded(queensTiaraGift)} gifts
                      </span>
                    </div>
                    <div class="gift-sources">
                      <span class="sources-label">Found in:</span>
                      <div class="gift-boxes">
                        <div class="gift-box-item">
                          <GiftImage
                            imageName="/images/games/horizon-walker/Gifts/Brilliant_Gift_Box.jpg"
                            alt="Brilliant Gift Box"
                            width={32}
                            height={32}
                            format="webp"
                            quality={85}
                            loading="lazy"
                            class="gift-box-image"
                          />
                          <span class="gift-box-name">Brilliant Gift Box</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}

        {/* No Gifts Available */}
        {(!giftData.favorites || giftData.favorites.length === 0) &&
          (!giftData.likes || giftData.likes.length === 0) && (
            <div class="no-gifts-card">
              <div class="no-gifts-content">
                <h3 class="no-gifts-title">Gift Preferences Coming Soon</h3>
                <p class="no-gifts-description">
                  Gift preferences for {characterData.name} have not been released yet. Check back
                  later for updates on their favorite gifts!
                </p>
              </div>
            </div>
          )}
      </div>
    ) : (
      <div class="no-gifts-card">
        <div class="no-gifts-content">
          <h3 class="no-gifts-title">Gift Preferences Coming Soon</h3>
          <p class="no-gifts-description">
            Gift preferences for {characterData.name} have not been released yet. Check back later
            for updates on their favorite gifts!
          </p>
        </div>
      </div>
    )
  }
</section>

