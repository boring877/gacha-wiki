<!-- Skills Section -->
<section class="content-section skills-section" data-skill-levels={skillLevelJson}>
  <h2 class="section-title">Skills</h2>
  <p class="skills-explanation">All skills shown at maximum level</p>

  {
    highlightedSkills && (() => {
      const skillGroups = groupSkillsByReplacement(highlightedSkills);

      return skillGroups.map((group) => {
        if (group.type === 'trigger-group') {
          // Render trigger skill with its replacement pairs
          const { triggerKey, triggerSkill, replacementPairs } = group.data;

          return (
            <div class="skill-trigger-complete-group">
              {/* Trigger skill */}
              <div class={getSkillCardClasses(triggerSkill, triggerKey, false, false, true)}>
                <div class="skill-header">
                  {triggerSkill.icon && (
                    <SkillIcon iconName={triggerSkill.icon} />
                  )}
                  <h3 class="skill-title">{triggerSkill.name}</h3>
                  <div class="skill-meta">
                    {triggerSkill.type === 'Passive' ? (
                      <span class="skill-type-label passive-label">Passive</span>
                    ) : (
                      <span class="skill-type-label skill-label">Skill</span>
                    )}
                    {skillLevelData[triggerKey] && (
                      <input type="number" class="skill-level-input" data-skill={triggerKey} min="1" max={skillLevelData[triggerKey].maxLevel} value={skillLevelData[triggerKey].maxLevel} />
                    )}
                    {triggerSkill.type !== 'Passive' && triggerSkill.cooldown != null && triggerSkill.cooldown > 0 && (
                      <span class="skill-cooldown">CD {triggerSkill.cooldown}</span>
                    )}
                  </div>
                </div>
                <p class="skill-description" set:html={safeRenderHtml(renderSkillDesc(triggerSkill.description, triggerKey)).content} />
                {triggerSkill.damage && (
                  <div class="skill-damage">
                    <span class="damage-label">Damage:</span>{' '}
                    <span class="damage-value" data-skill-key={triggerKey} data-damage-suffix={getDamageSuffix(triggerSkill.damage)}>
                      {formatDamage(triggerKey, triggerSkill.damage)}
                    </span>
                  </div>
                )}
              </div>

              {/* Replacement pairs */}
              {replacementPairs.map((pair, pairIndex) => (
                <div class="skill-replacement-group">
                  <div class="skill-replacement-header">
                    <p class="skill-replacement-condition">
                      {triggerSkill.name} enables: When [Seeker of Pleasure] is active
                    </p>
                  </div>
                  <div class="skill-replacement-pair">
                    {/* Base skill */}
                    <div class={getSkillCardClasses(pair.baseSkill, pair.baseKey, true, false, false)}>
                      <div class="skill-header">
                        {pair.baseSkill.icon && (
                          <SkillIcon iconName={pair.baseSkill.icon} />
                        )}
                        <h3 class="skill-title">{pair.baseSkill.name}</h3>
                        <div class="skill-meta">
                          {pair.baseSkill.type === 'Passive' ? (
                            <span class="skill-type-label passive-label">Passive</span>
                          ) : (
                            <span class="skill-type-label skill-label">Skill</span>
                          )}
                          {skillLevelData[pair.baseKey] && (
                            <input type="number" class="skill-level-input" data-skill={pair.baseKey} min="1" max={skillLevelData[pair.baseKey].maxLevel} value={skillLevelData[pair.baseKey].maxLevel} />
                          )}
                          {pair.baseSkill.type !== 'Passive' && pair.baseSkill.apCost != null && pair.baseSkill.apCost > 0 && (
                            <span class="skill-cost">AP {pair.baseSkill.apCost}</span>
                          )}
                          {pair.baseSkill.type !== 'Passive' && pair.baseSkill.cooldown != null && pair.baseSkill.cooldown > 0 && (
                            <span class="skill-cooldown">CD {pair.baseSkill.cooldown}</span>
                          )}
                        </div>
                      </div>
                      <p class="skill-description" set:html={safeRenderHtml(renderSkillDesc(pair.baseSkill.description, pair.baseKey)).content} />
                      {pair.baseSkill.damage && (
                        <div class="skill-damage">
                          <span class="damage-label">Damage:</span>{' '}
                          <span class="damage-value" data-skill-key={pair.baseKey} data-damage-suffix={getDamageSuffix(pair.baseSkill.damage)}>
                            {formatDamage(pair.baseKey, pair.baseSkill.damage)}
                          </span>
                        </div>
                      )}
                    </div>

                    {/* Arrow connector */}
                    <div class="skill-replacement-arrow"></div>

                    {/* Replacement skill */}
                    <div class={getSkillCardClasses(pair.replacementSkill, pair.replacementKey, false, true, false)}>
                      <div class="skill-header">
                        {pair.replacementSkill.icon && (
                          <SkillIcon iconName={pair.replacementSkill.icon} />
                        )}
                        <h3 class="skill-title">{pair.replacementSkill.name}</h3>
                        <div class="skill-meta">
                          {pair.replacementSkill.type === 'Passive' ? (
                            <span class="skill-type-label passive-label">Passive</span>
                          ) : (
                            <span class="skill-type-label skill-label">Skill</span>
                          )}
                          {skillLevelData[pair.replacementKey] && (
                            <input type="number" class="skill-level-input" data-skill={pair.replacementKey} min="1" max={skillLevelData[pair.replacementKey].maxLevel} value={skillLevelData[pair.replacementKey].maxLevel} />
                          )}
                          {pair.replacementSkill.type !== 'Passive' && pair.replacementSkill.apCost != null && pair.replacementSkill.apCost > 0 && (
                            <span class="skill-cost">AP {pair.replacementSkill.apCost}</span>
                          )}
                          {pair.replacementSkill.type !== 'Passive' && pair.replacementSkill.cooldown != null && pair.replacementSkill.cooldown > 0 && (
                            <span class="skill-cooldown">CD {pair.replacementSkill.cooldown}</span>
                          )}
                        </div>
                      </div>
                      <p class="skill-description" set:html={safeRenderHtml(renderSkillDesc(pair.replacementSkill.description, pair.replacementKey)).content} />
                      {pair.replacementSkill.damage && (
                        <div class="skill-damage">
                          <span class="damage-label">Damage:</span>{' '}
                          <span class="damage-value" data-skill-key={pair.replacementKey} data-damage-suffix={getDamageSuffix(pair.replacementSkill.damage)}>
                            {formatDamage(pair.replacementKey, pair.replacementSkill.damage)}
                          </span>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          );
        } else {
          // Render normal skill
          const { key, skill } = group.data;
          return (
            <div class={getSkillCardClasses(skill, key)}>
              <div class="skill-header">
                {skill.icon && (
                  <SkillIcon iconName={skill.icon} />
                )}
                <h3 class="skill-title">{skill.name}</h3>
                <div class="skill-meta">
                  {skill.type === 'Passive' ? (
                    <span class="skill-type-label passive-label">Passive</span>
                  ) : (
                    <span class="skill-type-label skill-label">Skill</span>
                  )}
                  {skillLevelData[key] && (
                    <input type="number" class="skill-level-input" data-skill={key} min="1" max={skillLevelData[key].maxLevel} value={skillLevelData[key].maxLevel} />
                  )}
                  {skill.type !== 'Passive' && skill.apCost != null && skill.apCost > 0 && (
                    <span class="skill-cost">AP {skill.apCost}</span>
                  )}
                  {skill.type !== 'Passive' && skill.cooldown != null && skill.cooldown > 0 && (
                    <span class="skill-cooldown">CD {skill.cooldown}</span>
                  )}
                </div>
              </div>
              <p class="skill-description" set:html={safeRenderHtml(renderSkillDesc(skill.description, key)).content} />
              {skill.damage && (
                <div class="skill-damage">
                  <span class="damage-label">Damage:</span>{' '}
                  <span class="damage-value" data-skill-key={key} data-damage-suffix={getDamageSuffix(skill.damage)}>
                    {formatDamage(key, skill.damage)}
                  </span>
                </div>
              )}
            </div>
          );
        }
      });
    })()
  }
  <script define:vars={{ skillLevelJson }}>
    (function() {
      var data = JSON.parse(skillLevelJson || '{}');
      var section = document.currentScript.closest('.skills-section');
      if (!section || !Object.keys(data).length) return;

      function updateDamage(input) {
        var key = input.getAttribute('data-skill');
        var level = parseInt(input.value) || 1;
        var maxLevel = parseInt(input.getAttribute('max')) || 10;
        if (level < 1) level = 1;
        if (level > maxLevel) level = maxLevel;
        input.value = level;

        var skillData = data[key];
        if (!skillData) return;
        var levelInfo = skillData.levels ? skillData.levels[String(level)] : null;

        var card = input.closest('.skill-card') || input.closest('[class*=skill]');
        if (!card) return;

        if (levelInfo) {
          var val = Math.round(parseFloat(levelInfo.min) * 100);
          card.querySelectorAll('.skill-n[data-skill-target="' + key + '"]').forEach(function(el) {
            el.textContent = val + '%';
          });
          var dmgEl = card.querySelector('[data-skill-key="' + key + '"]');
          if (dmgEl) {
            var suffix = dmgEl.getAttribute('data-damage-suffix') || '';
            dmgEl.textContent = val + '%' + suffix;
          }
        }

        // per-level value arrays inside the description: pick the value for this level
        card.querySelectorAll('.skill-arr[data-skill-target="' + key + '"]').forEach(function(el) {
          var vals = (el.getAttribute('data-vals') || '').split(',');
          if (!vals.length) return;
          el.textContent = vals[Math.min(level, vals.length) - 1];
        });
      }

      section.querySelectorAll('.skill-level-input').forEach(function(input) {
        input.addEventListener('input', function() { updateDamage(this); });
        input.addEventListener('change', function() { updateDamage(this); });
      });
    })();
  </script>
</section>

