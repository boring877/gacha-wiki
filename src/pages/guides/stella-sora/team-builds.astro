---
// Stella Sora Team Builds Page — the game's built-in System Presets.
// For every Trekker: the official recommended team (Main + 2 Supports), decoded
// from the SystemPreset table. Portraits served from the R2 bucket.
import TeamBuildLayout from '../../../layouts/stella-sora/TeamBuildLayout.astro';
import SSCharacterSmallImage from '../../../components/stella-sora/SSCharacterSmallImage.astro';
import { SYSTEM_PRESETS } from '../../../data/stella-sora/system-presets.js';

const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/stella-sora';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Stella Sora System Presets - Official Recommended Teams',
  description:
    'The built-in System Presets for every Stella Sora Trekker: the official recommended Main + 2 Support team compositions, extracted from the game data.',
  url: new URL(Astro.url.pathname, Astro.site),
  numberOfItems: SYSTEM_PRESETS.length,
};
---

<TeamBuildLayout
  title="Stella Sora Team Builds - Official System Preset Teams for Every Trekker"
  description="The game's built-in System Presets: recommended Main + 2 Support team compositions for all Stella Sora Trekkers, extracted directly from the game data."
  gameTitle="Team Builds"
>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="team-builds-page">
    <p class="tbuilds-intro">
      The game ships built-in <strong>System Presets</strong>: recommended team compositions for
      every Trekker, one per skin. Each team is Main + 2 Supports. Extracted directly from the game
      data, shown exactly as the game defines them.
    </p>

    <div class="tbuilds-controls">
      <input
        type="search"
        id="tbuilds-search"
        class="tbuilds-search"
        placeholder="Search Trekker or team member..."
        autocomplete="off"
      />
      <select id="tbuilds-element" class="tbuilds-select" aria-label="Filter by element">
        <option value="">All Elements</option>
        {['Aqua', 'Ignis', 'Terra', 'Ventus', 'Lux', 'Umbra'].map(el => (
          <option value={el}>{el}</option>
        ))}
      </select>
    </div>

    <div class="tbuilds-grid" id="tbuilds-grid">
      {
        SYSTEM_PRESETS.map(char => (
          <article
            class="tbuild-card"
            data-search={`${char.name} ${char.element} ${char.presets
              .flatMap(p => p.members.map(m => m.name))
              .join(' ')}`.toLowerCase()}
            data-element={char.element}
          >
            <div class="tbuild-card-head">
              <img
                class="tbuild-main-portrait"
                src={`${R2}/charart/${char.baseUnit}_SK.png`}
                alt={`${char.name} portrait`}
                width={100}
                height={192}
                loading="lazy"
                decoding="async"
              />
              <div class="tbuild-card-title">
                <h2 class="tbuild-name">
                  <a href={`/guides/stella-sora/characters/${char.slug}/`}>{char.name}</a>
                </h2>
                <span class={`element-badge element-${char.element.toLowerCase()}`}>
                  {char.element}
                </span>
                <span class="tbuild-grade">{char.grade}-Star</span>
              </div>
            </div>

            <div class="tbuild-presets">
              {char.presets.map((preset, i) => (
                <div class="tbuild-preset">
                  <div class="tbuild-preset-label">
                    Preset {i + 1}
                    <span class="tbuild-preset-skin">
                      {preset.skinType === 'base' ? 'Base' : 'Awakened'}
                    </span>
                  </div>
                  <div class="tbuild-members">
                    {preset.members.map(member => (
                      <a
                        class={`tbuild-member${member.slug === char.slug ? ' is-main' : ''}`}
                        href={`/guides/stella-sora/characters/${member.slug}/`}
                        title={member.name}
                      >
                        <SSCharacterSmallImage
                          characterName={member.slug}
                          alt={`${member.name} icon`}
                          width={48}
                          height={48}
                        />
                        <span class="tbuild-member-name">{member.name}</span>
                        <span
                          class={`tbuild-member-role${member.role === 'Main' ? ' role-main' : ''}`}
                        >
                          {member.role}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <p class="tbuilds-empty" id="tbuilds-empty" hidden>No Trekkers match your search.</p>
  </section>
</TeamBuildLayout>

<script>
  function initTeamBuildFilters() {
    const search = document.getElementById('tbuilds-search') as HTMLInputElement | null;
    const element = document.getElementById('tbuilds-element') as HTMLSelectElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.tbuild-card'));
    const empty = document.getElementById('tbuilds-empty');

    const apply = () => {
      const q = (search?.value || '').toLowerCase().trim();
      const el = element?.value || '';
      let visible = 0;
      cards.forEach(card => {
        const ok = (!q || card.dataset.search!.includes(q)) && (!el || card.dataset.element === el);
        card.style.display = ok ? '' : 'none';
        if (ok) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    };

    search?.addEventListener('input', apply);
    element?.addEventListener('change', apply);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTeamBuildFilters);
  } else {
    initTeamBuildFilters();
  }
</script>
