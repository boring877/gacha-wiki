---
// Muv-Luv Girls Garden game info page: facts as a flat label list, setting
// prose with subsections, and the full team table. No boxed containers.
import MLGGLayout from '../../../layouts/muv-luv-girls-garden/LandingLayout.astro';
import { girlsGardenCharacters, SCHOOLS, TEAMS } from '../../../data/muv-luv-girls-garden/characters.js';
import { mlggVariantHref } from '../../../data/muv-luv-girls-garden/default-variant.js';
import '../../../styles/games/muv-luv-girls-garden/mlgg-common.css';
import '../../../styles/games/muv-luv-girls-garden/mlgg-info.css';

const students = girlsGardenCharacters.length;
const cards = girlsGardenCharacters.reduce((n, c) => n + c.cards.length, 0);

// Team summary: members + schools + links to each student page.
const teamMap = new Map();
for (const ch of girlsGardenCharacters) {
  if (!teamMap.has(ch.team)) teamMap.set(ch.team, { members: [] });
  teamMap.get(ch.team).members.push(ch);
}
// Official EN team descriptions from the Steam demo master data (TeamMaster).
const TEAM_DESC_EN = {
  'シリウスシュガー': 'Led by Nanairo. No one can beat them at friendship!',
  'カラフルブーケ': 'Led by Aoi. Excels at precise team tactics.',
  'カオスメイデン': "A top team that reflects the leader Julia's personality.",
  'インスカーレット': 'A team made up solely of Hiiro under special permission.',
  'ピクシス・マスール': 'Led by Dorothea. Efficient teamwork is their strength.',
  'トレブルクインテット': 'Led by Flute. They all have talents outside of piloting.',
  'プレ・クラス－Ａ': 'A team from the Remedial Education Facility.',
};
const teams = [...teamMap.entries()]
  .map(([jp, info]) => {
    const schools = [...new Set(
      info.members.map(m => (m.school && m.school !== '-' ? SCHOOLS[m.school] || m.school : null)).filter(Boolean)
    )];
    return { jp, en: TEAMS[jp] || jp, schools, members: info.members, desc: TEAM_DESC_EN[jp] || null };
  })
  .sort((a, b) => b.members.length - a.members.length || a.en.localeCompare(b.en));

const facts = [
  { label: 'Developer', value: 'EXNOA × KMS', sub: 'Offered by DMM GAMES' },
  { label: 'Genre', value: 'Full-auto idle RPG', sub: '放置系RPG' },
  { label: 'Platforms', value: 'PC, Android, iOS', sub: 'PC browser / DMM GAMES PLAYER, DMM GAMES STORE' },
  { label: 'JP Launch', value: 'September 3, 2025', sub: 'Free to play, with in-app purchases' },
  { label: 'Steam Version', value: 'Worldwide, coming soon', sub: 'By MOEDOKI, Shiravune and aNCHOR. Free to play' },
  { label: 'Steam Demo', value: 'Live since September 17, 2026', sub: 'English, Simplified Chinese, Traditional Chinese' },
  { label: 'Companion App', value: 'Mellow Days', sub: 'Productivity ADV with Meru. November 2026, own demo since August 31, 2026' },
  { label: 'Age Rating', value: 'General + R18 builds', sub: 'DMM distributes both versions' },
  { label: 'Theme Song', value: 'Fukutsu no Fanfare', sub: '不屈のファンファーレ, sung by Koki Nakae' },
  { label: 'Roster', value: `${students} students, ${cards} Style Cards`, sub: `Across ${teams.length} teams` },
  { label: 'Staff', value: 'World: Tashiro Hayato', sub: 'Chara draft: Hasama, design: Siino / Pro-p, mecha: Wataru Inada' },
];
---

<MLGGLayout
  title="Game Info - Muv-Luv Girls Garden"
  description="Muv-Luv Girls Garden (マブラヴ ガールズガーデン) game info: developer, platforms, release dates, the world of Zar'tum and the Maze, and every team with its school and students."
  gameTitle="Game Info"
>
  <div class="mlgg-info-container">
    <section class="mlgg-section">
    <h2 class="mlgg-section-title">Game Facts</h2>
    <dl class="mlgg-facts-list">
      {facts.map(f => (
        <div class="mlgg-fact-row">
          <dt class="mlgg-fact-label">{f.label}</dt>
          <dd class="mlgg-fact-value">
            {f.value}
            <span class="mlgg-fact-sub">{f.sub}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mlgg-section">
    <h2 class="mlgg-section-title">Steam Version (Worldwide)</h2>
    <p class="mlgg-section-sub">Announced for Steam, published by MOEDOKI, Shiravune and aNCHOR Inc.</p>
    <p class="mlgg-info-p">
      On September 17, 2026 a free playable <strong>Steam demo</strong> went live, and the
      full <strong>free-to-play game</strong> is listed as coming soon. The Steam version
      supports <strong>English, Simplified Chinese and Traditional Chinese</strong>, with
      region-selectable servers, and carries over the full-auto idle RPG loop of the
      Japanese release: Main Quests, randomized Maze dives, Recruit (gacha) with a wishlist
      system, Groups (guilds), and PvP through Combined Tactical Exercises.
    </p>
    <p class="mlgg-info-p">
      A standalone companion app, <strong>MUV-LUV GIRLS GARDEN Mellow Days</strong>
      (November 2026, by DESK GARDEN PROJECT and aNCHOR), stars Meru Momozono as a
      productivity partner: Pomodoro timer, ToDo list, calendar, music and ambient sounds,
      with new conversations unlocking as you work. Its own free demo has been live since
      August 31, 2026. English names and terms on this wiki are taken from the official
      English text of the Steam demo.
    </p>
  </section>

  <section class="mlgg-section">
    <h2 class="mlgg-section-title">Setting</h2>
    <p class="mlgg-section-sub">Zar'tum, the academy city of prodigies</p>

    <h3 class="mlgg-info-h3">The academy city Zar'tum</h3>
    <p class="mlgg-info-p">
      Zar'tum is an academy city that gathers gifted students of scholarship, art, and
      sport from all over the world. Beneath it spreads the Maze, a colossal,
      shape-shifting underground space that is also the only source of Tatsumiya Ore, a
      resource of extraordinary value.
    </p>

    <h3 class="mlgg-info-h3">The Maze and the Maze Guarders</h3>
    <p class="mlgg-info-p">
      To mine the ore and answer the unknown threats inside, humanity built the Maze
      Guarder (MG), a giant humanoid machine with the mobility to handle the Maze's
      terrain. The students of Zar'tum Academy's school buildings ride them into the Maze,
      each flying the colors of their own team.
    </p>

    <h3 class="mlgg-info-h3">The story: an amnesiac Commander</h3>
    <p class="mlgg-info-p">
      The story begins when you, a Commander who has lost their memory, takes charge of
      these girls. Deeper in the Maze, riders of Tactical Surface Fighters who call
      themselves Eishi appear: guests from the world of the main Muv-Luv series.
    </p>
  </section>

  <section class="mlgg-section">
    <h2 class="mlgg-section-title">Teams</h2>
    <p class="mlgg-section-sub">
      {teams.length} squads across the schools of Zar'tum. Students link to their student
      list page.
    </p>
    <div class="mlgg-info-table-scroll">
      <table class="mlgg-table">
        <thead>
          <tr>
            <th>Team</th>
            <th>Japanese</th>
            <th>School</th>
            <th>Students</th>
          </tr>
        </thead>
        <tbody>
          {teams.map(t => (
            <tr>
              <td>
                {t.en}
                {t.desc && <p class="mlgg-team-desc-en">{t.desc}</p>}
              </td>
              <td>{t.jp}</td>
              <td>{t.schools.join(', ')}</td>
              <td>
                <div class="mlgg-team-members">
                  {t.members.map(m => (
                    <a href={mlggVariantHref(m.slug)} class="mlgg-team-member">
                      {m.nameEn || m.romaji}
                    </a>
                  ))}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    </section>
  </div>
</MLGGLayout>
