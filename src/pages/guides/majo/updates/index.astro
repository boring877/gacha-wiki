---
// MAJO update/patch history page, sourced from the official majo-x.com news archive.
import MajoLayout from '../../../../layouts/majo/LandingLayout.astro';
import { majoUpdates } from '../../../../data/majo/updates.js';
import '../../../../styles/games/majo/majo-updates.css';

const categoryClass = (c) => 'update-cat-' + c.toLowerCase();
---

<MajoLayout
  title="Updates & Patch Notes"
  description={`MAJO: Witches Night update history and patch notes: every version update, banner, event and maintenance from launch through today, sourced from the official news archive.`}
  gameTitle="Updates & Patch Notes"
  crumbName="Updates"
>
  <section>
    <div class="majo-updates-intro">
      <p class="majo-updates-intro-label">Sourced from the official news archive</p>
      <p class="majo-updates-intro-text">
        Every official update, event and maintenance note since launch, newest first.
        All times are UTC+8. Source links go to the
        <a href="https://majo-x.com/en/news/" target="_blank" rel="noopener noreferrer">official majo-x.com news archive</a>.
      </p>
    </div>

    {majoUpdates.map(u => (
      <article class="majo-update-entry">
        <div class="majo-update-head">
          <span class={`majo-update-cat ${categoryClass(u.category)}`}>{u.category}</span>
          <span class="majo-update-date">{u.display}</span>
        </div>
        <h2 class="majo-update-title">
          {u.url ? (
            <a href={u.url} target="_blank" rel="noopener noreferrer">{u.title}</a>
          ) : u.title}
        </h2>
        <ul class="majo-update-points">
          {u.points.map(p => <li>{p}</li>)}
        </ul>
      </article>
    ))}
  </section>
</MajoLayout>
