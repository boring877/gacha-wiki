---
// MAJO updates database: card grid of every official update, linking to detail pages.
import MajoLayout from '../../../../layouts/majo/LandingLayout.astro';
import { majoUpdates } from '../../../../data/majo/updates.js';
import '../../../../styles/games/majo/majo-updates.css';

const categoryClass = (c) => 'update-cat-' + c.toLowerCase();
---

<MajoLayout
  title="Updates & Patch Notes"
  description={`MAJO: Witches Night update database: every official version update, banner, event and maintenance note since launch, with full details and art.`}
  gameTitle="Updates & Patch Notes"
  crumbName="Updates"
>
  <section>
    <div class="majo-updates-intro">
      <p class="majo-updates-intro-label">Sourced from the official news archive</p>
      <p class="majo-updates-intro-text">
        Every official update, event and maintenance note since launch, newest first.
        Click any entry for the full details. All times are UTC+8. Raw sources live in the
        <a href="https://majo-x.com/en/news/" target="_blank" rel="noopener noreferrer">official majo-x.com news archive</a>.
      </p>
    </div>

    <div class="majo-updates-grid">
      {majoUpdates.map(u => (
        <a class="majo-update-card" href={`/guides/majo/updates/${u.slug}/`}>
          <div class="majo-update-card-art">
            <img
              src={u.image}
              alt={`${u.title} art`}
              loading="lazy"
              decoding="async"
              width={u.imageWidth}
              height={u.imageHeight}
            />
          </div>
          <div class="majo-update-card-body">
            <div class="majo-update-card-meta">
              <span class={`majo-update-cat ${categoryClass(u.category)}`}>{u.category}</span>
              <span class="majo-update-card-date">{u.display}</span>
            </div>
            <h2 class="majo-update-card-title">{u.title}</h2>
            <p class="majo-update-card-summary">{u.summary}</p>
            <span class="majo-update-card-more">Read more</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</MajoLayout>
