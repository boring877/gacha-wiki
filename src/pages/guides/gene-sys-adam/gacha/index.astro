---
// Gene-Sys: Adam gacha guide: machines, pool rates and guarantees.
import GSALayout from '../../../../layouts/gene-sys-adam/LandingLayout.astro';
import { gsaGachaMachines } from '../../../../data/gene-sys-adam/gacha.js';
import '../../../../styles/games/gene-sys-adam/gsa-common.css';

const machines = gsaGachaMachines;
// machineType labels observed in DrawMachineData
const typeLabels = {
  1: 'Standard',
  4: 'Limited / Event',
};
---

<GSALayout
  title="Gacha Guide"
  description="Gene-Sys: Adam gacha guide: all summon machines with pool weights, featured characters, free pulls and guarantee tips, from decrypted client data."
  gameTitle="Gacha"
  crumbName="Gacha"
>
  <section class="gsa-section">
    <h2 class="gsa-section-title">How Summoning Works</h2>
    <p class="gsa-gacha-intro">
      Gene-Sys: Adam runs multiple summon machines. Each machine draws through phases: the
      pool weight (group percent) decides which rarity bucket you roll into, then the per
      object weight picks the exact reward. Weights below come straight from the decrypted
      DrawSingleData table. Character names are shown for every pool entry.
    </p>
    <p class="gsa-gacha-intro">
      Duplicate characters convert into upgrade materials, and guarantee text is quoted
      verbatim from the client.
    </p>
  </section>

  {machines.map(m => (
    <section class="gsa-section">
      <h2 class="gsa-section-title">{m.name}</h2>
      <div class="gsa-detail-chips" style="margin-bottom:10px">
        <span class="gsa-chip">{typeLabels[m.machineType] || `Type ${m.machineType}`}</span>
        {m.wish && <span class="gsa-chip solid-gold">Wishlist</span>}
        {Number(m.freeTimes) > 0 && <span class="gsa-chip solid-accent">{m.freeTimes} free pulls</span>}
      </div>
      {m.guaranteeTip && <p class="gsa-gacha-tip">{m.guaranteeTip}</p>}
      {Object.entries(m.pools).map(([phaseId, groups]) => (
        <div class="gsa-pool">
          <h3 class="gsa-pool-title">Pool {phaseId}</h3>
          {Object.entries(groups).sort((a, b) => b[1].groupPercent - a[1].groupPercent).map(([gid, g]) => (
            <div class="gsa-pool-group">
              <div class="gsa-pool-group-head">
                <span class="gsa-chip solid-accent">{g.groupPercent}%</span>
                <span class="gsa-text-dim">group {gid}, {g.objects.length} entries</span>
              </div>
              <div class="gsa-pool-objects">
                {g.objects.slice(0, 24).map(o => (
                  <span class="gsa-chip">{o.type === 'character' ? o.name : `Item ${o.id}`}</span>
                ))}
                {g.objects.length > 24 && <span class="gsa-chip solid-muted">+{g.objects.length - 24} more</span>}
              </div>
            </div>
          ))}
        </div>
      ))}
    </section>
  ))}
</GSALayout>

<style>
  .gsa-gacha-intro {
    line-height: 1.7;
    margin: 0 0 10px;
    color: var(--gsa-text);
  }
  .gsa-gacha-tip {
    background: var(--gsa-accent-tint);
    border: 1px solid var(--gsa-border);
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.88rem;
    color: var(--gsa-text);
  }
  .gsa-pool {
    margin-top: 12px;
  }
  .gsa-pool-title {
    font-size: 0.95rem;
    margin: 0 0 8px;
    color: var(--gsa-text-dim);
  }
  .gsa-pool-group {
    background: var(--gsa-bg-tertiary);
    border: 1px solid var(--gsa-border);
    border-radius: 8px;
    padding: 10px 12px;
    margin-bottom: 8px;
  }
  .gsa-pool-group-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 0.82rem;
  }
  .gsa-pool-objects {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
</style>
