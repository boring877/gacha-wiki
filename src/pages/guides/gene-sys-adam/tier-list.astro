---
// Gene-Sys: Adam tier list: job sections with tier rows, same shape as the
// majo list. Reasons live in tier-list.js, not on the page.
import GSALayout from '../../../layouts/gene-sys-adam/LandingLayout.astro';
import { gsaTierByJob, GSA_TIER_UPDATED } from '../../../data/gene-sys-adam/tier-list.js';
import '../../../styles/games/gene-sys-adam/gsa-common.css';
import '../../../styles/games/gene-sys-adam/gsa-tier.css';

const total = gsaTierByJob.reduce((n, g) => n + g.tiers.reduce((m, t) => m + t.characters.length, 0), 0);
---

<GSALayout
  title="Tier List"
  description={`Gene-Sys: Adam tier list (${GSA_TIER_UPDATED}): all ${total} characters rated by job, from the decrypted kit numbers.`}
  gameTitle="Tier List"
  crumbName="Tier List"
>
  <section>
    {gsaTierByJob.map(group => (
      <div class="gsa-tier-job-section">
        <div class="gsa-tier-job-header">
          {group.icon && <img class="gsa-tier-job-icon" src={group.icon} alt="" width="40" height="40" loading="lazy" />}
          <h2 class="gsa-tier-job-title">{group.job}<span class="gsa-tier-job-zh">{group.zh}</span></h2>
          <span class="gsa-tier-job-count">
            {group.tiers.reduce((n, t) => n + t.characters.length, 0)} characters
          </span>
        </div>
        <div class="gsa-tier-grid">
          {group.tiers.map(row => (
            <div class="gsa-tier-row">
              <div class="gsa-tier-label">
                <span class="gsa-tier-name" style={`color:${row.color}`}>{row.tier}</span>
              </div>
              <div class="gsa-tier-characters">
                {row.characters.map(c => (
                  <a class="gsa-tier-card" href={`/guides/gene-sys-adam/characters/${c.slug}/`}>
                    {c.icon ? (
                      <img class="gsa-tier-thumb" src={c.icon} alt={c.name} loading="lazy" />
                    ) : (
                      <span class="gsa-tier-thumb gsa-monogram">{c.name?.[0]}</span>
                    )}
                    <span class={`gsa-tier-rarity gsa-tier-rarity-${(c.placement.rarity || 'sr').toLowerCase()}`}>{c.placement.rarity}</span>
                    <span class="gsa-tier-name-label">{c.name}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>
</GSALayout>
