---
// Community build detail page: renders the community spreadsheet build
// (Envy, Liauw & Gamekee) for one character. Deliberately separate from
// ../../[buildSlug].astro so hand-curated builds stay standalone and a
// character can have more than one build page.
import CharacterBuildLayout from '../../../../../layouts/horizon-walker/CharacterBuildLayout.astro';
import CharacterImage from '../../../../../components/horizon-walker/CharacterImage.astro';
import { HWRarityIcon } from '../../../../../components/horizon-walker/index.astro';
import CommunityBuildSection from '../../../../../components/horizon-walker/CommunityBuildSection.astro';
import { COMMUNITY_BUILDS } from '../../../../../data/horizon-walker/community-builds.js';
import { HORIZON_WALKER_CHARACTERS } from '../../../../../data/horizon-walker/characters.js';
import { characterBuildConfigs } from '../../../../../data/horizon-walker/builds/character-build-configs.js';

export function getStaticPaths() {
  return Object.keys(COMMUNITY_BUILDS).map((slug) => ({
    params: { buildSlug: slug },
  }));
}

const { buildSlug } = Astro.params;
const communityBuild = COMMUNITY_BUILDS[buildSlug];
const character = HORIZON_WALKER_CHARACTERS.find((c: any) => c.slug === buildSlug);

// Full per-character data (weapon art, skill icons) lives in the individual
// data modules; the characters.js index record does not carry them.
const charDataModules = import.meta.glob('../../../../../data/horizon-walker/characters/*.js', {
  eager: true,
});
let characterDetail: any = null;
for (const [path, mod] of Object.entries(charDataModules)) {
  if (path.split('/').pop()?.replace('.js', '') !== buildSlug) continue;
  characterDetail = Object.values(mod as Record<string, any>).find(
    (v) => v && typeof v === 'object' && v.name && v.skills
  );
  break;
}

if (!communityBuild || !character) {
  return Astro.redirect('/guides/horizon-walker/builds/community/');
}

const title = `${character.name} Community Build - Horizon Walker`;
const description = `Community-made build for ${character.name} in Horizon Walker: recommended weapon, stigma sets, substats priority, traits, and skill leveling order from the community builds spreadsheet.`;

// Hand-curated builds live on their own pages; point to it when one exists.
const hasHandBuild = Boolean(characterBuildConfigs[buildSlug]);
---

<CharacterBuildLayout title={title} description={description} characterName={character.name}>
  <div class="character-build-header">
    <div class="character-build-image">
      <CharacterImage
        imageName={character.image || character.name}
        alt={`${character.name} character portrait`}
        width={120}
        height={120}
        class="character-build-portrait"
        loading="eager"
      />
    </div>
    <div class="character-build-info">
      <h2 class="character-build-name">{character.name} Community Build</h2>
      <div class="character-build-badges">
        <span class="hw-badge" data-type="Cost">{character.cost}</span>
        <HWRarityIcon rarity={character.rarity} width={44} height={22} />
        <span class="character-tag damage-scaling">Community Build</span>
      </div>
      <div class="character-build-links">
        <a href={`/guides/horizon-walker/characters/${character.slug}/`}>Character page</a>
        {hasHandBuild && <a href={`/guides/horizon-walker/builds/${character.slug}/`}>Hand-curated build</a>}
      </div>
    </div>
  </div>

  <CommunityBuildSection communityBuild={communityBuild} character={characterDetail || character} />

  <!-- Core Stats Section -->
  <section class="character-build-section">
    <h3 class="character-build-section-title">Core Stats</h3>
    <div class="core-stats-explanation">
      <div class="stat-explanation-grid">
        <span
          ><span class="stat-name">Strength:</span>
          <span class="stat-description">Increases Melee ATK</span></span
        >
        <span
          ><span class="stat-name">Technic:</span>
          <span class="stat-description">Increases Ranged ATK</span></span
        >
        <span
          ><span class="stat-name">Intelligence:</span>
          <span class="stat-description">Increases Magic ATK</span></span
        >
        <span
          ><span class="stat-name">Vitality:</span>
          <span class="stat-description">Increases Max HP</span></span
        >
        <span
          ><span class="stat-name">Agility:</span>
          <span class="stat-description">Increases evasion and AP Recovery</span></span
        >
      </div>
    </div>
    <div class="core-stats-grid">
      <div class="core-stat-card">
        <div class="core-stat-title">Strength</div>
        <div class="core-stat-value">{character.stats?.strength || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Technic</div>
        <div class="core-stat-value">{character.stats?.technic || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Intelligence</div>
        <div class="core-stat-value">{character.stats?.intelligence || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Vitality</div>
        <div class="core-stat-value">{character.stats?.vitality || 'N/A'}</div>
      </div>
      <div class="core-stat-card">
        <div class="core-stat-title">Agility</div>
        <div class="core-stat-value">{character.stats?.agility || 'N/A'}</div>
      </div>
    </div>
  </section>
</CharacterBuildLayout>
