---
// Homepage - Now modular and clean
import HomePageLayout from '../layouts/HomePageLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, SITE } from '../consts';
import { getAllGames } from '../data/games';
import { getGameConfig } from '../utils/seo';

// Main site structured data — sourced from consts so it never goes stale.
const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE,
  url: 'https://gachawiki.info',
  description: SITE_DESCRIPTION,
  publisher: {
    '@type': 'Organization',
    name: SITE_TITLE,
    url: 'https://gachawiki.info',
    sameAs: [
      SITE.SOCIAL.GITHUB,
      SITE.SOCIAL.X,
      SITE.SOCIAL.DISCORD,
    ].filter(Boolean),
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://gachawiki.info/guides/?search={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
});

// Build the games ItemList from the single registry (src/data/games.ts),
// enriching each entry with its SEO description so this never goes stale.
const gamesItemList = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Gacha Games Wiki Collection',
  description: 'Complete wiki collection for popular gacha games',
  itemListElement: getAllGames().map((game, index) => {
    const seo = getGameConfig(game.id);
    return {
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'VideoGame',
        name: game.name,
        url: `https://gachawiki.info${game.url}`,
        description: seo?.description || `${game.name} wiki and character database`,
      },
    };
  }),
});
---

<HomePageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Main Site Structured Data + Games Collection.
       Built as full <script> strings and injected via Fragment set:html,
       because Astro strips/bundles <script> tags that contain JSX expressions
       and does not substitute expressions inside is:inline scripts. -->
  <Fragment set:html={
    `<script type="application/ld+json">${websiteSchema}</script>` +
    `<script type="application/ld+json">${gamesItemList}</script>`
  } />
</HomePageLayout>
