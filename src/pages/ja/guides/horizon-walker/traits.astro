---
// Japanese general-traits database: /ja/guides/horizon-walker/traits/
// All trait names and stat lines use the game's official Japanese;
// category headings are wiki editorial labels written for the ja wiki.
import HwLangLayout from '../../../../layouts/lang/HwLangLayout.astro';
import { hwTraits, totalTraits } from '../../../../data/horizon-walker/traits.js';
import { HW_ZH_TRAIT_NAMES, HW_ZH_STAT_TYPES } from '../../../../data/horizon-walker/ja/game-text.js';
import { HW_ZH } from '../../../../data/horizon-walker/ja/ui.js';
import '../../../../styles/games/horizon-walker/hw-traits.css';

export const prerender = true;

// Wiki editorial category headings (EN data key -> ja label)
const CATEGORY_ZH = {
  'Health & Vitality': '生命と体力',
  'HP Penalties': 'HP 代価',
  'Melee Attack': '近接攻撃',
  'Ranged Attack': '遠距離攻撃',
  'Magic Attack': '魔法攻撃',
  Speed: '速度',
  Accuracy: '命中',
  Critical: 'クリティカル',
  Evasion: '回避',
  Defense: '防御',
  'Specialized Defense': '特化防御',
  'Elemental Defense': '属性防御',
  'Attack Boosts': '攻撃タイプ強化',
  'Elemental Boosts': '属性強化',
  'Multi-Elemental': '複数属性',
  'AP & Starting': '行動力と開始時',
  'AP Recovery': '行動力回復',
  'Aggro Management': '敵視調整',
  'Knockback Resistance': 'ノックバック耐性',
  'Special Defense': '特殊防御',
};

// wiki EN stat spellings that point at the same official stat label
const STAT_ALIASES = {
  ACC: 'Accuracy',
  Evasion: 'Evade',
};

const statLabelJa = label => {
  const key = STAT_ALIASES[label] || label;
  return HW_ZH_STAT_TYPES[key] || label;
};

// 'Max HP: +3%' -> '最大HP：+3%'; unmapped labels keep the EN line verbatim
const effectJa = line => {
  const idx = line.indexOf(': ');
  if (idx < 1) return line;
  const label = line.slice(0, idx);
  const ja = statLabelJa(label.trim());
  if (ja === label.trim()) return line;
  return `${ja}：${line.slice(idx + 1).trim()}`;
};

const traitNameJa = name => HW_ZH_TRAIT_NAMES[name] || name;

const categoryNames = Object.keys(hwTraits).sort();

const createAnchorId = text => text.toLowerCase().replace(/[^a-z0-9]/g, '-');
---

<HwLangLayout lang="ja" ui={HW_ZH}
  title="特性データベース - ホライゾン・ウォーカー日本語ウィキ - GachaWiki"
  description={`ホライゾン・ウォーカーの全 ${totalTraits} 種の汎用特性データベース：特性名とステータス増減効果はゲーム公式の日本語で、用途別に分類して掲載しています。`}
  keywords={['ホライゾン・ウォーカー', '特性', '汎用特性', '攻略']}
  pageTitle="特性"
  breadcrumbItems={[
    { name: 'ホーム', href: '/' },
    { name: 'ホライゾン・ウォーカー', href: HW_ZH.baseUrl },
    { name: '特性' },
  ]}
>
  <div class="hw-traits-container">
    <div class="hw-traits-header">
      <h1 class="hw-traits-title">汎用特性</h1>
      <p class="hw-traits-subtitle">全キャラ共通の特性と効果一覧</p>
      <p class="hw-traits-total">全 {totalTraits} 種の特性</p>
    </div>

    <nav class="hw-traits-nav" role="navigation" aria-label="カテゴリナビゲーション">
      <h2 class="hw-traits-nav-title">カテゴリへ移動：</h2>
      <div class="hw-traits-nav-links">
        {
          categoryNames.map(category => {
            const categoryId = createAnchorId(category);
            return (
              <a href={`#${categoryId}`} class="hw-traits-nav-link">
                {CATEGORY_ZH[category] || category}
              </a>
            );
          })
        }
      </div>
    </nav>

    {
      categoryNames.map(categoryName => {
        const traitsInCategory = hwTraits[categoryName];
        if (!traitsInCategory || traitsInCategory.length === 0) return null;

        const categoryId = createAnchorId(categoryName);
        const traitCount = traitsInCategory.length;

        return (
          <section class="hw-traits-section" id={categoryId}>
            <div class="hw-traits-category-header">
              <h2 class="hw-traits-category-title">{CATEGORY_ZH[categoryName] || categoryName}</h2>
              <span class="hw-traits-category-count">（{traitCount} 件）</span>
            </div>
            <div class="hw-traits-grid">
              {traitsInCategory.map(trait => (
                <div class="hw-trait-card">
                  <h3 class="hw-trait-name">{traitNameJa(trait.name)}</h3>
                  <ul class="hw-trait-effects">
                    {trait.effects.map(effect => (
                      <li class="hw-trait-effect">{effectJa(effect)}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</HwLangLayout>
