---
// GachaWiki OGs — NFT collection page with an embedded mint widget
// (mint directly on this page via Robinhood Wallet / MetaMask on Robinhood Chain;
// art + metadata are served from Cloudflare Pages and show instantly — no reveal phase)
import HomeLayout from '../layouts/HomeLayout.astro';
import { SITE_TITLE } from '../consts';

const gallery = ['nft-001','nft-042','nft-077','nft-100','nft-150','nft-200','nft-256','nft-500','nft-777'];

const stats = [
  { k: '1,000', v: 'Total supply' },
  { k: '0.001068 ETH', v: 'Mint price (≈$2)' },
  { k: 'Robinhood', v: 'Chain (L2)' },
  { k: 'ERC-721', v: 'Standard' },
];
---

<HomeLayout
  title={`${SITE_TITLE} OGs — NFT Collection`}
  description="GachaWiki OGs — a 1,000-piece generative NFT collection on Robinhood Chain. Each OG is a unique hand-drawn mascot with a motivational verse (EN + 日本語) and kaomoji. Mint directly on this page."
  keywords={['GachaWiki', 'NFT', 'Robinhood Chain', 'mint', 'collectibles', 'gacha']}
>
  <div class="nft-page">
    <!-- Ambient background video (Seven Mortal Sins NCED) — full-bleed top, fades out by mid-page -->
    <div class="bg-video-wrap" aria-hidden="true">
      <video class="bg-video" autoplay muted loop playsinline preload="auto">
        <source src="/videos/sins-nced.mp4" type="video/mp4" />
      </video>
    </div>

    <!-- HERO -->
    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">◆ NFT Collection</span>
        <h1 class="hero-title">GachaWiki <span class="accent">OGs</span></h1>
        <p class="hero-sub">
          1,000 unique collectibles on <strong>Robinhood Chain</strong>. Each OG is the hand-drawn
          GachaWiki mascot carrying its own motivational verse in English &amp; 日本語 — plus a kaomoji.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#mint">Mint an OG — ~$2</a>
          <a class="btn btn-ghost" href="#gallery">See the collection</a>
        </div>
        <p class="contract-line">
          Contract:
          <a href="https://robinhoodchain.blockscout.com/address/0x33B4fC15A15D4D891B857a041c058da802B19136" target="_blank" rel="noopener noreferrer">0x33B4…9136</a>
          (ERC-721 · verified on Blockscout · art on Cloudflare)
        </p>
      </div>
      <div class="hero-art">
        <img src="/images/nft/hero.png" alt="GachaWiki OGs sample NFT" width="512" height="512" loading="eager" />
      </div>
    </section>

    <!-- MINT (directly on this page — no marketplace middleman) -->
    <section class="mint" id="mint">
      <div class="mint-card">
        <p class="mint-label">◆ Mint an OG</p>
        <div class="mint-row">
          <div class="qty" id="qtyBox">
            <button type="button" id="qtyMinus" aria-label="Mint one fewer">−</button>
            <span id="qtyVal">1</span>
            <button type="button" id="qtyPlus" aria-label="Mint one more">+</button>
          </div>
          <button type="button" class="btn btn-primary btn-mint" id="mintBtn">Connect Wallet</button>
        </div>
        <p class="mint-price" id="mintPriceLine">0.001068 ETH each · ≈$2</p>
        <p class="mint-status">5 per wallet · your art shows <strong>instantly</strong> — no reveal wait ★</p>
        <p class="minted-count" id="mintedCount">…</p>
        <p class="mint-msg" id="mintMsg" hidden></p>
      </div>
    </section>

    <script>
      // Embedded mint widget — talks to the GWOG contract on Robinhood Chain via the
      // injected EIP-1193 provider (Robinhood Wallet / MetaMask). No libraries.
      const CONTRACT = '0x33B4fC15A15D4D891B857a041c058da802B19136';
      const RPC_URL = 'https://rpc.mainnet.chain.robinhood.com';
      const EXPLORER = 'https://robinhoodchain.blockscout.com';
      const CHAIN_ID = '0x1237'; // 4663
      const CHAIN_PARAMS = {
        chainId: CHAIN_ID,
        chainName: 'Robinhood Chain',
        nativeCurrency: { name: 'Ether', symbol: 'ETH', decimals: 18 },
        rpcUrls: ['https://rpc.mainnet.chain.robinhood.com'],
        blockExplorerUrls: ['https://robinhoodchain.blockscout.com'],
      };
      // function selectors (keccak of the signatures)
      const SEL = {
        mint: '0xa0712d68', // mint(uint256)
        mintPrice: '0x6817c76c',
        maxPerWallet: '0x453c2310',
        mintedPerWallet: '0x3a602b4d', // mintedPerWallet(address)
        totalSupply: '0x18160ddd',
        paused: '0x5c975abb',
      };
      const MAX_SUPPLY = 1000;

      const eth = () => window.ethereum;
      const $ = (id) => document.getElementById(id);
      const btn = $('mintBtn');
      const msg = $('mintMsg');
      const qtyVal = $('qtyVal');

      let account = null;
      let priceWei = 1068000000000000n; // on-chain value replaces this at load
      let maxPerWallet = 5;
      let minted = 0; // this wallet's minted count
      let qty = 1;
      let busy = false;

      const say = (text, isError = false) => {
        msg.hidden = !text;
        msg.textContent = text || '';
        msg.classList.toggle('mint-err', isError);
      };
      const link = (url, label) => {
        msg.hidden = false;
        msg.appendChild(document.createElement('br'));
        const a = document.createElement('a');
        a.href = url; a.target = '_blank'; a.rel = 'noopener noreferrer'; a.textContent = label;
        msg.appendChild(a);
      };

      // ── read-only chain calls via public RPC ─────────────────────────
      const call = async (data, to = CONTRACT) => {
        const r = await fetch(RPC_URL, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'eth_call', params: [{ to, data }, 'latest'] }),
        }).then((x) => x.json());
        if (r.error) throw new Error(r.error.message);
        return r.result;
      };
      const hexToBig = (hex) => (hex && hex !== '0x' ? BigInt(hex) : 0n);

      async function refreshSupply() {
        try {
          const n = hexToBig(await call(SEL.totalSupply));
          $('mintedCount').textContent = `${n.toLocaleString()} / 1,000 minted`;
          if (n >= MAX_SUPPLY) {
            btn.disabled = true;
            btn.textContent = 'Sold out (╥﹏╥)';
          }
          return n;
        } catch { $('mintedCount').textContent = ''; }
      }

      async function loadConfig() {
        try {
          const [p, w, pausedHex] = await Promise.all([
            call(SEL.mintPrice), call(SEL.maxPerWallet), call(SEL.paused),
          ]);
          priceWei = hexToBig(p);
          maxPerWallet = Number(hexToBig(w));
          if (priceWei > 0n) {
            const priceEth = Number(priceWei) / 1e18;
            $('mintPriceLine').textContent = `${priceEth} ETH each · ≈$${(priceEth * 1879).toFixed(2)}`;
          }
          if (hexToBig(pausedHex) === 1n) {
            btn.disabled = true;
            btn.textContent = 'Minting paused';
            say('Minting is temporarily paused by the team. Check back soon.', true);
          }
        } catch { /* keep defaults */ }
      }

      async function loadWalletCount() {
        if (!account) return;
        try {
          minted = Number(hexToBig(await call(SEL.mintedPerWallet + account.toLowerCase().slice(2).padStart(64, '0'))));
          clampQty();
          if (minted >= maxPerWallet) {
            btn.disabled = true;
            btn.textContent = `You minted ${minted}/${maxPerWallet}`;
          }
        } catch { /* ignore */ }
      }

      // ── wallet helpers ────────────────────────────────────────────────
      async function ensureChain() {
        try {
          await eth().request({ method: 'wallet_switchEthereumChain', params: [{ chainId: CHAIN_ID }] });
        } catch (e) {
          if (e.code === 4902 || /unrecognized|unknown chain/i.test(e.message || '')) {
            await eth().request({ method: 'wallet_addEthereumChain', params: [CHAIN_PARAMS] });
          } else throw e;
        }
      }

      async function connect() {
        if (!eth()) {
          say('No wallet detected — open this page in the Robinhood Wallet browser or install MetaMask.', true);
          return false;
        }
        const accounts = await eth().request({ method: 'eth_requestAccounts' });
        account = accounts[0];
        await ensureChain();
        await loadWalletCount();
        return true;
      }

      const label = () => {
        const total = priceWei * BigInt(qty);
        btn.textContent = `Mint ${qty} OG${qty > 1 ? 's' : ''} · ${Number(total) / 1e18} ETH`;
      };

      function clampQty() {
        const room = Math.max(0, maxPerWallet - minted);
        qty = Math.min(Math.max(1, qty), Math.max(1, room));
        qtyVal.textContent = String(qty);
        label();
      }

      function mapError(e) {
        const m = (e && (e.message || e.data && e.data.message)) || '';
        if (e && e.code === 4001) return 'Transaction rejected in your wallet.';
        if (/Mint not started/i.test(m)) return 'Mint is not open yet.';
        if (/Sold out/i.test(m)) return 'Sold out!';
        if (/Per-wallet limit/i.test(m)) return `Limit reached — ${maxPerWallet} per wallet.`;
        if (/Wrong ETH value/i.test(m)) return 'Wrong amount sent — reload the page and try again.';
        if (/insufficient funds/i.test(m)) return 'Not enough ETH in your wallet for this mint.';
        if (/enforced paus/i.test(m)) return 'Minting is paused right now.';
        return m ? `Mint failed: ${m}` : 'Mint failed — please try again.';
      }

      async function waitForTx(hash) {
        for (let i = 0; i < 90; i++) {
          const r = await fetch(RPC_URL, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ jsonrpc: '2.0', id: 1, method: 'eth_getTransactionReceipt', params: [hash] }),
          }).then((x) => x.json());
          if (r.result && r.result.status !== null) return r.result.status === '0x1';
          await new Promise((res) => setTimeout(res, 4000));
        }
        return null;
      }

      async function doMint() {
        if (busy) return;
        if (!account) {
          busy = true;
          try { if (await connect() && account) await doMint(); } finally { busy = false; }
          return;
        }
        busy = true;
        btn.disabled = true;
        btn.textContent = 'Check wallet…';
        say('');
        try {
          await ensureChain();
          const value = priceWei * BigInt(qty);
          const txHash = await eth().request({
            method: 'eth_sendTransaction',
            params: [{
              from: account,
              to: CONTRACT,
              value: '0x' + value.toString(16),
              data: SEL.mint + qty.toString(16).padStart(64, '0'),
            }],
          });
          btn.textContent = 'Confirming…';
          say(`Transaction sent — confirming on chain… (${txHash.slice(0, 10)}…)`);
          link(`${EXPLORER}/tx/${txHash}`, 'View transaction ↗');
          const ok = await waitForTx(txHash);
          if (ok === true) {
            btn.textContent = 'Minted! ★';
            say('');
            link(`${EXPLORER}/tx/${txHash}`, `Minted ${qty} OG${qty > 1 ? 's' : ''}! Your art is live now — view transaction ↗`);
            await Promise.all([refreshSupply(), loadWalletCount()]);
          } else if (ok === false) {
            say('Transaction reverted on chain. Nothing was minted.', true);
          } else {
            say('Still confirming… check your wallet or the transaction link above.');
          }
        } catch (e) {
          say(mapError(e), true);
        } finally {
          busy = false;
          if (!btn.textContent.startsWith('You minted') && btn.textContent !== 'Sold out (╥﹏╥)') {
            btn.disabled = false;
            label();
          }
        }
      }

      // ── wire up ───────────────────────────────────────────────────────
      btn.addEventListener('click', doMint);
      $('qtyMinus').addEventListener('click', () => { qty--; clampQty(); });
      $('qtyPlus').addEventListener('click', () => { qty++; clampQty(); });

      if (eth()) {
        eth().request({ method: 'eth_accounts' }).then((accs) => {
          if (accs && accs[0]) { account = accs[0]; loadWalletCount(); }
        }).catch(() => {});
        eth().on?.('accountsChanged', (accs) => {
          account = accs && accs[0] ? accs[0] : null;
          minted = 0;
          if (account) {
            loadWalletCount();
          } else {
            btn.disabled = false;
            btn.textContent = 'Connect Wallet';
            clampQty();
          }
        });
        eth().on?.('chainChanged', () => { if (account) loadWalletCount(); });
      }

      clampQty();
      loadConfig();
      refreshSupply();
      setInterval(refreshSupply, 15000);
    </script>

    <!-- STATS -->
    <section class="stats">
      {stats.map((s) => (
        <div class="stat">
          <span class="stat-k">{s.k}</span>
          <span class="stat-v">{s.v}</span>
        </div>
      ))}
    </section>

    <!-- GALLERY -->
    <section id="gallery" class="gallery">
      <h2 class="sec-title">The Collection</h2>
      <p class="sec-sub">A peek at a few of the 1,000 OGs — what you mint is what you see, instantly.</p>
      <div class="grid">
        {gallery.map((id) => (
          <div class="tile">
            <img src={`/images/nft/${id}.png`} alt={`GachaWiki OG #${id.replace('nft-','')}`} width="512" height="512" loading="lazy" />
          </div>
        ))}
      </div>
    </section>

    <!-- DISCLAIMER -->
    <section class="disclaimer">
      <p>
        GachaWiki OGs is a fan-made, non-commercial community collectible and is not affiliated with
        or endorsed by any game developer or publisher. Minting involves gas fees and is done at your
        own risk. Always verify the contract address before minting.
      </p>
    </section>
  </div>
</HomeLayout>

<style>
  /* NFT collection landing page — styled to match the GachaWiki dark theme */
  .nft-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(2rem, 5vw, 4.5rem) clamp(1rem, 4vw, 2.5rem) 4rem;
    color: var(--text-inverse);
    font-family: 'DM Sans', system-ui, sans-serif;
    position: relative;
  }

  /* keep real content above the ambient video */
  .nft-page > section { position: relative; z-index: 1; }

  /* Ambient background video — visible at top, fades to nothing by mid-page */
  .bg-video-wrap {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 78vh;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 22%, transparent 82%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 22%, transparent 82%);
  }
  @media (prefers-reduced-motion: reduce) {
    .bg-video-wrap { display: none; }
  }

  /* HERO */
  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    padding: clamp(1.5rem, 4vw, 3rem) 0;
  }
  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--amber-glow);
    margin-bottom: 0.9rem;
    font-weight: 600;
  }
  .hero-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 1;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }
  .accent { color: var(--amber-glow); }
  .hero-sub {
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.65;
    color: var(--neutral-300);
    max-width: 46ch;
    margin: 0 0 1.8rem;
  }
  .cta-row { display: flex; flex-wrap: wrap; gap: 0.9rem; }
  .contract-line { margin: 1.1rem 0 0; font-size: 0.82rem; color: var(--neutral-400); }
  .contract-line a { color: var(--teal-crystal); text-decoration: none; }
  .contract-line a:hover { text-decoration: underline; }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.6rem;
    border-radius: 0.7rem;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: transform 0.15s ease, background 0.15s ease;
    min-height: 48px;
  }
  .btn-primary { background: var(--amber-glow); color: #1c1c1c; }
  .btn-primary:hover { transform: translateY(-2px); }
  .btn-primary:disabled { opacity: 0.55; cursor: not-allowed; transform: none; }
  .btn-ghost { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.25); }
  .btn-ghost:hover { border-color: var(--teal-crystal); color: var(--teal-crystal); }

  .hero-art img {
    width: 100%;
    max-width: 460px;
    aspect-ratio: 1 / 1;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 183, 77, 0.25);
  }
  .hero-art { display: flex; justify-content: center; }

  /* MINT WIDGET */
  .mint { padding: 1rem 0 0.5rem; }
  .mint-card {
    background: rgba(255, 183, 77, 0.08);
    border: 1px solid rgba(255, 183, 77, 0.4);
    border-radius: 1rem;
    padding: 1.4rem 1.6rem;
    text-align: center;
  }
  .mint-label { color: var(--amber-glow); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; font-size: 0.85rem; margin: 0 0 1rem; }
  .mint-row { display: flex; gap: 0.8rem; justify-content: center; align-items: stretch; flex-wrap: wrap; }
  .btn-mint { min-width: 260px; }
  .qty {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    border: 1px solid rgba(255, 183, 77, 0.4);
    border-radius: 0.7rem;
    overflow: hidden;
  }
  .qty button {
    background: rgba(255, 183, 77, 0.12);
    border: none;
    color: var(--amber-glow);
    font-size: 1.2rem;
    font-weight: 700;
    width: 48px;
    min-height: 48px;
    cursor: pointer;
  }
  .qty button:hover { background: rgba(255, 183, 77, 0.25); }
  .qty span {
    min-width: 44px;
    text-align: center;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
  }
  .mint-price { margin: 0.9rem 0 0; color: var(--neutral-300); font-size: 0.92rem; }
  .mint-status { margin: 0.35rem 0 0; color: var(--neutral-300); font-size: 0.92rem; }
  .mint-status a { color: var(--teal-crystal); }
  .minted-count { margin: 0.35rem 0 0; color: var(--amber-glow); font-family: 'Space Grotesk', sans-serif; font-weight: 700; }
  .mint-msg { margin: 0.8rem 0 0; color: var(--neutral-300); font-size: 0.92rem; word-break: break-word; }
  .mint-msg a { color: var(--teal-crystal); }
  .mint-msg.mint-err { color: #fca5a5; }

  /* STATS */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin: 2.5rem 0;
  }
  .stat {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 0.9rem;
    padding: 1.3rem 1rem;
    text-align: center;
  }
  .stat-k { display: block; font-family: 'Space Grotesk', sans-serif; font-size: 1.6rem; font-weight: 700; color: var(--amber-glow); }
  .stat-v { display: block; font-size: 0.85rem; color: var(--neutral-400); margin-top: 0.25rem; }

  /* SECTION TITLES */
  .sec-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0 0 0.4rem;
    letter-spacing: -0.01em;
  }
  .sec-sub { color: var(--neutral-400); margin: 0 0 1.8rem; }
  section { padding: 2.5rem 0; }

  /* GALLERY */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .tile {
    border-radius: 0.9rem;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.03);
  }
  .tile img { width: 100%; aspect-ratio: 1 / 1; display: block; }

  /* DISCLAIMER */
  .disclaimer {
    margin-top: 2rem;
    padding: 1.4rem 1.6rem;
    border-radius: 0.9rem;
    background: rgba(255, 183, 77, 0.08);
    border: 1px solid rgba(255, 183, 77, 0.4);
  }
  .disclaimer p { margin: 0; color: var(--neutral-300); font-size: 0.9rem; line-height: 1.6; }

  /* RESPONSIVE */
  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; text-align: center; }
    .hero-copy { order: 2; }
    .hero-art { order: 1; }
    .eyebrow { margin-bottom: 0.6rem; }
    .cta-row { justify-content: center; }
    .hero-sub { margin-left: auto; margin-right: auto; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<style is:global>
  /* Let the ambient background video reach the full page width (left & right edges)
     without introducing a horizontal scrollbar on the NFT page. */
  main {
    overflow-x: hidden;
  }
</style>
