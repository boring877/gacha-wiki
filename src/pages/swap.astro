---
// GachaWiki Swap — a branded swap page executing on Uniswap V3 / Robinhood Chain.
// Custom frontend, Uniswap handles routing/execution. The heavy swap module
// (src/scripts/swap.ts) is lazy-loaded so it only downloads on this page.
import HomeLayout from '../layouts/HomeLayout.astro';
import { SITE_TITLE } from '../consts';
---

<HomeLayout title={`${SITE_TITLE} - Swap`} description="Swap tokens on Robinhood Chain. Powered by Uniswap.">
  <div class="swap-page">
    <h1 class="swap-page-title">Swap</h1>
    <p class="swap-page-subtitle">Trade tokens on Robinhood Chain · Powered by Uniswap V3</p>

    <div class="swap-card">
      <!-- Settings row: slippage tolerance -->
      <div class="swap-settings-row">
        <span class="swap-settings-current" id="swap-slippage-current">Slippage: 0.5%</span>
        <button class="swap-settings-gear" id="swap-settings-btn" type="button" aria-label="Swap settings" aria-expanded="false">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" stroke="currentColor" stroke-width="2"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      <!-- Slippage popover (toggled by the gear) -->
      <div class="swap-settings-popover" id="swap-settings-popover" hidden>
        <span class="swap-settings-popover-title">Slippage tolerance</span>
        <div class="swap-slippage-presets">
          <button class="swap-slippage-preset" type="button" data-slippage="0.1">0.1%</button>
          <button class="swap-slippage-preset is-active" type="button" data-slippage="0.5">0.5%</button>
          <button class="swap-slippage-preset" type="button" data-slippage="1">1%</button>
          <button class="swap-slippage-preset" type="button" data-slippage="3">3%</button>
        </div>
        <div class="swap-slippage-custom">
          <input
            class="swap-slippage-input"
            id="swap-slippage-custom"
            type="text"
            inputmode="decimal"
            placeholder="Custom"
            autocomplete="off"
            spellcheck="false"
          />
          <span class="swap-slippage-unit">%</span>
        </div>
        <span class="swap-slippage-warn" id="swap-slippage-warn" hidden></span>
      </div>

      <!-- Token IN -->
      <div class="swap-field">
        <span class="swap-field-label">You pay</span>
        <div class="swap-field-row">
          <input
            class="swap-amount-input"
            id="swap-amount-in"
            type="text"
            inputmode="decimal"
            placeholder="0.0"
            autocomplete="off"
            spellcheck="false"
          />
          <div class="swap-token-badge-static" id="swap-badge-in">
            <img class="swap-token-logo" id="swap-logo-in"
                 src="https://assets.trustwalletapp.com/blockchains/ethereum/info/logo.png"
                 data-fallback="/favicon.ico"
                 onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.dataset.fallback='';}"
                 alt="" width="48" height="48" />
            <span class="swap-token-symbol" id="swap-symbol-in">ETH</span>
          </div>
        </div>
        <div class="swap-field-balance">
          <span>Balance: <span id="swap-balance-in">—</span></span>
          <button class="swap-max-btn" id="swap-max-btn" type="button">MAX</button>
        </div>
      </div>

      <!-- Flip -->
      <div class="swap-flip-wrap">
        <button class="swap-flip-btn" id="swap-flip-btn" type="button" aria-label="Flip tokens">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M7 10l-3-3 3-3M4 7h13a4 4 0 0 1 0 8h-1M17 14l3 3-3 3M20 17H7a4 4 0 0 1 0-8h1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>

      <!-- Token OUT -->
      <div class="swap-field">
        <span class="swap-field-label">You receive</span>
        <div class="swap-field-row">
          <input
            class="swap-amount-input"
            id="swap-amount-out"
            type="text"
            placeholder="0.0"
            readonly
            tabindex="-1"
          />
          <div class="swap-token-badge-static" id="swap-badge-out">
            <img class="swap-token-logo" id="swap-logo-out"
                 src="https://assets.trustwalletapp.com/blockchains/robinhoodchain/assets/0x50be7832849efedb15611799074fcc409522f27a/logo.png"
                 data-fallback="/android-chrome-192x192.png"
                 onerror="if(this.dataset.fallback){this.src=this.dataset.fallback;this.dataset.fallback='';}"
                 alt="" width="48" height="48" />
            <span class="swap-token-symbol" id="swap-symbol-out">GW</span>
          </div>
        </div>
        <div class="swap-field-balance">
          <span>Balance: <span id="swap-balance-out">—</span></span>
        </div>
      </div>

      <!-- Quote details -->
      <div class="swap-detail" id="swap-detail" hidden>
        <div class="swap-detail-row">
          <span>Rate</span>
          <span class="swap-detail-value" id="swap-rate">—</span>
        </div>
        <div class="swap-detail-row">
          <span>Price impact</span>
          <span class="swap-detail-value" id="swap-impact">—</span>
        </div>
        <div class="swap-detail-row">
          <span>Min. received</span>
          <span class="swap-detail-value" id="swap-min-received">—</span>
        </div>
        <div class="swap-detail-row">
          <span>Route</span>
          <span class="swap-detail-value" id="swap-route">—</span>
        </div>
      </div>

      <!-- Action -->
      <button class="swap-action-btn" id="swap-action-btn" type="button" disabled>Connect Wallet</button>
      <div class="swap-status" id="swap-status"></div>
    </div>

    <!-- Live GW/WETH price chart (DexScreener embed). Same data source as the
         token banner. Loads on every /swap visit but is a separate iframe, so
         it doesn't block the swap UI. -->
    <div class="swap-chart-card">
      <iframe
        class="swap-chart-frame"
        src="https://dexscreener.com/robinhood/0xa9ffaf245686212f7c6f73e7ccd1592e9a5b4923?embed=1&theme=dark"
        title="GW / WETH live chart"
        loading="lazy"
      ></iframe>
    </div>
  </div>

  <!-- is:global so dynamically-created elements also get styled. -->
  <style is:global>@import '../styles/pages/swap.css';</style>
</HomeLayout>

<script>
  // Swap page controller. Lazy-loads src/scripts/swap.ts (which pulls viem) so
  // the heavy bundle only downloads on /swap. Mirrors the wallet.ts lazy pattern.
  // All on-chain calls are client-side (site output is 'static').
  // This page swaps exactly one pair — ETH ↔ $GW — so there's no token picker:
  // the fields are fixed and the flip button switches direction.

  let swapModPromise: Promise<typeof import('../scripts/swap')> | null = null;
  function loadSwap(): Promise<typeof import('../scripts/swap')> {
    if (!swapModPromise) swapModPromise = import('../scripts/swap');
    return swapModPromise;
  }

  // Lightweight wallet access without loading the full wallet module eagerly —
  // we reuse the existing singleton via a dynamic import.
  let walletModPromise: Promise<typeof import('../scripts/wallet')> | null = null;
  function loadWallet(): Promise<typeof import('../scripts/wallet')> {
    if (!walletModPromise) walletModPromise = import('../scripts/wallet');
    return walletModPromise;
  }

  // --- state -------------------------------------------------------------
  // The swap is fixed to the ETH ↔ $GW pair. Logos are pulled from the Trust
  // Wallet assets CDN — the same source wallets (MetaMask, Trust, 1inch…) use
  // to render token icons. GW isn't in that registry yet, so it falls back to
  // the in-repo GachaWiki brand icon (the file Blockscout registers as GW's
  // icon) via the <img onerror> handler in the markup.
  interface SwapToken {
    address: string;
    symbol: string;
    decimals: number;
    logo: string;       // primary (Trust Wallet CDN)
    logoFallback: string; // used if the CDN logo 404s
  }
  const TRUST = 'https://assets.trustwalletapp.com/blockchains/robinhoodchain';
  // NATIVE sentinel = 0x0 (native ETH). $GW ERC-20 on Robinhood Chain.
  const NATIVE = '0x0000000000000000000000000000000000000000';
  let tokenIn: SwapToken = {
    address: NATIVE, symbol: 'ETH', decimals: 18,
    // ETH is ETH on every chain — pull the canonical Ethereum logo, not the
    // per-chain one.
    logo: 'https://assets.trustwalletapp.com/blockchains/ethereum/info/logo.png',
    logoFallback: '/favicon.ico',
  };
  let tokenOut: SwapToken = {
    address: '0x50bE7832849EFEdB15611799074FcC409522f27A', symbol: 'GW', decimals: 18,
    logo: `${TRUST}/assets/0x50be7832849efedb15611799074fcc409522f27a/logo.png`,
    logoFallback: '/android-chrome-192x192.png', // in-repo GachaWiki brand icon (Blockscout's GW icon_url)
  };

  let quoteTimer: ReturnType<typeof setTimeout> | undefined;
  let currentQuote: { amountOut: bigint; impact: number; route: string } | null = null;

  // --- slippage tolerance ------------------------------------------------
  // Stored as a fraction (0.005 = 0.5%). Default 0.5%; caps the min-received
  // calc and the on-chain minAmountOut so a swap reverts if the price moves
  // more than this between quote and execution.
  let slippagePct = 0.5; // percent, e.g. 0.5 = 0.5%
  const SLIPPAGE_MIN = 0.01; // 0.01%
  const SLIPPAGE_MAX = 50;   // 50% (above this is almost certainly a typo)

  // --- element refs ------------------------------------------------------
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const amountInEl = $<HTMLInputElement>('swap-amount-in');
  const amountOutEl = $<HTMLInputElement>('swap-amount-out');
  const symbolInEl = $('swap-symbol-in');
  const symbolOutEl = $('swap-symbol-out');
  const balanceInEl = $('swap-balance-in');
  const balanceOutEl = $('swap-balance-out');
  const maxBtn = $<HTMLButtonElement>('swap-max-btn');
  const flipBtn = $('swap-flip-btn');
  const actionBtn = $<HTMLButtonElement>('swap-action-btn');
  const statusEl = $('swap-status');
  const detailEl = $('swap-detail');
  const rateEl = $('swap-rate');
  const impactEl = $('swap-impact');
  const minReceivedEl = $('swap-min-received');
  const routeEl = $('swap-route');
  const slippageCurrentEl = $('swap-slippage-current');
  const settingsBtn = $('swap-settings-btn');
  const settingsPopover = $('swap-settings-popover');
  const slippageCustomEl = $<HTMLInputElement>('swap-slippage-custom');
  const slippageWarnEl = $('swap-slippage-warn');
  const slippagePresetEls = Array.from(document.getElementsByClassName('swap-slippage-preset')) as HTMLButtonElement[];
  const logoInEl = $<HTMLImageElement>('swap-logo-in');
  const logoOutEl = $<HTMLImageElement>('swap-logo-out');

  // --- helpers -----------------------------------------------------------
  function fmtAmount(bi: bigint, decimals: number): string {
    const whole = bi / 10n ** BigInt(decimals);
    const frac = bi % 10n ** BigInt(decimals);
    let s = whole.toString();
    if (decimals > 0 && frac > 0n) {
      let f = frac.toString().padStart(decimals, '0').replace(/0+$/, '').slice(0, 6);
      if (f) s += '.' + f;
    }
    return s;
  }

  function setStatus(msg: string, kind: '' | 'error' | 'success' = '') {
    statusEl.textContent = msg;
    statusEl.className = 'swap-status' + (kind ? ` is-${kind}` : '');
  }

  function updateTokenLabels() {
    symbolInEl.textContent = tokenIn.symbol;
    symbolOutEl.textContent = tokenOut.symbol;
    // Swap the logos to match the (possibly flipped) direction. data-fallback is
    // read by the <img onerror> in the markup so a 404 on the Trust CDN falls
    // back to the local icon without a JS round-trip.
    logoInEl.dataset.fallback = tokenIn.logoFallback;
    logoOutEl.dataset.fallback = tokenOut.logoFallback;
    logoInEl.src = tokenIn.logo;
    logoOutEl.src = tokenOut.logo;
  }

  /** Min amount out for the current slippage tolerance: amountOut * (1 - pct/100).
   *  Uses bps internally (pct → basis points, integer) for exact bigint math. */
  function minReceivedFor(amountOut: bigint): bigint {
    const keepBps = BigInt(Math.round(10000 - slippagePct * 100)); // e.g. 0.5% → 9950
    return (amountOut * keepBps) / 10000n;
  }

  // --- quote (debounced) -------------------------------------------------
  function scheduleQuote() {
    if (quoteTimer) clearTimeout(quoteTimer);
    quoteTimer = setTimeout(runQuote, 350);
  }

  async function runQuote() {
    const raw = amountInEl.value.trim();
    if (!raw || isNaN(Number(raw)) || Number(raw) <= 0) {
      amountOutEl.value = '';
      detailEl.hidden = true;
      currentQuote = null;
      updateActionButton();
      return;
    }

    try {
      const { parseUnits, getQuote } = await loadSwap();
      // parse with the token's decimals (cap fractional digits)
      const amountIn = parseUnits(raw, tokenIn.decimals);
      const q = await getQuote(tokenIn.address as `0x${string}`, tokenOut.address as `0x${string}`, amountIn);
      if (!q) {
        amountOutEl.value = '';
        detailEl.hidden = true;
        currentQuote = null;
        setStatus('No liquidity for this pair', 'error');
        updateActionButton();
        return;
      }
      setStatus('');
      currentQuote = { amountOut: q.amountOut, impact: q.priceImpactPct, route: q.routeDescription };
      amountOutEl.value = fmtAmount(q.amountOut, tokenOut.decimals);

      // details
      const rateNum = Number(q.amountOut) / Number(10n ** BigInt(tokenOut.decimals)) / Number(raw);
      rateEl.textContent = `1 ${tokenIn.symbol} ≈ ${rateNum ? rateNum.toPrecision(4) : '—'} ${tokenOut.symbol}`;
      impactEl.textContent = q.priceImpactPct > 0 ? `${q.priceImpactPct.toFixed(2)}%` : '—';
      impactEl.className = 'swap-detail-value' + (q.priceImpactPct >= 5 ? ' is-danger' : q.priceImpactPct >= 1 ? ' is-warning' : '');
      // min received = quoted output minus the user's slippage tolerance
      const minOut = minReceivedFor(q.amountOut);
      minReceivedEl.textContent = `${fmtAmount(minOut, tokenOut.decimals)} ${tokenOut.symbol}`;
      routeEl.textContent = q.routeDescription;
      detailEl.hidden = false;
    } catch (err) {
      amountOutEl.value = '';
      detailEl.hidden = true;
      currentQuote = null;
      setStatus('Quote failed — check your input', 'error');
    }
    updateActionButton();
  }

  // --- wallet connection state ------------------------------------------
  let walletConnected = false;
  let connectedAccount: string | undefined;

  async function refreshWalletState() {
    try {
      const { getConnectedAddress } = await loadWallet();
      const addr = getConnectedAddress();
      walletConnected = !!addr;
      connectedAccount = addr;
      if (walletConnected && connectedAccount) {
        await refreshBalances();
      } else {
        balanceInEl.textContent = '—';
        balanceOutEl.textContent = '—';
      }
    } catch {
      /* wallet not ready yet */
    }
    updateActionButton();
  }

  async function refreshBalances() {
    if (!connectedAccount) return;
    try {
      const { getBalance } = await loadSwap();
      const [bIn, bOut] = await Promise.all([
        getBalance(tokenIn.address as `0x${string}`, connectedAccount as `0x${string}`),
        getBalance(tokenOut.address as `0x${string}`, connectedAccount as `0x${string}`),
      ]);
      balanceInEl.textContent = fmtAmount(bIn, tokenIn.decimals);
      balanceOutEl.textContent = fmtAmount(bOut, tokenOut.decimals);
    } catch {
      /* rpc failure — leave dashes */
    }
  }

  function updateActionButton() {
    if (actionBtn.classList.contains('is-loading')) return;
    if (!walletConnected) {
      actionBtn.textContent = 'Connect Wallet';
      actionBtn.disabled = false;
      return;
    }
    const hasAmount = Number(amountInEl.value) > 0;
    const hasQuote = !!currentQuote;
    if (!hasAmount) {
      actionBtn.textContent = 'Enter an amount';
      actionBtn.disabled = true;
    } else if (!hasQuote) {
      actionBtn.textContent = 'Finding price…';
      actionBtn.disabled = true;
    } else if (tokenIn.address.toLowerCase() === tokenOut.address.toLowerCase()) {
      actionBtn.textContent = 'Select different tokens';
      actionBtn.disabled = true;
    } else {
      actionBtn.textContent = `Swap ${tokenIn.symbol} for ${tokenOut.symbol}`;
      actionBtn.disabled = false;
    }
  }

  // --- swap execution ----------------------------------------------------
  async function handleAction() {
    // Re-read the live connection state at click time rather than trusting the
    // cached walletConnected flag, which can drift out of sync with the header
    // button's separate subscription (e.g. user disconnects via the header
    // dropdown — the swap's flag would still be true). getConnectedAddress()
    // is the single source of truth from the AppKit singleton.
    const { getConnectedAddress } = await loadWallet();
    const liveAddr = getConnectedAddress();
    if (!liveAddr) {
      // Trigger the header connect flow.
      const { openConnectModal, ensureRobinhoodChain } = await loadWallet();
      try {
        await openConnectModal();
        await ensureRobinhoodChain().catch(() => {});
      } catch {
        /* user cancelled */
      }
      await refreshWalletState();
      return;
    }
    // Reconcile the cached flag/address so balances + button stay correct.
    if (connectedAccount !== liveAddr) {
      connectedAccount = liveAddr;
      walletConnected = true;
      void refreshBalances();
    }

    // Execute the swap.
    actionBtn.classList.add('is-loading');
    actionBtn.textContent = 'Working…';
    try {
      // Ensure the wallet is on Robinhood Chain BEFORE building the tx — the
      // connect flow checks this once, but a user can switch networks after
      // connecting, which would submit the swap to the wrong chain and revert.
      setStatus('Checking network…');
      const { ensureRobinhoodChain } = await loadWallet();
      await ensureRobinhoodChain().catch(() => {});

      const { parseUnits, executeSwap } = await loadSwap();
      const amountIn = parseUnits(amountInEl.value.trim(), tokenIn.decimals);
      if (!currentQuote) throw new Error('No quote');
      const minOut = minReceivedFor(currentQuote.amountOut);
      const result = await executeSwap(
        tokenIn.address as `0x${string}`,
        tokenOut.address as `0x${string}`,
        amountIn,
        minOut,
        (msg) => setStatus(msg),
      );
      if ('error' in result) {
        setStatus(result.error, 'error');
      } else {
        setStatus(`Swap submitted! Tx ${result.txHash.slice(0, 10)}…`, 'success');
        await refreshBalances();
      }
    } catch (err) {
      setStatus(err instanceof Error ? err.message : 'Swap failed', 'error');
    } finally {
      actionBtn.classList.remove('is-loading');
      updateActionButton();
    }
  }

  // --- event wiring ------------------------------------------------------
  amountInEl.addEventListener('input', () => {
    // sanitize: allow only digits and one dot
    amountInEl.value = amountInEl.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');
    scheduleQuote();
  });

  flipBtn.addEventListener('click', () => {
    const tmp = tokenIn;
    tokenIn = tokenOut;
    tokenOut = tmp;
    updateTokenLabels();
    amountInEl.value = amountOutEl.value;
    amountOutEl.value = '';
    detailEl.hidden = true;
    currentQuote = null;
    scheduleQuote();
    if (walletConnected) void refreshBalances();
  });

  maxBtn.addEventListener('click', () => {
    const balText = balanceInEl.textContent;
    if (balText && balText !== '—') {
      amountInEl.value = balText;
      scheduleQuote();
    }
  });

  actionBtn.addEventListener('click', () => void handleAction());

  // --- slippage UI -------------------------------------------------------
  function setSlippageLabel() {
    // Trim trailing zeros so 0.5 stays "0.5%" not "0.50%".
    const label = `${Number(slippagePct.toFixed(2))}%`;
    slippageCurrentEl.textContent = `Slippage: ${label}`;
    // Reflect the active preset (if any) in the pill row + clear custom box.
    const matchPct = slippagePresetEls.find(b => Number(b.dataset.slippage) === slippagePct);
    slippagePresetEls.forEach(b => b.classList.toggle('is-active', b === matchPct));
    slippageCustomEl.value = matchPct ? '' : String(slippagePct);
  }

  /** Validate + apply a slippage value from a raw string. Clamps to bounds and
   *  warns on aggressive (>5%) values. Returns true if accepted. */
  function applySlippage(raw: string): boolean {
    const v = Number(raw);
    if (!isFinite(v) || v <= 0) {
      slippageWarnEl.textContent = 'Enter a positive number';
      slippageWarnEl.hidden = false;
      return false;
    }
    slippageWarnEl.hidden = true;
    if (v > SLIPPAGE_MAX) { slippagePct = SLIPPAGE_MAX; }
    else if (v < SLIPPAGE_MIN) { slippagePct = SLIPPAGE_MIN; }
    else slippagePct = Math.round(v * 100) / 100; // 2dp
    setSlippageLabel();
    // Warn (don't block) on aggressive tolerances — common for low-liquidity pairs.
    if (slippagePct > 5) {
      slippageWarnEl.textContent = 'High slippage — your trade may be front-run.';
      slippageWarnEl.hidden = false;
    }
    // Re-run the quote so the displayed "min received" reflects new tolerance.
    scheduleQuote();
    return true;
  }

  settingsBtn.addEventListener('click', () => {
    const open = settingsPopover.hidden;
    settingsPopover.hidden = !open;
    settingsBtn.setAttribute('aria-expanded', String(open));
  });
  // Close the popover when clicking outside it. composedPath() is reliable for
  // events retargeted through <svg>/<path> children of the gear button.
  document.addEventListener('click', (e) => {
    if (settingsPopover.hidden) return;
    const path = e.composedPath();
    if (!path.includes(settingsPopover) && !path.includes(settingsBtn)) {
      settingsPopover.hidden = true;
      settingsBtn.setAttribute('aria-expanded', 'false');
    }
  });
  slippagePresetEls.forEach(btn => {
    btn.addEventListener('click', () => applySlippage(btn.dataset.slippage!));
  });
  slippageCustomEl.addEventListener('input', () => {
    // sanitize to digits + one dot
    slippageCustomEl.value = slippageCustomEl.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');
    applySlippage(slippageCustomEl.value);
  });

  // --- init --------------------------------------------------------------
  async function init() {
    updateTokenLabels();
    setSlippageLabel();

    // Subscribe to wallet changes (account switch / connect / disconnect) so
    // the page reacts without a reload. Kept off the critical path.
    try {
      const { onWalletChange } = await loadWallet();
      onWalletChange((state) => {
        const wasConnected = walletConnected;
        walletConnected = !!(state.isConnected && state.address);
        connectedAccount = state.address;
        if (walletConnected !== wasConnected || walletConnected) {
          void refreshWalletState();
        }
      });
    } catch {
      /* wallet module not ready */
    }

    // Check current connection (best-effort; the wallet singleton initializes
    // lazily on the header button — it's fine if it's not ready yet here).
    void refreshWalletState();

    // Eagerly preload the swap module so the first quote is instant.
    void loadSwap();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
