---
// Chinese gifts guide: /zh/guides/horizon-walker/gifts/
// Gift box and gift names/descriptions use the game's official ZH via
// HW_ZH_ITEMS (EN verbatim fallback when the game has no ZH entry); point
// values are the wiki's data unchanged.
// Re-skinned onto the EN hw-gifts.css classes for visual parity.
import HwZhLayout from '../../../../layouts/zh/HwZhLayout.astro';
import DecorativeLines from '../../../../components/DecorativeLines.astro';
import { GIFT_BOXES, UNIQUE_GIFTS } from '../../../../data/horizon-walker/gifts.js';
import { HW_ZH_ITEMS } from '../../../../data/horizon-walker/zh/game-text.js';
import { HW_ZH } from '../../../../data/horizon-walker/zh/ui.js';
import { GiftImage, HWRarityIcon } from '../../../../components/horizon-walker/index.astro';
import '../../../../styles/games/horizon-walker/hw-gifts.css';

export const prerender = true;

// EN gift/box name -> official ZH (Item loc); EN fallback if unmapped
const giftZhName = name => HW_ZH_ITEMS[name]?.name || name;
const giftZhDesc = name => HW_ZH_ITEMS[name]?.desc || null;
---

<HwZhLayout
  title="礼物与奖励 - 地平线行者中文维基 - GachaWiki"
  description="地平线行者礼物数据库：华丽/高级/普通礼物箱的全部内容物、好感度积分系统、女王的王冠获取途径与独特礼物。礼物名称与说明均取自游戏官方简体中文。"
  keywords={['地平线行者', '礼物', '好感度', '礼物箱']}
  breadcrumbItems={[
    { name: '首页', href: '/' },
    { name: '地平线行者', href: HW_ZH.baseUrl },
    { name: '礼物' },
  ]}
>
  <section class="hw-gift-hero">
    <h1 class="hw-gift-title">礼物与奖励</h1>
    <DecorativeLines />
  </section>

  <div class="hw-gift-content">
    <section class="hw-gift-section" id="gift-boxes">
      <h2 class="hw-section-title">礼物箱</h2>

      <div class="hw-section-content">
        <p>各类礼物箱与其内容物一览。每个礼物箱包含不同稀有度与类型的礼物。</p>

        <div class="hw-info-box">
          <div class="hw-info-box-title">角色礼物偏好</div>
          <div class="hw-info-box-content">
            想知道每个角色喜欢什么礼物？查看<a href={`${HW_ZH.baseUrl}character-gifts/`} class="hw-link">角色礼物偏好指南</a>，把好感度收益最大化。
          </div>
        </div>
      </div>

      <div class="hw-affection-system-info">
        <div class="system-header">
          <h3 class="system-title">好感度积分系统</h3>
        </div>
        <div class="system-content">
          <div class="system-description">
            <p>礼物获得的好感度会随角色的偏好而增加：</p>
          </div>
          <div class="system-levels">
            <div class="level-item">
              <span class="level-name">基础</span>
              <span class="level-desc">无加成</span>
            </div>
            <div class="level-item">
              <span class="level-name">喜欢</span>
              <span class="level-desc">+10 分</span>
            </div>
            <div class="level-item">
              <span class="level-name">最爱</span>
              <span class="level-desc">+20 分</span>
            </div>
          </div>
          <div class="system-note">
            <strong>注意：</strong>截至目前，女王的王冠无论送给哪位角色都有最高的分值（100 至 120）。它包含在华丽礼物箱子中，想要最大化好感度时请优先选择。
          </div>
        </div>
      </div>

      <div class="hw-gift-box-grid">
        {GIFT_BOXES.map(box => (
          <div class="hw-gift-box-card" id={box.id} data-box={box.id}>
            <div class="hw-gift-box-header">
              <div class="hw-gift-box-image">
                <GiftImage
                  imageName={box.image}
                  alt={giftZhName(box.name)}
                  class="gift-box-img"
                  width={80}
                  height={80}
                  loading="lazy"
                />
              </div>
              <div class="hw-gift-box-info">
                <h3 class="hw-gift-box-name">{giftZhName(box.name)}</h3>
                <div class="hw-gift-box-tier">
                  <HWRarityIcon
                    rarity={box.id === 'brilliant-gift-box' ? 'SS' : box.id === 'luxurious-gift-box' ? 'S' : 'A'}
                    width={40}
                    height={20}
                  />
                </div>
                <p class="hw-gift-box-description">{giftZhDesc(box.name) || box.description}</p>
                <div class="hw-gift-box-stats">
                  <span class="gift-count">{box.gifts.length} 件礼物</span>
                </div>
              </div>
            </div>

            <div class="hw-gift-items-grid">
              {box.gifts.map(gift => (
                <div class="hw-gift-item" data-rarity={gift.rarity}>
                  <div class="hw-gift-item-image">
                    <GiftImage
                      imageName={gift.image}
                      alt={giftZhName(gift.name)}
                      class="gift-item-img"
                      width={60}
                      height={60}
                      loading="lazy"
                    />
                  </div>
                  <div class="hw-gift-item-info">
                    <h4 class="hw-gift-item-name">{giftZhName(gift.name)}</h4>
                    <HWRarityIcon rarity={gift.rarity} width={36} height={18} />
                    <div class="hw-gift-points">
                      <div class="points-levels">
                        <div class="points-item">
                          <span class="points-label">基础</span>
                          <span class="points-value">{gift.points.min}</span>
                        </div>
                        <div class="points-item">
                          <span class="points-label">喜欢</span>
                          <span class="points-value">{gift.points.min + 10}</span>
                        </div>
                        <div class="points-item">
                          <span class="points-label">最爱</span>
                          <span class="points-value">{gift.points.max}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="hw-gift-section" id="unique-gifts">
      <h2 class="hw-section-title">独特与特殊礼物</h2>

      <div class="hw-section-content">
        <p>仅在限定活动或庆典期间获得的纪念性与独特礼物。</p>

        <div class="hw-info-box">
          <div class="hw-info-box-title">重要说明</div>
          <div class="hw-info-box-content">
            <strong>皮肤同样提供 100 好感度</strong>（与 EX 级礼物相同），并适用标准好感度加成。
          </div>
        </div>
      </div>

      <div class="hw-gift-items-grid hw-unique-gifts-grid">
        {UNIQUE_GIFTS.map(gift => (
          <div class="hw-gift-item hw-unique-gift" data-rarity={gift.rarity}>
            <div class="hw-gift-item-image">
              <GiftImage
                imageName={gift.image}
                alt={giftZhName(gift.name)}
                class="gift-item-img"
                width={60}
                height={60}
                loading="lazy"
              />
            </div>
            <div class="hw-gift-item-info">
              <h4 class="hw-gift-item-name">{giftZhName(gift.name)}</h4>
              <div class="hw-gift-badges">
                <HWRarityIcon rarity={gift.rarity} width={36} height={18} />
                <span class="hw-badge hw-badge-unique">{gift.type}</span>
              </div>
              {gift.description && <p class="hw-unique-description">{gift.description}</p>}
              <div class="hw-gift-points">
                <div class="points-levels">
                  <div class="points-item">
                    <span class="points-label">基础</span>
                    <span class="points-value">{gift.points.min}</span>
                  </div>
                  <div class="points-item">
                    <span class="points-label">喜欢</span>
                    <span class="points-value">{gift.points.min + 10}</span>
                  </div>
                  <div class="points-item">
                    <span class="points-label">最爱</span>
                    <span class="points-value">{gift.points.max}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</HwZhLayout>
