---
// Chinese character gift preferences page: /zh/guides/horizon-walker/
// character-gifts/. Character names via HW_ZH_NAMES (roster id), gift names
// via HW_ZH_ITEMS, level-5 bonus stat types via HW_ZH_STAT_TYPES: all the
// game's official ZH with EN fallback. Point math is the wiki's data unchanged.
import HwZhLayout from '../../../../layouts/zh/HwZhLayout.astro';
import { CHARACTER_GIFT_PREFERENCES } from '../../../../data/horizon-walker/character-gifts.js';
import { GIFT_BOXES } from '../../../../data/horizon-walker/gifts.js';
import { HORIZON_WALKER_CHARACTERS } from '../../../../data/horizon-walker/characters.js';
import {
  HW_ZH_NAMES,
  HW_ZH_ITEMS,
  HW_ZH_STAT_TYPES,
} from '../../../../data/horizon-walker/zh/game-text.js';
import { HW_ZH } from '../../../../data/horizon-walker/zh/ui.js';
import { GiftImage, CharacterImage, HWRarityIcon } from '../../../../components/horizon-walker/index.astro';

export const prerender = true;

// Gift -> gift box source mapping (same logic as the EN page)
const giftToBoxMapping = {};
const giftNameToBoxMapping = {};
GIFT_BOXES.forEach(box => {
  box.gifts?.forEach(gift => {
    if (!giftToBoxMapping[gift.id]) giftToBoxMapping[gift.id] = [];
    giftToBoxMapping[gift.id].push({ id: box.id, name: box.name, image: box.image });
    if (!giftNameToBoxMapping[gift.name]) giftNameToBoxMapping[gift.name] = [];
    if (!giftNameToBoxMapping[gift.name].find(b => b.id === box.id)) {
      giftNameToBoxMapping[gift.name].push({ id: box.id, name: box.name, image: box.image });
    }
  });
});

// EN gift/box name -> official ZH (Item loc); EN fallback if unmapped
const giftZhName = name => HW_ZH_ITEMS[name]?.name || name;

// Character ZH name: resolve the roster entry (by slug or name) -> HW_ZH_NAMES
const rosterBySlugOrName = new Map();
for (const c of HORIZON_WALKER_CHARACTERS) {
  if (c.slug) rosterBySlugOrName.set(c.slug, c);
  rosterBySlugOrName.set(c.name, c);
}
const charZhName = g => {
  const rosterChar = rosterBySlugOrName.get(g.id) || rosterBySlugOrName.get(g.name);
  return (rosterChar && HW_ZH_NAMES[rosterChar.id]) || g.name;
};

// Level-5 bonus stat type: official ZH stat name ('Evasion' aliases onto the
// game's 'Evade' entry; 'Special' is wiki shorthand)
const bonusTypeZh = t =>
  HW_ZH_STAT_TYPES[t] || (t === 'Evasion' ? HW_ZH_STAT_TYPES['Evade'] : t === 'Special' ? '特殊' : t);

// The three wiki "Special" bonus values, restated with official ZH stat names
const bonusValueZh = {
  '10% Evade Bonus': () => `${HW_ZH_STAT_TYPES['Evade']} 10% 加成`,
  '5% Melee ATK Bonus + 5% Magic ATK Bonus': () =>
    `${HW_ZH_STAT_TYPES['Melee ATK']} 5% 加成 + ${HW_ZH_STAT_TYPES['Magic ATK']} 5% 加成`,
  '8% Heat Boost Increase': () => `${HW_ZH_STAT_TYPES['Heat Boost']}提升 8%`,
};
const bonusValue = v => (bonusValueZh[v] ? bonusValueZh[v]() : v);

const hasReleasedInfo = c =>
  (c.favorites && c.favorites.length > 0) || (c.likes && c.likes.length > 0);

// Released info first, then by EN name (same ordering as the EN page)
const sortedCharacters = [...CHARACTER_GIFT_PREFERENCES].sort((a, b) => {
  if (hasReleasedInfo(a) && !hasReleasedInfo(b)) return -1;
  if (!hasReleasedInfo(a) && hasReleasedInfo(b)) return 1;
  return a.name.localeCompare(b.name);
});

// Gifts needed to reach level 5 (2000 points)
const giftsNeeded = gift => Math.ceil(2000 / gift.totalPoints);

const hasQueensTiara = c =>
  c.favorites?.some(g => g.id === 'queens-tiara') || c.likes?.some(g => g.id === 'queens-tiara');

const queensTiaraGift = {
  id: 'queens-tiara',
  name: "Queen's Tiara",
  rarity: 'EX',
  image: 'Queen_tiara.jpg',
  totalPoints: 100,
};

const boxesFor = gift => {
  const all = [...(giftToBoxMapping[gift.id] || [])];
  (giftNameToBoxMapping[gift.name] || []).forEach(nb => {
    if (!all.find(b => b.id === nb.id)) all.push(nb);
  });
  return all;
};
---

<HwZhLayout
  title="角色礼物偏好 - 地平线行者中文维基 - GachaWiki"
  description="地平线行者全角色礼物偏好指南：各角色最爱与喜欢的礼物、好感度等级 5 加成、女王的王冠获取途径与好感度速刷建议。角色与礼物名称均取自游戏官方简体中文。"
  keywords={['地平线行者', '礼物', '好感度', '角色礼物偏好']}
  pageTitle="角色礼物偏好"
  breadcrumbItems={[
    { name: '首页', href: '/' },
    { name: '地平线行者', href: HW_ZH.baseUrl },
    { name: '角色礼物偏好' },
  ]}
>
  <div class="zh-cg-page">
    <!-- Guide intro -->
    <section class="zh-section">
      <h2 class="zh-section-title">礼物偏好指南</h2>
      <p class="zh-text">每个角色都有特定的礼物偏好，会影响好感度加成。用本指南为你喜欢的角色挑选最合适的礼物。</p>
      <div class="zh-card">
        <h3 class="zh-card-title">送礼方法</h3>
        <p class="zh-card-text">
          在手机中选择通话（Call）呼叫角色，然后在 4 个选项中选择礼物（Gift）即可送礼。
        </p>
      </div>
      <div class="zh-warning">
        <h4 class="zh-warning-title">重要：已知问题</h4>
        <p class="zh-warning-text">
          有时与角色对话后，不会出现继续好感度任务线的 (!) 提示。遇到该问题时，请完全退出并重启游戏即可修复。
        </p>
      </div>
      <div class="zh-tip">
        <h3 class="zh-tip-title">推荐：华丽礼物箱子</h3>
        <p class="zh-tip-text">
          女王的王冠无论送给哪位角色都有最高的分值（100 至 120）。它包含在华丽礼物箱子中，想要最大化好感度时请优先选择。
        </p>
      </div>
      <div class="zh-info-grid">
        <div class="zh-card">
          <h4 class="zh-card-title">好感度偏好</h4>
          <p class="zh-card-text">最爱礼物：基础分 + <strong>20 加成</strong></p>
          <p class="zh-card-text">喜欢礼物：基础分 + <strong>10 加成</strong></p>
          <p class="zh-card-text">无偏好：仅基础分</p>
        </div>
        <div class="zh-card">
          <h4 class="zh-card-title">好感度目标</h4>
          <p class="zh-card-text">角色好感度共有 <strong>5 个等级</strong>。</p>
          <p class="zh-card-text">升满任意角色共需 <strong>2000 分</strong>。</p>
        </div>
        <div class="zh-card">
          <h4 class="zh-card-title">奖励</h4>
          <p class="zh-card-text">升级奖励：</p>
          <div class="zh-reward-row">
            <div class="zh-reward">
              <GiftImage imageName="Gold.jpg" alt="Gold" class="zh-reward-img" width={32} height={32} loading="lazy" />
              <span class="zh-reward-name">Gold</span>
            </div>
            <div class="zh-reward">
              <GiftImage imageName="Extercium.jpg" alt="Extercium" class="zh-reward-img" width={32} height={32} loading="lazy" />
              <span class="zh-reward-name">Extercium</span>
            </div>
          </div>
          <p class="zh-card-text">特殊解锁：<strong>Message Room</strong>、<strong>Jacuzzi Bathroom</strong></p>
        </div>
      </div>
    </section>

    <!-- Filters -->
    <section class="zh-section">
      <div class="zh-filters">
        <input
          type="search"
          id="zhCgSearch"
          class="zh-search"
          placeholder="搜索角色名（中文或英文）"
          aria-label="搜索角色"
        />
        <div class="zh-filter-row" id="zhRarityRow">
          <button class="zh-filter-chip active" data-rarity="">全部</button>
          <button class="zh-filter-chip" data-rarity="EX">EX</button>
          <button class="zh-filter-chip" data-rarity="SS">SS</button>
          <button class="zh-filter-chip" data-rarity="S">S</button>
          <button class="zh-filter-chip" data-rarity="A">A</button>
          <button class="zh-filter-chip" data-rarity="B">B</button>
        </div>
      </div>
      <p class="zh-empty" id="zhEmpty" hidden>没有符合筛选条件的角色。</p>
    </section>

    <!-- Character grid -->
    <div class="zh-char-grid" id="zhCharGrid">
      {sortedCharacters.map(character => {
        const zhName = charZhName(character);
        const boxes = g => boxesFor(g);
        return (
          <div
            class="zh-char-card"
            data-search={`${zhName} ${character.name}`.toLowerCase()}
            data-rarity={character.rarity}
          >
            <div class="zh-char-header">
              <CharacterImage
                imageName={character.image.split('/').pop() || character.image}
                alt={zhName}
                class="zh-char-img"
                width={100}
                height={100}
                loading="lazy"
              />
              <div>
                <h3 class="zh-char-name">{zhName}</h3>
                <p class="zh-char-en">{character.name}</p>
                <HWRarityIcon rarity={character.rarity} width={44} height={22} />
              </div>
            </div>

            {character.level5Bonus && (
              <p class="zh-bonus-line">
                好感度等级 5 加成：{bonusTypeZh(character.level5Bonus.type)} {bonusValue(character.level5Bonus.value)}
              </p>
            )}

            {character.favorites && character.favorites.length > 0 && (
              <div class="zh-pref-group">
                <h4 class="zh-pref-title zh-pref-fav">最爱礼物（+20 分）</h4>
                {character.favorites.map(gift => (
                  <div class="zh-gift-item">
                    <GiftImage
                      imageName={gift.image.split('/').pop() || gift.image}
                      alt={giftZhName(gift.name)}
                      class="zh-gift-img"
                      width={70}
                      height={70}
                      loading="lazy"
                    />
                    <div class="zh-gift-detail">
                      <p class="zh-gift-name">
                        {giftZhName(gift.name)}
                        <span class="zh-gift-chip zh-chip-fav">最爱</span>
                      </p>
                      <p class="zh-gift-sub">
                        {gift.rarity} · 总好感度 {gift.totalPoints} · 升至等级 5 需 {giftsNeeded(gift)} 个
                      </p>
                      {boxes(gift).length > 0 && (
                        <p class="zh-gift-src">获取来源：{boxes(gift).map(b => giftZhName(b.name)).join('、')}</p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {character.likes && character.likes.length > 0 && (
              <div class="zh-pref-group">
                <h4 class="zh-pref-title">喜欢礼物（+10 分）</h4>
                {character.likes.map(gift => (
                  <div class="zh-gift-item">
                    <GiftImage
                      imageName={gift.image.split('/').pop() || gift.image}
                      alt={giftZhName(gift.name)}
                      class="zh-gift-img"
                      width={70}
                      height={70}
                      loading="lazy"
                    />
                    <div class="zh-gift-detail">
                      <p class="zh-gift-name">
                        {giftZhName(gift.name)}
                        <span class="zh-gift-chip">喜欢</span>
                      </p>
                      <p class="zh-gift-sub">
                        {gift.rarity} · 总好感度 {gift.totalPoints} · 升至等级 5 需 {giftsNeeded(gift)} 个
                      </p>
                      {boxes(gift).length > 0 && (
                        <p class="zh-gift-src">获取来源：{boxes(gift).map(b => giftZhName(b.name)).join('、')}</p>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            )}

            {!hasQueensTiara(character) && hasReleasedInfo(character) && (
              <div class="zh-pref-group">
                <h4 class="zh-pref-title">高价值替代选择</h4>
                <div class="zh-gift-item">
                  <GiftImage
                    imageName={queensTiaraGift.image}
                    alt={giftZhName(queensTiaraGift.name)}
                    class="zh-gift-img"
                    width={70}
                    height={70}
                    loading="lazy"
                  />
                  <div class="zh-gift-detail">
                    <p class="zh-gift-name">
                      {giftZhName(queensTiaraGift.name)}
                      <span class="zh-gift-chip zh-chip-value">高分值</span>
                    </p>
                    <p class="zh-gift-sub">
                      {queensTiaraGift.rarity} · 总好感度 {queensTiaraGift.totalPoints} · 升至等级 5 需 {giftsNeeded(queensTiaraGift)} 个
                    </p>
                    {boxesFor(queensTiaraGift).length > 0 && (
                      <p class="zh-gift-src">
                        获取来源：{boxesFor(queensTiaraGift).map(b => giftZhName(b.name)).join('、')}
                      </p>
                    )}
                  </div>
                </div>
              </div>
            )}

            {!hasReleasedInfo(character) && (
              <p class="zh-unreleased"><strong>尚未公开</strong>：该角色的礼物偏好暂未公布。</p>
            )}
          </div>
        );
      })}
    </div>
  </div>
</HwZhLayout>

<script>
  function initZhCgFilters() {
    const search = document.getElementById('zhCgSearch');
    const grid = document.getElementById('zhCharGrid');
    const empty = document.getElementById('zhEmpty');
    const cards = Array.from(grid.querySelectorAll('.zh-char-card'));
    let rarity = '';

    const apply = () => {
      const q = (search.value || '').trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const okSearch = !q || card.dataset.search.includes(q);
        const okRarity = !rarity || card.dataset.rarity === rarity;
        const visible = okSearch && okRarity;
        card.style.display = visible ? '' : 'none';
        if (visible) shown++;
      }
      empty.hidden = shown > 0;
    };

    search.addEventListener('input', apply);

    const row = document.getElementById('zhRarityRow');
    row.addEventListener('click', e => {
      const btn = e.target.closest('.zh-filter-chip');
      if (!btn) return;
      row.querySelectorAll('.zh-filter-chip').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      rarity = btn.dataset.rarity || '';
      apply();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initZhCgFilters);
  } else {
    initZhCgFilters();
  }
</script>

