---
// Chinese AP (action points) guide: /zh/guides/horizon-walker/ap-guide/
// Editorial walkthrough translated from the EN ap-guide data, same numbers
// (Yeonwoo 56/109/165, 30 AP skill, 100 AP threshold); stat names use the
// game's official ZH from HW_ZH_STAT_LABELS/STAT_TYPES.
// Re-skinned onto the EN hw-guide.css classes for visual parity.
import HwZhLayout from '../../../../layouts/zh/HwZhLayout.astro';
import DecorativeLines from '../../../../components/DecorativeLines.astro';
import { HORIZON_WALKER_CHARACTERS } from '../../../../data/horizon-walker/characters.js';
import { HW_ZH_NAMES, HW_ZH_STAT_LABELS, HW_ZH_STAT_TYPES } from '../../../../data/horizon-walker/zh/game-text.js';
import { HW_ZH } from '../../../../data/horizon-walker/zh/ui.js';
import { APImage } from '../../../../components/horizon-walker/index.astro';
import '../../../../styles/games/horizon-walker/hw-guide.css';

export const prerender = true;

// Hero names mentioned in the guide -> official ZH (EN fallback)
const heroZh = enName => {
  const rosterChar = HORIZON_WALKER_CHARACTERS.find(c => c.name === enName);
  return (rosterChar && HW_ZH_NAMES[rosterChar.id]) || enName;
};
const yeonwoo = heroZh('Yeonwoo');
const kalma = heroZh('Kalma');

// Official ZH stat names used in the guide
const apRecovery = HW_ZH_STAT_LABELS.apRecovery; // 体力恢复力
const startingAp = HW_ZH_STAT_LABELS.startingAp; // 战斗开始行动力
const agility = HW_ZH_STAT_LABELS.agility; // 敏捷
const apRecoveryEn = HW_ZH_STAT_TYPES['AP Recovery'];

const IMG1 = '../../assets/images/games/horizon-walker/AP_recovery/img1.jpg';
const IMG2 = '../../assets/images/games/horizon-walker/AP_recovery/img2.jpg';
const IMG3 = '../../assets/images/games/horizon-walker/AP_recovery/img3.jpg';
---

<HwZhLayout
  title="行动力（AP）系统指南 - 地平线行者中文维基 - GachaWiki"
  description="地平线行者行动力（AP）系统详解：体力恢复力与战斗开始行动力的区别、行动顺序的计算、100 AP 行动门槛与额外回合等特殊效果。"
  keywords={['地平线行者', '行动力', 'AP', '回合顺序', '体力恢复力']}
  breadcrumbItems={[
    { name: '首页', href: '/' },
    { name: '地平线行者', href: HW_ZH.baseUrl },
    { name: '行动力指南' },
  ]}
>
  <section class="hw-guide-hero">
    <h1 class="hw-guide-title">行动力（AP）系统指南</h1>
    <p class="hw-guide-subtitle">理解 AP 如何决定地平线行者中的行动顺序</p>
    <DecorativeLines />
  </section>

  <div class="hw-guide-content">
    <section class="hw-guide-section" id="introduction">
      <h2 class="hw-section-title">AP 如何运作</h2>
      <div class="hw-section-content">
        <p>
          本游戏使用行动力（AP）来计算行动顺序：AP 是衡量谁先行动的度量系统。下面解释 AP 的运作方式与相关机制。
        </p>
      </div>
    </section>

    <section class="hw-guide-section" id="ap-stats">
      <h2 class="hw-section-title">AP 相关属性一览</h2>
      <div class="hw-section-content">
        <p>首先，影响 AP 的属性共有两项：</p>
      </div>
      <ul class="hw-guide-list">
        <li>{apRecovery}（{apRecoveryEn}，AP Recovery）</li>
        <li>{startingAp}（Starting AP）</li>
      </ul>
    </section>

    <section class="hw-guide-section" id="ap-recovery-explanation">
      <h2 class="hw-section-title">理解{apRecovery}</h2>
      <div class="hw-section-content">
        <p>
          {apRecovery}（AP Recovery）：从第 1 回合开始，每回合获得的 AP 点数。
        </p>
        <p>
          {startingAp}（Starting AP）：只在战斗的第 1 回合生效，帮助你的单位率先行动，提前启动连锁或增益。
        </p>
      </div>
      <div class="hw-warning-box">
        <div class="hw-warning-content">
          注意：{agility}会提升基础{apRecovery}。{agility}高的角色从{apRecovery}提升中获益更大，因为提升的百分比会更高！
        </div>
      </div>
      <div class="hw-guide-image-container">
        <APImage
          imageName={IMG1}
          alt="AP 属性界面：敏捷影响体力恢复力"
          class="hw-guide-image"
          width={600}
          height={400}
          loading="lazy"
          format="webp"
          quality={85}
        />
        <p class="hw-guide-image-caption">AP 属性界面：{agility}影响{apRecovery}</p>
      </div>
    </section>

    <section class="hw-guide-section" id="gameplay-mechanics">
      <h2 class="hw-section-title">游戏中如何使用这些属性</h2>
      <div class="hw-section-content">
        <p>接下来看看这两项属性在实战中如何运作。以{yeonwoo}为例：</p>
      </div>
      <div class="hw-guide-image-container">
        <APImage
          imageName={IMG2}
          alt={`${yeonwoo}的 AP 属性：战斗开始行动力 56、体力恢复力 109`}
          class="hw-guide-image"
          width={600}
          height={400}
          loading="lazy"
          format="webp"
          quality={85}
        />
        <p class="hw-guide-image-caption">{yeonwoo}的 AP 属性：{startingAp} 56、{apRecovery} 109</p>
      </div>
      <div class="hw-example-box">
        <div class="hw-example-title">{yeonwoo}的 AP 计算</div>
        <div class="hw-example-content">
          她的{startingAp}为 56，{apRecovery}为 109。第 1 回合合计应有 165 AP（56 + 109）。之后每回合在此基础上再获得 109。
        </div>
      </div>
    </section>

    <section class="hw-guide-section" id="turn-threshold">
      <h2 class="hw-section-title">100 AP 行动门槛规则</h2>
      <div class="hw-section-content">
        <p>第 1 回合她拥有 165 AP，而她的基础技能消耗 30 AP。</p>
      </div>
      <div class="hw-guide-image-container">
        <APImage
          imageName={IMG3}
          alt="第 1 回合：妍雨拥有 165 AP，基础技能消耗 30 AP"
          class="hw-guide-image"
          width={600}
          height={400}
          loading="lazy"
          format="webp"
          quality={85}
        />
        <p class="hw-guide-image-caption">第 1 回合：{yeonwoo}拥有 165 AP，基础技能消耗 30 AP</p>
      </div>
      <div class="hw-warning-box">
        <div class="hw-warning-content">
          非常重要：AP 低于 100 时，必须等待下一回合直到 AP 达到 100 以上才能行动。行动门槛是 100 AP 及以上！
        </div>
      </div>
      <div class="hw-info-box">
        <div class="hw-info-box-title">AP 累积示例</div>
        <div class="hw-info-box-content">
          如果当前为 99 AP，那么要到下一回合才能行动，并获得 99 + 109（{apRecovery}）= 208 AP。
        </div>
      </div>
    </section>

    <section class="hw-guide-section" id="special-effects">
      <h2 class="hw-section-title">特殊效果</h2>
      <div class="hw-section-content">
        <p>效果：</p>
      </div>
      <div class="hw-example-box">
        <div class="hw-example-title">额外回合效果</div>
        <div class="hw-example-content">
          部分技能（如{kalma}的技能）的额外回合效果无需等待 100 AP 即可获得行动机会：当回合即可行动，相当于无视 100 AP 的行动门槛！
        </div>
      </div>
    </section>

    <section class="hw-guide-section" id="tldr">
      <h2 class="hw-section-title">总结</h2>
      <div class="hw-info-box">
        <div class="hw-info-box-title">要点</div>
        <div class="hw-info-box-content">
          <ul class="hw-guide-list zh-info-list">
            <li>AP 决定行动顺序</li>
            <li>{startingAp}只影响第 1 回合</li>
            <li>{apRecovery}每回合增加你的 AP</li>
            <li>最低 100 AP 才能行动（特殊效果除外）</li>
            <li>{agility}提升基础{apRecovery}</li>
            <li>额外回合效果无视 100 AP 规则</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="hw-guide-section" id="video-explanation">
      <h2 class="hw-section-title">视频讲解</h2>
      <div class="hw-section-content">
        <p>想要更详细的 AP 系统视频讲解，可以观看这个视频：</p>
      </div>
      <div class="hw-video-link-container">
        <a
          href="https://www.youtube.com/watch?v=AUh3Fhjag24"
          target="_blank"
          rel="noopener noreferrer"
          class="hw-video-link"
        >
          在 YouTube 观看 AP 系统讲解 →
        </a>
      </div>
    </section>
  </div>
</HwZhLayout>

<style>
  /* Localize the EN pseudo-element labels; the list inside the TL;DR info box
     needs tighter vertical rhythm than the standalone guide list. */
  .hw-warning-box::before {
    content: '⚠️ 注意';
  }

  .hw-tip-box::before {
    content: '💡 提示';
  }

  .zh-info-list {
    margin: 0;
  }
</style>
