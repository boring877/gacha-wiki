---
/**
 * Stella Sora Shop Event Banner Image Component
 * Handles shop event banner images for the index page from BG_Shop directory
 * Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
 */
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/stella-sora';

// Shop event banner image mapping
const shopEventBannerMap: Record<string, string> = {
  // Use the actual event IDs from the data files
  'a-finale-echoing': 'EventShop/BG_Shop/Finale_Echoing.jpg',
  'the-ghost-ship-haunts-the-deep': 'EventShop/BG_Shop/Ghost_Ship.jpg',
  'guild-sweet-guild': 'EventShop/BG_Shop/Guild_Sweet.jpg',
  'beyond-the-dream': 'EventShop/BG_Shop/Beyond_the_dream.jpg',
  'radiant-messenger-holy-night-spirit': 'events/8/1.png',
};

const {
  imageName,
  alt = 'Shop Event Banner Image',
  class: className = '',
  loading = 'lazy',
  width = 500,
  height = 500,
} = Astro.props;

// Get the image path from the map
const imagePath = shopEventBannerMap[imageName] || shopEventBannerMap['guild-sweet-guild'];
---

<div class={`ss-shop-event-banner-image ${className}`}>
  <img
    src={`${R2}/${imagePath}`}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    style="object-fit: cover; border-radius: 8px; width: 100%; height: auto;"
  />
</div>
