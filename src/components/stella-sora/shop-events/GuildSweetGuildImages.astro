---
/**
 * Guild Sweet Guild Event Images Component
 * Handles image imports and mapping for the Guild Sweet Guild event
 */

const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/stella-sora';


// Import all images for Guild Sweet Guild event

// Clean, unified image mapping for Guild Sweet Guild - supports both original filenames and semantic camelCase keys
const imageMap = {
  // Original filenames from data (with .jpg extension)
  'Fist_of_Courage.jpg': 'EventShop/Guild_sweet_guild/Fist_of_Courage.jpg',
  'Fist_of_Courage_Melody.jpg': 'EventShop/Guild_sweet_guild/Fist_of_Courage_Melody.jpg',
  'Guild_Sweet_Guild.jpg': 'EventShop/Guild_sweet_guild/Guild_Sweet_Guild.jpg',
  'Colossus_Core.jpg': 'EventShop/Guild_sweet_guild/Colossus_Core.jpg',
  'Cerulean_Ticket.jpg': 'EventShop/Guild_sweet_guild/Cerulean_Ticket.jpg',
  'Sprout_Ticket.jpg': 'EventShop/Guild_sweet_guild/Sprout_Ticket.jpg',
  'Monolith_Stairs_Pass.jpg': 'EventShop/Guild_sweet_guild/Monolith_Stairs_Pass.jpg',
  'Star_Emblem_Polisher.jpg': 'EventShop/Guild_sweet_guild/Star_Emblem_Polisher.jpg',
  'Reflective_Photo_Capturer.jpg': 'EventShop/Guild_sweet_guild/Reflective_Photo_Capturer.jpg',
  'Moonlit_Companion.jpg': 'EventShop/Guild_sweet_guild/Moonlit_Companion.jpg',
  'Blossom_Porcelain_cup.jpg': 'EventShop/Guild_sweet_guild/Blossom_Porcelain_cup.jpg',
  "Count's_Gift.jpg": countsGift,
  'Demon_Bee_Game_Cartridge.jpg': 'EventShop/Guild_sweet_guild/Demon_Bee_Game_Cartridge.jpg',
  'Frenzied_Waltz_Essence.jpg': 'EventShop/Guild_sweet_guild/Frenzied_Waltz_Essence.jpg',
  "Trekker's_Handwritten_Encyclopedia.jpg": trekkersHandwrittenEncyclopedia,
  'Starlit_Colored_Glass.jpg': 'EventShop/Guild_sweet_guild/Starlit_Colored_Glass.jpg',
  "Count's_Cellaring.jpg": countsCellaring,
  'Barrage_Game_Cartridge.jpg': 'EventShop/Guild_sweet_guild/Barrage_Game_Cartridge.jpg',
  'Phantom_Step_Remnant.jpg': 'EventShop/Guild_sweet_guild/Phantom_Step_Remnant.jpg',
  'Novice_Trekker_promotion_box.jpg': 'EventShop/Guild_sweet_guild/Novice_Trekker_promotion_box.jpg',
  'Beginner_Cartridge_box.jpg': 'EventShop/Guild_sweet_guild/Beginner_Cartridge_box.jpg',
  'Novice_Disc_Promotion_Box.jpg': 'EventShop/Guild_sweet_guild/Novice_Disc_Promotion_Box.jpg',
  'Dorra.jpg': 'EventShop/Guild_sweet_guild/Dorra.jpg',
  'BG1.jpg': 'EventShop/Guild_sweet_guild/BG1.jpg',
  'Gem.jpg': 'EventShop/Guild_sweet_guild/Gem.jpg',
  'Glass_Marble.jpg': 'EventShop/Guild_sweet_guild/Glass_Marble.jpg',
  'chess_piece_of_skill.png': 'EventShop/Guild_sweet_guild/chess_piece_of_skill.png',

  // Quest reward variations (only for special cases with "Guild" suffix or different naming)
  'Sprout Ticket Guild': 'EventShop/Guild_sweet_guild/Sprout_Ticket.jpg',
  "Count's Cellaring Guild": countsCellaring,
  'Barrage Game Cartridge Guild': 'EventShop/Guild_sweet_guild/Barrage_Game_Cartridge.jpg',
  'Chess Piece of Skill': 'EventShop/Guild_sweet_guild/chess_piece_of_skill.png', // Direct mapping for PNG file
  'Blossom Porcelain Cup': 'EventShop/Guild_sweet_guild/Blossom_Porcelain_cup.jpg', // Direct mapping for case-sensitive filename
};

// Props interface
interface Props {
  imageName: string;
  alt?: string;
  class?: string;
  className?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
}

const {
  imageName,
  alt = '',
  class: classNameFromClass,
  className,
  width = 500,
  height = 500,
  loading = 'lazy',
  format = 'webp',
  quality = 100,
} = Astro.props;

// Use either className or class (for backwards compatibility)
const finalClassName = className || classNameFromClass || '';

// Get the image module based on the imageName - use filename fallback like other components
const filename = imageName.split('/').pop() || 'Glass_Marble.jpg';
const convertedFilenameJpg = filename.replace(/ /g, '_') + '.jpg';
const convertedFilenamePng = filename.replace(/ /g, '_') + '.png';
const imageModule =
  imageMap[imageName] ||
  imageMap[convertedFilenameJpg] ||
  imageMap[convertedFilenamePng] ||
  imageMap[filename + '.jpg'] ||
  imageMap[filename + '.png'] ||
  'EventShop/Guild_sweet_guild/Glass_Marble.jpg';
---

<!-- Use Astro's Image component for optimization -->
<img
  src={`${R2}/${imageModule}`}
  alt={alt || imageName.replace(/_/g, ' ').replace('.jpg', '').replace('.png', '')}
  width={width}
  height={height}
  class={finalClassName}
  loading={loading}
/>
