// Props interface
interface Props {
  imageName: string;
  alt?: string;
  class?: string;
  className?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
}

const {
  imageName,
  alt = '',
  class: classNameFromClass,
  className,
  width = 400,
  height = 400,
  loading = 'lazy',
  format = 'webp',
  quality = 90,
} = Astro.props;

// Use either className or class
const finalClassName = className || classNameFromClass || '';

// Get the image module based on the imageName
const imageModule = imageMap[imageName] || 'EventShop/Radiant Messenger Holy Night Spirit/item_73104.png';
---

<img
  src={`${R2}/${imageModule}`}
  alt={alt || imageName.replace(/_/g, ' ').replace('.png', '').replace('.jpg', '')}
  width={width}
  height={height}
  class={finalClassName}
  loading={loading}
/>
