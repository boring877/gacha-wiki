---
/**
 * A Finale Echoing Event Images Component
 * Handles image imports and mapping for the A Finale Echoing event
 */

const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/stella-sora';


// Image mapping object for easy access
const imageMap = {
  // Original filenames with extensions
  '1_Whispers_of_Decay.jpg': 'EventShop/A_Finale_Echoing/1_Whispers_of_Decay.jpg',
  '1_New_Star_Prelude.jpg': 'EventShop/A_Finale_Echoing/1_New_Star_Prelude.jpg',
  '1_Prayer_Beneath_Light.jpg': 'EventShop/A_Finale_Echoing/1_Prayer_Beneath_Light.jpg',
  '1_Summer_Afternoon_Rain.jpg': 'EventShop/A_Finale_Echoing/1_Summer_Afternoon_Rain.jpg',
  '1_Those_with_Ambition.jpg': 'EventShop/A_Finale_Echoing/1_Those_with_Ambition.jpg',
  '1_Voyage_Blueprint.jpg': 'EventShop/A_Finale_Echoing/1_Voyage_Blueprint.jpg',
  '1_Sweet_Times.jpg': 'EventShop/A_Finale_Echoing/1_Sweet_Times.jpg',
  '1_Chess_Piece_of_Skill.jpg': 'EventShop/A_Finale_Echoing/1_Chess_Piece_of_Skill.jpg',
  '1_Proving_Grounds_gift_box.jpg': 'EventShop/A_Finale_Echoing/1_Proving_Grounds_gift_box.jpg',
  '1_Premium_Cartridge_Box.jpg': 'EventShop/A_Finale_Echoing/1_Premium_Cartridge_Box.jpg',
  '1_Deluxe_Cartridge_box.jpg': 'EventShop/A_Finale_Echoing/1_Deluxe_Cartridge_box.jpg',
  '1_Beginner_Cartridge_Box.jpg': 'EventShop/A_Finale_Echoing/1_Beginner_Cartridge_Box.jpg',
  '1_Sprout_Ticket.jpg': 'EventShop/A_Finale_Echoing/1_Sprout_Ticket.jpg',
  '1_Dorra.jpg': 'EventShop/A_Finale_Echoing/1_Dorra.jpg',

  // Semantic keys for easier use
  whispersOfDecay: 'EventShop/A_Finale_Echoing/1_Whispers_of_Decay.jpg',
  currency: 'EventShop/A_Finale_Echoing/1_Whispers_of_Decay.jpg',
  'whispers of decay': 'EventShop/A_Finale_Echoing/1_Whispers_of_Decay.jpg',
  'Whispers of Decay': 'EventShop/A_Finale_Echoing/1_Whispers_of_Decay.jpg',

  // Shop item names
  'New Star Prelude': 'EventShop/A_Finale_Echoing/1_New_Star_Prelude.jpg',
  'Prayer Beneath Light': 'EventShop/A_Finale_Echoing/1_Prayer_Beneath_Light.jpg',
  'Summer Afternoon Rain': 'EventShop/A_Finale_Echoing/1_Summer_Afternoon_Rain.jpg',
  'Those with Ambition': 'EventShop/A_Finale_Echoing/1_Those_with_Ambition.jpg',
  'Voyage Blueprint': 'EventShop/A_Finale_Echoing/1_Voyage_Blueprint.jpg',
  'Sweet Times': 'EventShop/A_Finale_Echoing/1_Sweet_Times.jpg',
  'Chess Piece of Skill': 'EventShop/A_Finale_Echoing/1_Chess_Piece_of_Skill.jpg',
  'Proving Grounds Gift Box': 'EventShop/A_Finale_Echoing/1_Proving_Grounds_gift_box.jpg',
  'Premium Cartridge Box': 'EventShop/A_Finale_Echoing/1_Premium_Cartridge_Box.jpg',
  'Deluxe Cartridge Box': 'EventShop/A_Finale_Echoing/1_Deluxe_Cartridge_box.jpg',
  'Beginner Cartridge Box': 'EventShop/A_Finale_Echoing/1_Beginner_Cartridge_Box.jpg',
  'Sprout Ticket': 'EventShop/A_Finale_Echoing/1_Sprout_Ticket.jpg',
  Dorra: 'EventShop/A_Finale_Echoing/1_Dorra.jpg',

  // Common variations to prevent missing images
  'x Sprout Ticket': 'EventShop/A_Finale_Echoing/1_Sprout_Ticket.jpg',
  'x Chess Piece of Skill': 'EventShop/A_Finale_Echoing/1_Chess_Piece_of_Skill.jpg',
};

// Props interface
interface Props {
  imageName: string | any;
  alt?: string;
  className?: string;
  width?: number;
  height?: number;
  loading?: 'lazy' | 'eager';
}

const {
  imageName,
  alt = '',
  className = '',
  width = undefined,
  height = undefined,
  loading = 'lazy',
} = Astro.props;

// Resolve the image path from the mapping
let imageSrc: string | null = null;

if (typeof imageName === 'string') {
  imageSrc = imageMap[imageName];
}

// If image not found, use a placeholder or fallback
if (!imageSrc) {
  const nameStr = typeof imageName === 'string' ? imageName : 'unknown';
  console.warn(`Image "${nameStr}" not found in A Finale Echoing image mapping`);
}
---

{
  imageSrc ? (
    <img
      src={`${R2}/${imageSrc}`}
      alt={alt || imageName.replace(/_/g, ' ').replace('.jpg', '').replace('.png', '')}
      class={className}
      width={width}
      height={height}
      loading={loading}
      decoding="async"
    />
  ) : (
    <div class={`image-placeholder ${className}`} style={`width: ${width}px; height: ${height}px;`}>
      <span>Image not found: {imageName}</span>
    </div>
  )
}
