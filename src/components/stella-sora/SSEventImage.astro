---
// Stella Sora Event Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/stella-sora';

// Centralized event image mapping (key '<folder>/<file>' -> R2 path)
const eventImageMap: Record<string, string> = {
  '1/1': 'events/1/1.jpg',
  '1/2': 'events/1/2.jpg',
  '1/3': 'events/1/3.jpg',
  '1/4': 'events/1/4.jpg',
  '2/1': 'events/2/1.jpg',
  '2/2': 'events/2/2.jpg',
  '2/3': 'events/2/3.jpg',
  '2/4': 'events/2/4.jpg',
  '3/1': 'events/3/Opera_Ghost.jpg',
  '4/1': 'events/4/1.jpg',
  '4/2': 'events/4/2.jpg',
  '4/3': 'events/4/3.jpg',
  '4/4': 'events/4/4.jpg',
  '5/1': 'events/5/1.jpg',
  '5/2': 'events/5/2.jpg',
  '5/3': 'events/5/3.jpg',
  '5/4': 'events/5/4.jpg',
  '6/1': 'events/6/1.png',
  '6/2': 'events/6/2.png',
  '6/3': 'events/6/3.png',
  '6/4': 'events/6/4.jpeg',
  '6/5': 'events/6/5.jpeg',
  '6/6': 'events/6/6.jpeg',
  '7/1': 'events/7/1.jpg',
  '7/2': 'events/7/2.jpg',
  '7/3': 'events/7/3.jpg',
  '7/4': 'events/7/4.jpg',
  '8/1': 'events/8/1.png',
  '8/2': 'events/8/2.png',
  '8/3': 'events/8/3.png',
  '8/4': 'events/8/4.png',
  '8/5': 'events/8/5.png',
  '8/6': 'events/8/6.png',
  '8/7': 'events/8/7.png',
  '8/8': 'events/8/8.png',
  '8/9': 'events/8/9.png',
  '8/10': 'events/8/10.png',
  '8/11': 'events/8/11.png',
  '8/12': 'events/8/12.png',
  '8/13': 'events/8/13.png',
  '8/14': 'events/8/14.png',
  '8/15': 'events/8/15.png',
  '8/16': 'events/8/16.png',
  '8/17': 'events/8/17.png',
  '8/18': 'events/8/18.png',
  '8/19': 'events/8/19.png',
  '8/20': 'events/8/20.png',
};

const {
  imageName,
  alt = 'Event image',
  class: className = '',
  loading = 'lazy',
  width = 1200,
  height = 2000,
} = Astro.props;

// Get the image path from the map
const imageSrc = `${R2}/${eventImageMap[imageName] || eventImageMap['1/1']}`;
---

<div class={`ss-event-image ${className}`}>
  <img
    src={imageSrc}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    style="object-fit: contain; border-radius: 8px; max-width: 100%; height: auto;"
  />
</div>

<style>
  .ss-event-image {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto 2rem auto;
    background: var(--ss-bg-secondary);
    border-radius: 12px;
    padding: 1rem;
    border: 1px solid var(--ss-border-color);
    overflow-x: auto;
    will-change: transform; /* Optimize for mobile animations */
  }

  .ss-event-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    transition: transform 0.3s ease;
  }

  /* Mobile-specific image optimizations */
  @media (max-width: 768px) {
    .ss-event-image {
      padding: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .ss-event-image img {
      border-radius: 6px;
    }
  }

  @media (max-width: 480px) {
    .ss-event-image {
      padding: 0.5rem;
      margin-bottom: 1rem;
      margin-left: 0;
      margin-right: 0;
      max-width: 100%;
    }

    .ss-event-image img {
      border-radius: 4px;
    }
  }

  /* Prevent horizontal scroll on small screens */
  @media (max-width: 360px) {
    .ss-event-image {
      padding: 0.25rem;
      border-radius: 8px;
    }

    .ss-event-image img {
      border-radius: 4px;
    }
  }
</style>
