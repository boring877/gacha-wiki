---
// Stella Sora Banner Timeline Image Component
// Served from the gachawiki-images R2 bucket (keeps the Pages deployment under the 20,000-file limit).
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/stella-sora';

// Image mapping by character name
const characterImages: Record<string, string> = {
  'Snowish Laru': 'Banner_timeline/7/Snowish_Laru.jpg',
  Freesia: 'Banner_timeline/8/Freesia.png',
  Nazuka: 'Banner_timeline/6/1.png',
  Gerie: 'Banner_timeline/5/Gerie.jpg',
  Fuyuka: 'Banner_timeline/4/Fuyuka.jpg',
  Chitose: 'Banner_timeline/1/Chitose.jpg',
  Shia: 'Banner_timeline/2/Shia.jpg',
  Nanoha: 'Banner_timeline/3/Nanoha.jpg',
};

// Disc image mapping by disc name
const discImages: Record<string, string> = {
  'Snowy Night Surprise': 'Banner_timeline/7/Snowish_Laru_disc.jpg',
  'Sunlit Blossom': 'Banner_timeline/8/Freesia_disc.png',
  "Deer's Song": 'Banner_timeline/6/2.png',
  'The Lost Pilgrim': 'Banner_timeline/5/Gerie_disc.jpg',
  Fireworks: 'Banner_timeline/4/Fuyuka_disc.jpg',
  'Sword Against Stream': 'Banner_timeline/1/Chitose_disc.jpg',
  'Ripples of Nostalgia': 'Banner_timeline/2/Shia_disc.jpg',
  'Daylight Garden': 'Banner_timeline/3/Nanoha_disc.jpg',
};

export interface Props {
  name: string;
  alt: string;
  type: 'character' | 'disc';
  width?: number;
  height?: number;
}

const { name, alt, type, width = 300, height = 300 } = Astro.props;

// Get the appropriate image based on type
const imageMap = type === 'character' ? characterImages : discImages;
const imagePath = imageMap[name];
---

{
  imagePath && (
    <div class={`ss-banner-image ss-banner-image--${type}`}>
      <img
        src={`${R2}/${imagePath}`}
        alt={alt}
        width={width}
        height={height}
        class="ss-banner-image__img"
        loading="lazy"
        decoding="async"
      />
    </div>
  )
}

<style>
  .ss-banner-image {
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .ss-banner-image--character {
    border: 3px solid var(--ss-primary);
  }

  .ss-banner-image--disc {
    border: 3px solid var(--ss-secondary);
  }

  .ss-banner-image__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: inherit;
  }
</style>
