---
// Site-wide banner announcing the GachaWiki ($GW) token launch.
// Token is LIVE on Robinhood Chain (4663). The banner links to the /swap page
// and shows a LIVE $GW price + market cap chip, fetched from DexScreener's
// free API (no key required, Robinhood Chain supported).
// The interactive Connect Wallet flow lives in the header (WalletButton.astro).
// Uses the SAME dark gradient + amber border as the Header/Footer so it
// reads as a natural part of the chrome, not a foreign element.
// Rendered in HomeLayout.astro (below the Header) so it shows on every page.
// To take down: remove this component and its import in HomeLayout.astro.
const SWAP_URL = '/swap';
// Full contract address for verification (shown shortened in the banner)
const CA = '0x50bE7832849EFEdB15611799074FcC409522f27A';
const CA_SHORT = '0x50bE…f27A';
---

<a class="token-banner" href={SWAP_URL} aria-label="GachaWiki ($GW) token is now live on Robinhood Chain — swap now">
  <div class="token-banner-inner">
    <span class="token-badge">
      <span class="token-dot" aria-hidden="true"></span>
      Live
    </span>
    <span class="token-text">
      <strong>$GW Token</strong>
      <span class="token-text-tail">is now live on Robinhood Chain</span>
    </span>

    <!-- Live stats chip — cycles through price / 24h change / market cap /
         volume / liquidity every few seconds. Hidden until data loads. -->
    <span class="token-price" id="gw-price-chip" hidden>
      <span class="token-price-label">$GW</span>
      <span class="token-price-stat" id="gw-stat">…</span>
    </span>

    <span class="token-ca" title={CA}>{CA_SHORT}</span>
    <svg class="token-arrow" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M4 10h12m-6-6l6 6-6 6" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
</a>

<style>
  /* Matches Header.astro / Footer.astro treatment exactly:
     same dark gradient background, same amber bottom border. */
  .token-banner {
    display: block;
    width: 100%;
    text-decoration: none;
    background: var(--bg-dark);
    border-bottom: 1px solid rgba(255, 183, 77, 0.3);
  }

  .token-banner-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    flex-wrap: nowrap; /* never wrap — the arrow must stay on the same line */
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 0.88rem;
    color: var(--text-inverse, #ffffff);
  }

  /* LIVE chip — subtle, uses the same amber accent as the rest of the site */
  .token-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.16rem 0.55rem 0.16rem 0.45rem;
    border-radius: 999px;
    background: rgba(255, 183, 77, 0.1);
    border: 1px solid rgba(255, 183, 77, 0.3);
    color: var(--amber-glow, #ffb74d);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .token-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success-color, #4caf50);
    box-shadow: 0 0 5px rgba(76, 175, 80, 0.7);
    animation: token-blink 2s ease-in-out infinite;
  }

  @keyframes token-blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.45; }
  }

  .token-text strong {
    color: var(--amber-glow, #ffb74d);
    font-weight: 700;
    margin-right: 0.15rem;
  }

  /* Allow the announcement text to truncate instead of forcing a wrap.
     min-width: 0 is required for flex children to shrink below content size. */
  .token-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Live stats chip — cycles through price/change/mcap/volume/liquidity.
     Separated from the announcement by a faint divider, monospace numbers. */
  .token-price {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(255, 183, 77, 0.25);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .token-price-label {
    color: var(--amber-glow, #ffb74d);
    font-weight: 700;
    font-size: 0.8rem;
  }

  .token-price-stat {
    font-weight: 700;
    font-size: 0.8rem;
  }

  /* Color states — set by JS per-stat so each metric has its own accent */
  .token-price-stat.c-amber { color: var(--amber-glow, #ffb74d); }
  .token-price-stat.c-up { color: var(--success-color, #4caf50); }
  .token-price-stat.c-down { color: #ff7676; }
  .token-price-stat.c-teal { color: var(--teal-crystal, #00acc1); }
  .token-price-stat.c-muted { color: var(--text-inverse, #ffffff); opacity: 0.75; }

  /* Contract address — muted, monospace, prefixed with a separator */
  .token-ca {
    color: var(--text-inverse, #ffffff);
    opacity: 0.55;
    font-family: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 0.72rem;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(255, 183, 77, 0.25);
    white-space: nowrap;
    cursor: help;
  }

  .token-arrow {
    color: var(--amber-glow, #ffb74d);
    opacity: 0.7;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .token-banner-inner {
      font-size: 0.78rem;
      gap: 0.4rem;
      padding: 0.4rem 0.75rem;
      flex-wrap: nowrap; /* keep everything on ONE line */
    }

    /* Shorten the announcement on mobile — the full "is now live on Robinhood
       Chain" is too long and forces a second line. Just show "$GW Token". */
    .token-text-tail {
      display: none;
    }

    /* Hide the CA on small screens; keep the cycling stat. */
    .token-ca {
      display: none;
    }

    .token-badge {
      padding: 0.14rem 0.45rem 0.14rem 0.4rem;
      font-size: 0.6rem;
      gap: 0.25rem;
    }

    .token-price-label,
    .token-price-stat {
      font-size: 0.74rem;
    }

    .token-price {
      padding-left: 0.5rem;
      gap: 0.25rem;
    }
  }

  @media (max-width: 380px) {
    /* Very narrow phones — drop the LIVE badge text, keep just the dot. */
    .token-badge {
      font-size: 0;
      padding: 0.25rem;
    }
    .token-badge .token-dot {
      width: 7px;
      height: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .token-dot { animation: none; }
  }
</style>

<script>
  // Live $GW stats, fetched from DexScreener's free public API (no key,
  // Robinhood Chain 4663 supported). The banner CYCLES through several
  // metrics every few seconds so a single compact slot shows price, 24h
  // change, market cap, volume, and liquidity in turn — each color-coded.
  // Result cached in sessionStorage for 60s so navigating between pages
  // doesn't spam the API (free tier = 60 req/min).
  const GW_CA = '0x50bE7832849EFEdB15611799074FcC409522f27A';
  const CACHE_KEY = 'gacha-wiki:gw-stats';
  const CACHE_TTL = 60_000; // 60 seconds
  const ROTATE_MS = 3000; // how long each stat shows before cycling

  interface Stats {
    ts: number;
    price: number | null;
    change24h: number | null;
    change1h: number | null;
    mc: number | null;
    volume24h: number | null;
    liquidity: number | null;
  }

  function readCache(): Stats | null {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as Stats;
      if (Date.now() - parsed.ts < CACHE_TTL) return parsed;
    } catch {
      /* ignore */
    }
    return null;
  }

  function writeCache(data: Stats): void {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify(data));
    } catch {
      /* sessionStorage may be unavailable */
    }
  }

  // --- formatting helpers ------------------------------------------------

  function fmtPrice(usd: number): string {
    if (usd >= 1) return `$${usd.toFixed(4)}`;
    if (usd >= 0.0001) return `$${usd.toFixed(6)}`;
    return `$${usd.toPrecision(4)}`;
  }

  function fmtUsd(usd: number | null): string {
    if (usd == null || !isFinite(usd)) return '';
    if (usd >= 1e6) return `$${(usd / 1e6).toFixed(2)}M`;
    if (usd >= 1e3) return `$${(usd / 1e3).toFixed(1)}K`;
    return `$${usd.toFixed(0)}`;
  }

  function fmtPct(p: number | null): string {
    if (p == null || !isFinite(p)) return '';
    const sign = p >= 0 ? '+' : '';
    return `${sign}${p.toFixed(1)}%`;
  }

  // --- build the list of stats to cycle through --------------------------

  interface StatItem {
    text: string;
    colorClass: string;
  }

  function buildStats(s: Stats): StatItem[] {
    const items: StatItem[] = [];
    if (s.price != null) items.push({ text: fmtPrice(s.price), colorClass: 'c-amber' });
    if (s.change24h != null) {
      items.push({
        text: `24h ${fmtPct(s.change24h)}`,
        colorClass: s.change24h >= 0 ? 'c-up' : 'c-down',
      });
    }
    if (s.change1h != null) {
      items.push({
        text: `1h ${fmtPct(s.change1h)}`,
        colorClass: s.change1h >= 0 ? 'c-up' : 'c-down',
      });
    }
    if (s.mc != null) items.push({ text: `MC ${fmtUsd(s.mc)}`, colorClass: 'c-teal' });
    if (s.volume24h != null) items.push({ text: `Vol ${fmtUsd(s.volume24h)}`, colorClass: 'c-muted' });
    if (s.liquidity != null) items.push({ text: `Liq ${fmtUsd(s.liquidity)}`, colorClass: 'c-muted' });
    return items;
  }

  // --- render + cycle ----------------------------------------------------

  let rotateTimer: ReturnType<typeof setInterval> | undefined;

  function startCycling(stats: StatItem[]) {
    const chip = document.getElementById('gw-price-chip');
    const statEl = document.getElementById('gw-stat');
    if (!chip || !statEl || stats.length === 0) return;

    chip.hidden = false;
    let i = 0;

    const show = () => {
      const item = stats[i % stats.length];
      statEl.textContent = item.text;
      // reset color classes, apply this stat's color
      statEl.className = `token-price-stat ${item.colorClass}`;
      i++;
    };

    show(); // render the first stat immediately
    if (rotateTimer) clearInterval(rotateTimer);
    rotateTimer = setInterval(show, ROTATE_MS);
  }

  async function loadStats(): Promise<void> {
    // 1) Try the cache first (instant, no network).
    const cached = readCache();
    if (cached) {
      startCycling(buildStats(cached));
      return;
    }

    // 2) Fetch fresh data from DexScreener.
    try {
      const res = await fetch(
        `https://api.dexscreener.com/latest/dex/tokens/${GW_CA}`,
      );
      if (!res.ok) return;
      const json = (await res.json()) as {
        pairs?: Array<{
          chainId?: string;
          priceUsd?: string;
          fdv?: number;
          liquidity?: { usd?: number };
          volume?: { h24?: number };
          priceChange?: { h24?: number; h1?: number };
        }>;
      };

      // Prefer the Robinhood Chain pair; fall back to the first pair.
      const pairs = json.pairs ?? [];
      const pair = pairs.find(p => p.chainId === 'robinhood') ?? pairs[0];
      if (!pair) return;

      const stats: Stats = {
        ts: Date.now(),
        price: pair.priceUsd ? parseFloat(pair.priceUsd) : null,
        change24h: pair.priceChange?.h24 ?? null,
        change1h: pair.priceChange?.h1 ?? null,
        mc: pair.fdv ?? null,
        volume24h: pair.volume?.h24 ?? null,
        liquidity: pair.liquidity?.usd ?? null,
      };

      startCycling(buildStats(stats));
      writeCache(stats);
    } catch {
      /* network/parse failure — leave the chip hidden */
    }
  }

  // Defer the fetch until the browser is idle so it doesn't contend with
  // first paint on any page (the banner is in the global header). The chip
  // stays hidden until data arrives, so there's no visible downside.
  const start = () => {
    if ('requestIdleCallback' in window) {
      (window as Window).requestIdleCallback(() => loadStats(), { timeout: 4000 });
    } else {
      setTimeout(loadStats, 2000);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
</script>
