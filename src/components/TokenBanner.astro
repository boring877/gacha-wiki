---
// Site-wide banner announcing the GachaWiki ($GW) token launch.
// Token is LIVE on Robinhood Chain (4663). The banner links to the launchpad
// and shows a LIVE $GW price + market cap chip, fetched from DexScreener's
// free API (no key required, Robinhood Chain supported).
// The interactive Connect Wallet flow lives in the header (WalletButton.astro).
// Uses the SAME dark gradient + amber border as the Header/Footer so it
// reads as a natural part of the chrome, not a foreign element.
// Rendered in HomeLayout.astro (below the Header) so it shows on every page.
// To take down: remove this component and its import in HomeLayout.astro.
const LAUNCH_URL = 'https://www.ponsfamily.com/launchpad/0x50bE7832849EFEdB15611799074FcC409522f27A';
// Full contract address for verification (shown shortened in the banner)
const CA = '0x50bE7832849EFEdB15611799074FcC409522f27A';
const CA_SHORT = '0x50bE…f27A';
---

<a class="token-banner" href={LAUNCH_URL} target="_blank" rel="noopener noreferrer" aria-label="GachaWiki ($GW) token is now live on Robinhood Chain — view token">
  <div class="token-banner-inner">
    <span class="token-badge">
      <span class="token-dot" aria-hidden="true"></span>
      Live
    </span>
    <span class="token-text">
      <strong>$GW Token</strong>
      is now live on Robinhood Chain
    </span>

    <!-- Live price + market cap chip (populated by the script below).
         Hidden until data loads so there's no flash of "—". -->
    <span class="token-price" id="gw-price-chip" hidden>
      <span class="token-price-value" id="gw-price-value">$GW …</span>
      <span class="token-price-change" id="gw-price-change" hidden></span>
      <span class="token-mc" id="gw-mc" hidden></span>
    </span>

    <span class="token-ca" title={CA}>{CA_SHORT}</span>
    <svg class="token-arrow" width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M4 10h12m-6-6l6 6-6 6" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </div>
</a>

<style>
  /* Matches Header.astro / Footer.astro treatment exactly:
     same dark gradient background, same amber bottom border. */
  .token-banner {
    display: block;
    width: 100%;
    text-decoration: none;
    background: var(--bg-dark);
    border-bottom: 1px solid rgba(255, 183, 77, 0.3);
  }

  .token-banner-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.5rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    font-size: 0.88rem;
    color: var(--text-inverse, #ffffff);
  }

  /* LIVE chip — subtle, uses the same amber accent as the rest of the site */
  .token-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.16rem 0.55rem 0.16rem 0.45rem;
    border-radius: 999px;
    background: rgba(255, 183, 77, 0.1);
    border: 1px solid rgba(255, 183, 77, 0.3);
    color: var(--amber-glow, #ffb74d);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .token-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--success-color, #4caf50);
    box-shadow: 0 0 5px rgba(76, 175, 80, 0.7);
    animation: token-blink 2s ease-in-out infinite;
  }

  @keyframes token-blink {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.45; }
  }

  .token-text strong {
    color: var(--amber-glow, #ffb74d);
    font-weight: 700;
    margin-right: 0.15rem;
  }

  /* Live price + market cap chip.
     Separated from the announcement by a faint divider, monospace numbers. */
  .token-price {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(255, 183, 77, 0.25);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .token-price-value {
    color: var(--amber-glow, #ffb74d);
    font-weight: 700;
    font-size: 0.8rem;
  }

  .token-price-change {
    font-size: 0.7rem;
    font-weight: 600;
  }

  .token-price-change.is-up { color: var(--success-color, #4caf50); }
  .token-price-change.is-down { color: #ff7676; }

  .token-mc {
    color: var(--text-inverse, #ffffff);
    opacity: 0.6;
    font-size: 0.72rem;
  }

  /* Contract address — muted, monospace, prefixed with a separator */
  .token-ca {
    color: var(--text-inverse, #ffffff);
    opacity: 0.55;
    font-family: ui-monospace, "SF Mono", "Cascadia Mono", Menlo, Consolas, monospace;
    font-size: 0.72rem;
    padding-left: 0.65rem;
    border-left: 1px solid rgba(255, 183, 77, 0.25);
    white-space: nowrap;
    cursor: help;
  }

  .token-arrow {
    color: var(--amber-glow, #ffb74d);
    opacity: 0.7;
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .token-banner-inner {
      font-size: 0.8rem;
      gap: 0.5rem;
      padding: 0.45rem 1rem;
    }

    /* Hide the CA + market cap on small screens to avoid crowding;
       keep the live price since that's the headline number. */
    .token-ca,
    .token-mc {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .token-dot { animation: none; }
  }
</style>

<script>
  // Live $GW price + market cap, fetched from DexScreener's free public API.
  // No API key required; Robinhood Chain (4663) is supported. The result is
  // cached in sessionStorage for 60s so navigating between pages doesn't spam
  // the API (DexScreener's free tier is rate-limited to 60 req/min, and this
  // banner renders on every page via HomeLayout).
  const GW_CA = '0x50bE7832849EFEdB15611799074FcC409522f27A';
  const CACHE_KEY = 'gacha-wiki:gw-price';
  const CACHE_TTL = 60_000; // 60 seconds

  interface PriceCache {
    ts: number;
    price: number | null;
    change: number | null;
    mc: number | null;
  }

  function readCache(): PriceCache | null {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw) as PriceCache;
      if (Date.now() - parsed.ts < CACHE_TTL) return parsed;
    } catch {
      /* ignore */
    }
    return null;
  }

  function writeCache(data: PriceCache): void {
    try {
      sessionStorage.setItem(CACHE_KEY, JSON.stringify(data));
    } catch {
      /* sessionStorage may be unavailable */
    }
  }

  function formatPrice(usd: number): string {
    // $GW is a micro-cap token; show enough significant digits.
    if (usd >= 1) return `$${usd.toFixed(4)}`;
    if (usd >= 0.0001) return `$${usd.toFixed(6)}`;
    // Very small numbers — use scientific-ish notation with enough precision.
    return `$${usd.toPrecision(4)}`;
  }

  function formatMc(usd: number | null): string {
    if (usd == null || !isFinite(usd)) return '';
    if (usd >= 1e6) return `MC $${(usd / 1e6).toFixed(2)}M`;
    if (usd >= 1e3) return `MC $${(usd / 1e3).toFixed(1)}K`;
    return `MC $${usd.toFixed(0)}`;
  }

  function render(price: number | null, change: number | null, mc: number | null) {
    const chip = document.getElementById('gw-price-chip');
    const priceEl = document.getElementById('gw-price-value');
    const changeEl = document.getElementById('gw-price-change');
    const mcEl = document.getElementById('gw-mc');
    if (!chip || !priceEl || price == null) return;

    priceEl.textContent = `$GW ${formatPrice(price)}`;
    chip.hidden = false;

    if (changeEl && change != null && isFinite(change)) {
      const sign = change >= 0 ? '+' : '';
      changeEl.textContent = `${sign}${change.toFixed(1)}%`;
      changeEl.classList.toggle('is-up', change >= 0);
      changeEl.classList.toggle('is-down', change < 0);
      changeEl.hidden = false;
    }

    if (mcEl && mc != null && isFinite(mc)) {
      const txt = formatMc(mc);
      if (txt) {
        mcEl.textContent = txt;
        mcEl.hidden = false;
      }
    }
  }

  async function fetchPrice(): Promise<void> {
    // 1) Try the cache first (instant, no network).
    const cached = readCache();
    if (cached) {
      render(cached.price, cached.change, cached.mc);
      return;
    }

    // 2) Fetch fresh data from DexScreener.
    try {
      const res = await fetch(
        `https://api.dexscreener.com/latest/dex/tokens/${GW_CA}`,
      );
      if (!res.ok) return;
      const json = (await res.json()) as {
        pairs?: Array<{
          chainId?: string;
          priceUsd?: string;
          fdv?: number;
          priceChange?: { h24?: number };
        }>;
      };

      // Prefer the Robinhood Chain pair; fall back to the first pair.
      const pairs = json.pairs ?? [];
      const pair =
        pairs.find(p => p.chainId === 'robinhood') ?? pairs[0];
      if (!pair) return;

      const price = pair.priceUsd ? parseFloat(pair.priceUsd) : null;
      const change = pair.priceChange?.h24 ?? null;
      const mc = pair.fdv ?? null;

      render(price, change, mc);
      writeCache({ ts: Date.now(), price, change, mc });
    } catch {
      /* network/parse failure — leave the chip hidden */
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', fetchPrice);
  } else {
    fetchPrice();
  }
</script>
