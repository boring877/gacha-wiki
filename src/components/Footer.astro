---
const today = new Date();
import packageInfo from '../../package.json';
import SocialLinks from './SocialLinks.astro';
const version = packageInfo.version;
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <!-- Left Side: Version, License, and About -->
      <div class="footer-left">
        <div class="version-license-row">
          <a href="/about" class="footer-pill">About</a>
          <a
            href="https://github.com/boring877/gacha-wiki"
            target="_blank"
            rel="noopener noreferrer"
            class="version-link"
          >
            <div class="version-pill">
              v{version}
            </div>
          </a>
          <span class="license-text">
            Open source under <a href="/LICENSE" class="license-link">MIT License</a>
          </span>
        </div>
      </div>

      <!-- Center: Copyright -->
      <div class="footer-center">
        <p>© {today.getFullYear()} - I Hope You Have Wonderful Day ✨</p>
      </div>

      <!-- Right Side: Social Links + Crypto Donation -->
      <div class="footer-right">
        <SocialLinks />
        <div class="footer-donate">
          <button
            class="donate-button btc-donate"
            title="Copy BTC Address"
            data-address="bc1qdqzll9zp50jgs5kkrcfz9w2u60tk9q8ds05gx4"
            aria-label="Copy BTC address"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.638 14.904c-1.602 6.43-8.113 10.34-14.542 8.736C2.67 22.05-1.244 15.525.362 9.105 1.962 2.67 8.475-1.243 14.9.358c6.43 1.605 10.342 8.115 8.738 14.546zm-6.35-4.613c.24-1.59-.974-2.45-2.64-3.03l.54-2.153-1.315-.33-.52 2.1c-.347-.087-.7-.168-1.053-.25l.53-2.12-1.32-.33-.54 2.153c-.286-.065-.567-.13-.84-.2l-1.815-.45-.35 1.407s.974.224.954.238c.533.133.63.486.613.766l-.615 2.473c.037.01.085.024.137.047l-.14-.035-.86 3.46c-.065.16-.23.4-.6.31.013.02-.954-.24-.954-.24l-.65 1.51 1.71.426.93.24-.54 2.19 1.32.33.54-2.17c.36.1.71.19 1.05.273l-.54 2.14 1.32.33.54-2.18c2.24.42 3.93.25 4.64-1.77.57-1.63-.03-2.57-1.2-3.18.85-.2 1.5-.76 1.67-1.93zm-2.99 4.2c-.4 1.63-3.13.75-4.01.53l.72-2.87c.88.22 3.71.66 3.29 2.34zm.41-4.22c-.37 1.49-2.64.73-3.38.54l.65-2.6c.74.18 3.11.53 2.73 2.06z"/>
            </svg>
          </button>
          <button
            class="donate-button xmr-donate"
            title="Copy XMR Address"
            data-address="4AopuCr53mbHWekXMcpVfoc5Wza6oYxbpPm4nC88EjCbcv3cyG9vAk5EgBi1Q17qVuEuWZzMwF8YC2aVnjkTWz7aF86s3jW"
            aria-label="Copy Monero address"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2.182c5.424 0 9.818 4.394 9.818 9.818 0 5.424-4.394 9.818-9.818 9.818-5.424 0-9.818-4.394-9.818-9.818 0-5.424 4.394-9.818 9.818-9.818zM5.091 16.364V12l3.273 3.273V9.818L12 13.455l3.636-3.637v5.455L18.909 12v4.364h2.182v1.454H2.909v-1.454h2.182z"/>
            </svg>
          </button>
          <button
            class="donate-button eth-donate"
            title="Copy ETH Address"
            data-address="0x24B48C96876D4A56519f98bfa0A337E8E9bfCAe7"
            aria-label="Copy ETH address"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 17.97L4.58 13.62 11.943 24l7.37-10.38-7.372 4.35h.003zM12.056 0L4.69 12.223l7.365 4.354 7.365-4.35L12.056 0z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Footer Base Styles */
  .footer {
    background: linear-gradient(135deg, var(--bg-dark) 0%, #2a2a2a 50%, var(--bg-dark) 100%);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(255, 183, 77, 0.3);
    margin-top: auto;
  }

  .footer-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.75rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    min-height: 60px;
  }

  /* Footer Left: Version and License */
  .footer-left {
    display: flex;
    justify-content: flex-start;
  }

  /* Footer Center: Copyright */
  .footer-center {
    display: flex;
    justify-content: center;
  }

  .footer-center p {
    color: var(--text-inverse);
    font-size: 0.9rem;
    opacity: 0.9;
    font-weight: 500;
    margin: 0;
    line-height: 1.2;
  }

  /* Footer Right: Social Links */
  .footer-right {
    display: flex;
    justify-content: flex-end;
  }

  /* Version and License Row */
  .version-license-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .version-link {
    text-decoration: none;
    display: block;
    flex-shrink: 0;
  }

  .version-pill {
    background: var(--amber-glow);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-family: var(--font-display), sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bg-dark);
    text-align: center;
    cursor: pointer;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* About button — identical to the version pill (solid amber, dark text). */
  .footer-pill {
    background: var(--amber-glow);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-family: var(--font-display), sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bg-dark);
    text-align: center;
    cursor: pointer;
    min-height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .license-text {
    color: var(--text-inverse);
    font-size: 0.75rem;
    opacity: 0.7;
    margin: 0;
    line-height: 1.3;
  }

  .license-link {
    color: var(--amber-glow);
    text-decoration: none;
  }

  /* Hide footer completely on touch devices and small screens for cleaner mobile experience */
  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    .footer {
      display: none;
    }
  }

  /* Note: Mobile responsive styles removed since footer is hidden on touch devices */

  /* Touch Device Optimizations */
  @media (hover: none) and (pointer: coarse) {
    .version-pill {
      min-height: 48px;
      padding: 0.75rem 1.25rem;
    }
  }

  /* Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .version-pill {
      transition: none;
    }
  }

  /* Crypto Donation Buttons (moved here from homepage hero) */
  .footer-right {
    gap: 1rem;
  }

  .footer-donate {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .donate-button {
    color: var(--amber-glow);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 0.4rem;
    padding: 0.4rem;
    line-height: 0;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }

  .donate-button:hover {
    opacity: 1;
    background: rgba(255, 183, 77, 0.15);
    transform: translateY(-1px);
  }

  .donate-button.copied {
    opacity: 1;
    background: rgba(95, 212, 168, 0.2);
    color: #5fd4a8;
  }
</style>

<script>
  // Crypto copy-to-clipboard for footer donate buttons
  document.querySelectorAll('footer .donate-button').forEach((button) => {
    button.addEventListener('click', async () => {
      const address = button.getAttribute('data-address');
      if (address) {
        await navigator.clipboard.writeText(address);
        button.classList.add('copied');
        setTimeout(() => button.classList.remove('copied'), 800);
      }
    });
  });
</script>
