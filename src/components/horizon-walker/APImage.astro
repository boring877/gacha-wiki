---

// Import all AP guide images once

// Centralized AP image mapping
const apImageMap = {
  'img1.jpg': 'AP_recovery/img1.jpg',
  'img2.jpg': 'AP_recovery/img2.jpg',
  'img3.jpg': 'AP_recovery/img3.jpg',
  '../../assets/images/games/horizon-walker/AP_recovery/img1.jpg': 'AP_recovery/img1.jpg',
  '../../assets/images/games/horizon-walker/AP_recovery/img2.jpg': 'AP_recovery/img2.jpg',
  '../../assets/images/games/horizon-walker/AP_recovery/img3.jpg': 'AP_recovery/img3.jpg',
};

export interface Props {
  imageName: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
}

const {
  imageName,
  alt,
  width = 600,
  height = 400,
  class: className,
  loading = 'lazy',
  format = 'webp',
  quality = 85,
} = Astro.props;

// Get the imported image object from the map
const imageSrc = apImageMap[imageName];
import { r2Url } from '../../data/r2-config.js';
---

<img
  src={r2Url('horizon-walker', imageSrc)}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
/>
