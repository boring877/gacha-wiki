---

export interface Props {
  imageName: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
}

const {
  imageName,
  alt,
  width = 1200,
  height = 400,
  class: className,
  loading = 'eager',
  format = 'webp',
  quality = 85,
} = Astro.props;

// Map image names to imported image modules
const imageMap = {
  '/images/games/horizon-walker/gameimg/1.png': 'gameimg/1.png',
  '/images/games/horizon-walker/gameimg/2.png': 'gameimg/2.png',
  '/images/games/horizon-walker/gameimg/3.png': 'gameimg/3.png',
  '/images/games/horizon-walker/gameimg/4.png': 'gameimg/4.png',
  '/images/games/horizon-walker/gameimg/gameicon.jpg': 'gameimg/gameicon.jpg',
  '1.png': 'gameimg/1.png',
  '2.png': 'gameimg/2.png',
  '3.png': 'gameimg/3.png',
  '4.png': 'gameimg/4.png',
  'gameicon.jpg': 'gameimg/gameicon.jpg',
};

// Get the image module based on the imageName
const filename = imageName.split('/').pop() || '1.png';
const imageModule = imageMap[imageName] || imageMap[filename] || 'gameimg/1.png';
import { r2Url } from '../../data/r2-config.js';
---

<!-- Use Astro's Image component for optimization -->
<img
  src={r2Url('horizon-walker', imageModule)}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
/>
