---
// Horizon Walker background music player with two selectable tracks (With You,
// Platinum Sanctuary Adventure) and a header toggle. Persists across HW page
// navigations: preference + track in localStorage, per-track playback position
// in sessionStorage, and an autoplay-block fallback that resumes on the first
// user interaction.
interface Props {
  variant?: 'desktop' | 'mobile';
}
const { variant = 'desktop' } = Astro.props;
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/horizon-walker/audio';
const MUSIC_SRC = `${R2}/login-music.mp3?v=2`;
const MUSIC_SRC_2 = `${R2}/login-music-2.mp3?v=1`;
---

<div class={`hw-music ${variant === 'mobile' ? 'hw-music-mobile' : ''}`}>
  <button
    type="button"
    id="hw-music-toggle"
    class="hw-music-btn"
    aria-label="Toggle Horizon Walker background music"
    aria-pressed="false"
    title="Background music"
  >
    <svg class="hw-music-icon hw-music-on-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M9 18V6l10-2v12"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      ></path>
      <circle cx="6.5" cy="18" r="2.5" fill="currentColor"></circle>
      <circle cx="16.5" cy="16" r="2.5" fill="currentColor"></circle>
    </svg>
    <svg class="hw-music-icon hw-music-off-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M9 18V6l10-2v12"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      ></path>
      <circle cx="6.5" cy="18" r="2.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
    </svg>
    <span class="hw-music-label">Music</span>
  </button>
  <button
    type="button"
    class="hw-music-btn hw-music-track-btn"
    aria-label="Switch background music track"
    title="Background music track"
  >
    <span class="hw-music-track-num">1</span>
  </button>
  <audio id="hw-music-audio" src={MUSIC_SRC} loop preload="none"></audio>
</div>

<style>
  .hw-music {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
  }

  .hw-music-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #b3b3b3;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .hw-music-btn:first-child {
    border-radius: 999px 0 0 999px;
    border-right: none;
  }

  .hw-music-track-btn {
    border-radius: 0 999px 999px 0;
    min-width: 1.8rem;
    justify-content: center;
    padding: 0.35rem 0.5rem;
  }

  .hw-music-btn .hw-music-on-icon {
    display: none;
  }

  .hw-music-btn.playing {
    color: #e8a547;
    border-color: rgba(232, 165, 71, 0.4);
  }

  .hw-music-btn.playing + .hw-music-track-btn {
    border-color: rgba(232, 165, 71, 0.4);
    color: #e8a547;
  }

  .hw-music-btn.playing .hw-music-on-icon {
    display: block;
  }

  .hw-music-btn.playing .hw-music-off-icon {
    display: none;
  }

  .hw-music-track-num {
    min-width: 0.6rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .hw-music-label {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Desktop + mobile header instances both render; init once, bind all.
    if (window.__hwMusicInit) return;
    window.__hwMusicInit = true;

    document.addEventListener('DOMContentLoaded', function () {
      var audio = document.getElementById('hw-music-audio');
      var playBtns = document.querySelectorAll('#hw-music-toggle');
      var trackBtns = document.querySelectorAll('.hw-music-track-btn');
      if (!audio || !playBtns.length || !trackBtns.length) return;

      var TRACKS = [
        'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/horizon-walker/audio/login-music.mp3?v=2',
        'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/horizon-walker/audio/login-music-2.mp3?v=1'
      ];
      var PREF = 'hw-music-on';
      var TRACK = 'hw-music-track';

      function posKey() {
        return 'hw-music-pos-' + currentTrack();
      }

      function currentTrack() {
        var t = parseInt(localStorage.getItem(TRACK) || '0', 10);
        return t === 1 ? 1 : 0;
      }

      function setTrack(t, keepPlaying) {
        localStorage.setItem(TRACK, String(t));
        var wasPlaying = !audio.paused;
        if (!keepPlaying) wasPlaying = false;
        audio.src = TRACKS[t];
        trackBtns.forEach(function (b) {
          b.querySelector('.hw-music-track-num').textContent = String(t + 1);
        });
        var pos = parseFloat(sessionStorage.getItem(posKey()) || '0');
        if (isFinite(pos) && pos > 0) {
          try {
            audio.currentTime = pos;
          } catch (e) {}
        }
        if (wasPlaying) tryPlay();
      }

      function setPlaying(on) {
        playBtns.forEach(function (b) {
          b.classList.toggle('playing', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }

      function tryPlay() {
        audio.play().then(
          function () {
            setPlaying(true);
            localStorage.setItem(PREF, '1');
          },
          function () {
            // Autoplay blocked - resume on the first user interaction
            setPlaying(false);
            var resume = function () {
              audio.play().then(
                function () {
                  setPlaying(true);
                },
                function () {}
              );
              document.removeEventListener('pointerdown', resume);
              document.removeEventListener('keydown', resume);
            };
            document.addEventListener('pointerdown', resume);
            document.addEventListener('keydown', resume);
          }
        );
      }

      // restore track selection, then position for near-seamless playback
      var t = currentTrack();
      if (audio.src !== TRACKS[t]) audio.src = TRACKS[t];
      trackBtns.forEach(function (b) {
        b.querySelector('.hw-music-track-num').textContent = String(t + 1);
      });
      var pos = parseFloat(sessionStorage.getItem(posKey()) || '0');
      if (isFinite(pos) && pos > 0) {
        try {
          audio.currentTime = pos;
        } catch (e) {}
      }

      if (localStorage.getItem(PREF) === '1') {
        tryPlay();
      }

      audio.addEventListener('playing', function () {
        setPlaying(true);
      });
      audio.addEventListener('pause', function () {
        setPlaying(false);
      });

      setInterval(function () {
        if (!audio.paused) sessionStorage.setItem(posKey(), String(audio.currentTime));
      }, 1000);
      window.addEventListener('beforeunload', function () {
        if (!audio.paused) sessionStorage.setItem(posKey(), String(audio.currentTime));
      });

      playBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          if (audio.paused) {
            tryPlay();
          } else {
            audio.pause();
            localStorage.removeItem(PREF);
            sessionStorage.removeItem(posKey());
            setPlaying(false);
          }
        });
      });

      trackBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          setTrack(currentTrack() === 0 ? 1 : 0, true);
        });
      });
    });
  })();
</script>
