---
// Horizon Walker Rarity Icon Component
// Displays game-accurate tier icons for rarity grades (B, A, S, SS, EX)
// Tier mapping: 01=B, 02=A, 03=S, 04=SS, 05=EX


export interface Props {
  rarity: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  rarity,
  width = 48,
  height = 24,
  class: className,
  loading = 'lazy',
} = Astro.props;

const rarityMap: Record<string, string> = {
  B: 'tier-icons/UI_Tier_Icon_01.png',
  A: 'tier-icons/UI_Tier_Icon_02.png',
  S: 'tier-icons/UI_Tier_Icon_03.png',
  SS: 'tier-icons/UI_Tier_Icon_04.png',
  EX: 'tier-icons/UI_Tier_Icon_05.png',
};

const iconSrc = rarityMap[rarity] || 'tier-icons/UI_Tier_Icon_01.png';
import { r2Url } from '../../data/r2-config.js';
---

<img
  src={r2Url('horizon-walker', iconSrc)}
  alt={rarity}
  width={width}
  height={height}
  class={className || 'hw-rarity-icon'}
  loading={loading}
/>
