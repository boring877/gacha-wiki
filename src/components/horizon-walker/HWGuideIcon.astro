---


const guideIconMap = {
  'tier-list': 'guide-icons/FairyMall_Deco_FY_01_2.png',
  'builds': 'guide-icons/FairyMall_Deco_FY_01_8.png',
  'characters': 'guide-icons/FairyMall_Deco_FY_02_0.png',
  'mercenaries': 'guide-icons/FairyMall_Deco_FY_02_2.png',
  'weapons': 'guide-icons/FairyMall_Deco_FY_03_1.png',
  'stigmas': 'guide-icons/FairyMall_Deco_FY_04_2.png',
  'ap-guide': 'guide-icons/FairyMall_Deco_FY_04_6.png',
  'traits': 'guide-icons/FairyMall_Deco_FY_05_6.png',
  'stigma-sub-stats': 'guide-icons/FairyMall_Deco_FY_08_7.png',
  'gifts': 'guide-icons/FairyMall_Deco_FY_09_1.png',
  'character-gifts': 'guide-icons/FairyMall_Deco_FY_09_4.png',
  'clock': 'guide-icons/FairyMall_Deco_Mrm_01_0.png',
  'redeem-codes': 'guide-icons/FairyMall_Deco_Rarina_02_14.png',
  'demi': 'guide-icons/FairyMall_Deco_Rarina_03_12.png',
  'patch-notes': 'guide-icons/FairyMall_Deco_Rarina_03_19.png',
  'spare-1': 'guide-icons/FairyMall_Deco_Rarina_03_12.png',
  'spare-2': 'guide-icons/FairyMall_Deco_Rarina_03_19.png',
  'spare-3': 'guide-icons/FairyMall_Deco_Rarina_04_3.png',
};

export function getGuideIcon(guideId: string) {
  return guideIconMap[guideId] || 'guide-icons/FairyMall_Deco_FY_01_2.png';
}

export interface Props {
  guideId: string;
  alt?: string;
  width?: number;
  height?: number;
  class?: string;
}

const {
  guideId,
  alt = guideId,
  width = 48,
  height = 48,
  class: className,
} = Astro.props;

const imageSrc = guideIconMap[guideId] || 'guide-icons/FairyMall_Deco_FY_01_2.png';
import { r2Url } from '../../data/r2-config.js';
---

<img
  src={r2Url('horizon-walker', imageSrc)}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading="lazy"
  format="webp"
/>
