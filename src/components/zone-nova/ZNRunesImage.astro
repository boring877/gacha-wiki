---
// Zone Nova Rune image component — images served from Cloudflare R2
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/zone-nova/runes';

const runeImageMap = {
  'Alpha.jpg': `${R2}/Alpha.jpg`,
  'Beth.jpg': `${R2}/Beth.jpg`,
  'Daleth.jpg': `${R2}/Daleth.jpg`,
  'Epsilon.jpg': `${R2}/Epsilon.jpg`,
  'Giants.jpg': `${R2}/Giants.jpg`,
  'Gimel-Continuous-Damage.jpg': `${R2}/Gimel-Continuous-Damage.jpg`,
  'Hert-Pursuit-Damage.jpg': `${R2}/Hert-Pursuit-Damage.jpg`,
  'Shattered-Foundation.jpg': `${R2}/Shattered-Foundation.jpg`,
  'Tide.jpg': `${R2}/Tide.jpg`,
  'Zahn.jpg': `${R2}/Zahn.jpg`,
  'element.jpg': `${R2}/element.jpg`,
};

const {
  imageName,
  alt,
  width = 200,
  height = 200,
  class: className = '',
  loading = 'lazy',
} = Astro.props;

let imageKey = imageName || 'Alpha.jpg';
if (imageKey && imageKey.includes('/')) {
  const parts = imageKey.split('/');
  imageKey = parts[parts.length - 1] || 'Alpha.jpg';
}
if (imageKey && !imageKey.includes('.')) {
  imageKey = `${imageKey}.jpg`;
}

const imageSrc = runeImageMap[imageKey] || `${R2}/Alpha.jpg`;
---

<img
  src={imageSrc}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  decoding="async"
/>
