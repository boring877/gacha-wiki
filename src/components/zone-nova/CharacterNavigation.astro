---
import { ZONE_NOVA_CHARACTERS } from '../../data/zone-nova/characters';

const { currentCharacterSlug } = Astro.props;

// Get prev/next URLs (server-side)
const currentIndex = ZONE_NOVA_CHARACTERS.findIndex(char => char.slug === currentCharacterSlug);

// If character not found, fallback to first character in list
let prevUrl = '/guides/zone-nova/characters/';
let nextUrl = '/guides/zone-nova/characters/';
let prevCharacterName = '';
let nextCharacterName = '';

if (currentIndex !== -1) {
  // Previous character (wrap to end if at start)
  const prevIndex = currentIndex > 0 ? currentIndex - 1 : ZONE_NOVA_CHARACTERS.length - 1;
  prevUrl = ZONE_NOVA_CHARACTERS[prevIndex].detailUrl;
  prevCharacterName =
    ZONE_NOVA_CHARACTERS[prevIndex].name || ZONE_NOVA_CHARACTERS[prevIndex].id.toString();

  // Next character (wrap to start if at end)
  const nextIndex = currentIndex < ZONE_NOVA_CHARACTERS.length - 1 ? currentIndex + 1 : 0;
  nextUrl = ZONE_NOVA_CHARACTERS[nextIndex].detailUrl;
  nextCharacterName =
    ZONE_NOVA_CHARACTERS[nextIndex].name || ZONE_NOVA_CHARACTERS[nextIndex].id.toString();
} else {
  // Character not found - log for debugging and use first character
  console.warn(`Character not found: ${currentCharacterSlug}`);
  if (ZONE_NOVA_CHARACTERS.length > 0) {
    prevUrl = ZONE_NOVA_CHARACTERS[ZONE_NOVA_CHARACTERS.length - 1].detailUrl;
    nextUrl = ZONE_NOVA_CHARACTERS[0].detailUrl;
    prevCharacterName =
      ZONE_NOVA_CHARACTERS[ZONE_NOVA_CHARACTERS.length - 1].name ||
      ZONE_NOVA_CHARACTERS[ZONE_NOVA_CHARACTERS.length - 1].id.toString();
    nextCharacterName = ZONE_NOVA_CHARACTERS[0].name || ZONE_NOVA_CHARACTERS[0].id.toString();
  }
}
---

<script define:vars={{ prevUrl, nextUrl, prevCharacterName, nextCharacterName }}>
  document.addEventListener('keydown', e => {
    const target = e.target;
    if (
      target?.tagName === 'INPUT' ||
      target?.tagName === 'TEXTAREA' ||
      e.ctrlKey ||
      e.altKey ||
      e.metaKey
    )
      return;
    if (e.key === 'ArrowLeft') {
      e.preventDefault();
      window.location.href = prevUrl;
    } else if (e.key === 'ArrowRight') {
      e.preventDefault();
      window.location.href = nextUrl;
    }
  });

  // Side-tap navigation: a short, non-scrolling tap within EDGE_PX of either
  // screen edge goes to the previous/next character. Handled at document level
  // instead of fixed overlay divs — overlays with z-index would block the
  // wallet button, music toggle and sub-nav that sit near the right edge.
  // A tap that lands on an interactive element never navigates.
  const EDGE_PX = 48;
  // NOTE: this script is inline (define:vars) — plain JS only, no TS syntax.
  let tapStart = null;
  document.addEventListener(
    'touchstart',
    e => {
      const t = e.changedTouches[0];
      tapStart = { x: t.clientX, y: t.clientY, time: Date.now() };
    },
    { passive: true }
  );
  document.addEventListener(
    'touchend',
    e => {
      if (!tapStart) return;
      const t = e.changedTouches[0];
      const dur = Date.now() - tapStart.time;
      const moved = Math.hypot(t.clientX - tapStart.x, t.clientY - tapStart.y);
      const start = tapStart;
      tapStart = null;
      if (dur < 50 || dur > 400 || moved > 10) return;
      const el = document.elementFromPoint(t.clientX, t.clientY);
      if (el && el.closest('a, button, input, select, textarea, label, summary')) return;
      if (start.x <= EDGE_PX) {
        window.location.href = prevUrl;
      } else if (start.x >= window.innerWidth - EDGE_PX) {
        window.location.href = nextUrl;
      }
    },
    { passive: true }
  );
</script>
