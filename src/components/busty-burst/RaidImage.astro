---
import { R2 } from './bb-r2';

// Import all raid boss images

const imageMap: Record<string, string> = {
  'Boar_Beast.png':	R2 + '/RaidImg/Boar_Beast.webp',
  'Canine_Beast.png':	R2 + '/RaidImg/Canine_Beast.webp',
  'Avian_Beast.png':	R2 + '/RaidImg/Avian_Beast.webp',
  'Paladin.png':	R2 + '/RaidImg/Paladin.webp',
  'Assassin.png':	R2 + '/RaidImg/Assassin.webp',
  'The_Dark_Knight.png':	R2 + '/RaidImg/The_Dark_Knight.webp',
};

interface Props {
  fileName: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { fileName, alt, width = 80, height = 80, class: className } = Astro.props;
const imageSrc = imageMap[fileName];
---

{imageSrc && <img src={imageSrc} alt={alt} width={width} height={height} class={className} />}
