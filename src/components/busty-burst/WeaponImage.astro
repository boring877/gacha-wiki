---
import { R2 } from './bb-r2';

// Import all weapon images
// Hero/Evil God Series



// Annihilation Series

// Dragon Series

// Golden Wyvern Series

// Items

export interface Props {
  fileName: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { fileName, alt, width = 80, height = 80, class: className, loading = 'lazy' } = Astro.props;

// Map file names to imported image modules
const imageMap: Record<string, string> = {
  // Hero/Evil God Series
  'Cursed_Demon_Axe.png':	R2 + '/WPImg/Cursed_Demon_Axe.webp',
  'Sacred_Banishment_Sword.png':	R2 + '/WPImg/Sacred_Banishment_Sword.webp',
  'Heroic_Holy_Lance.png':	R2 + '/WPImg/Heroic_Holy_Lance.webp',
  "Master's_Staff.png": R2 + "/WPImg/Master's_Staff.webp",
  'War_Hammer.png':	R2 + '/WPImg/War_Hammer.webp',
  "Saint's_Staff.png": R2 + "/WPImg/Saint's_Staff.webp",
  'Azure_Sky_Bow.png':	R2 + '/WPImg/Azure_Sky_Bow.webp',
  'Thunder_Arrow.png':	R2 + '/WPImg/Thunder_Arrow.webp',
  'Twin_Star_Shuriken.png':	R2 + '/WPImg/Twin_Star_Shuriken.webp',
  'Cosmic_Crystal.png':	R2 + '/WPImg/Cosmic_Crystal.webp',
  // Annihilation Series
  'Sword_of_annihilation.png':	R2 + '/WPImg/Sword_of_annihilation.webp',
  'Ringblade_of_Annihilation.png':	R2 + '/WPImg/Ringblade_of_Annihilation.webp',
  'Spear_of_extermination.png':	R2 + '/WPImg/Spear_of_extermination.webp',
  'Wand_of_annihilation.png':	R2 + '/WPImg/Wand_of_annihilation.webp',
  'Gauntlet_of_Annihilation.png':	R2 + '/WPImg/Gauntlet_of_Annihilation.webp',
  'Staff_of_annihilation.png':	R2 + '/WPImg/Staff_of_annihilation.webp',
  'Crowwbow_of_annihilation.png':	R2 + '/WPImg/Crowwbow_of_annihilation.webp',
  'Bullet_of_annihilation.png':	R2 + '/WPImg/Bullet_of_annihilation.webp',
  'Axe_of_annihilation.png':	R2 + '/WPImg/Axe_of_annihilation.webp',
  'Magic_Grenade_of_annihilation.png':	R2 + '/WPImg/Magic_Grenade_of_annihilation.webp',
  // Dragon Series
  'Dragoncleaver_axe.png':	R2 + '/WPImg/Dragoncleaver_axe.webp',
  'Dragonflame_sword.png':	R2 + '/WPImg/Dragonflame_sword.webp',
  'Dragonclaw_spear.png':	R2 + '/WPImg/Dragonclaw_spear.webp',
  'Dragontail_staff.png':	R2 + '/WPImg/Dragontail_staff.webp',
  'Dragoneye_Hammer.png':	R2 + '/WPImg/Dragoneye_Hammer.webp',
  'Dragonmind_grimoire.png':	R2 + '/WPImg/Dragonmind_grimoire.webp',
  'Dragonwind_bow.png':	R2 + '/WPImg/Dragonwind_bow.webp',
  'Dragonpierce_arrow.png':	R2 + '/WPImg/Dragonpierce_arrow.webp',
  'Dragonfang_dagger.png':	R2 + '/WPImg/Dragonfang_dagger.webp',
  'Dragonburst_grenade.png':	R2 + '/WPImg/Dragonburst_grenade.webp',
  // Golden Wyvern Series
  'Golden_wyvern_greatsword.png':	R2 + '/WPImg/Golden_wyvern_greatsword.webp',
  'Golden_Wyvern_Chakram.png':	R2 + '/WPImg/Golden_Wyvern_Chakram.webp',
  'Golden_wyvern_lance.png':	R2 + '/WPImg/Golden_wyvern_lance.webp',
  'Golden_wyvern_staff.png':	R2 + '/WPImg/Golden_wyvern_staff.webp',
  'Golden_wyvern_gauntlets.png':	R2 + '/WPImg/Golden_wyvern_gauntlets.webp',
  'Golden_wyvern_rod.png':	R2 + '/WPImg/Golden_wyvern_rod.webp',
  'Golden_wyvern_longbow.png':	R2 + '/WPImg/Golden_wyvern_longbow.webp',
  'Golden_wyvern_arrow.png':	R2 + '/WPImg/Golden_wyvern_arrow.webp',
  'Golden_wyvern_dagger.png':	R2 + '/WPImg/Golden_wyvern_dagger.webp',
  'Golden_wyvern_grenade.png':	R2 + '/WPImg/Golden_wyvern_grenade.webp',
  // Items
  'Ancient_Artifact.jpg':	R2 + '/WPImg/Ancient_Artifact.webp',
};

// Get the image module based on the fileName
const imageModule = imageMap[fileName];
---

{
  imageModule && (
    <div class={`weapon-image-wrapper ${className || ''}`}>
      <img
        src={imageModule}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        class="weapon-image"
      />
    </div>
  )
}

<style>
  .weapon-image-wrapper {
    display: inline-block;
    overflow: hidden;
  }

  .weapon-image {
    display: block;
    object-fit: contain;
  }
</style>
