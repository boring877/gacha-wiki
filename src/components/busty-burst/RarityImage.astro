---
import { R2 } from './bb-r2';

// Import all rarity images

const imageMap: Record<string, string> = {
  R:	R2 + '/rarity_icons/R.webp',
  SR:	R2 + '/rarity_icons/SR.webp',
  SSR:	R2 + '/rarity_icons/SSR.webp',
};

interface Props {
  rarity: string;
  width?: number;
  height?: number;
  class?: string;
}

const { rarity, width = 32, height = 32, class: className } = Astro.props;
const imageSrc = imageMap[rarity];
---

{imageSrc && <img src={imageSrc} alt={rarity} width={width} height={height} class={className} />}
