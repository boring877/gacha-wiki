import bannerSeason1Lorelia from '../../assets/images/games/Busty_Burst/Banner_Img/banner-season-1-lorelia.jpg';
import bannerBeautyWitchPartyPeople from '../../assets/images/games/Busty_Burst/Banner_Img/banner-beauty-witch-party-people.png';
import bannerOctoOctoBeachPanic from '../../assets/images/games/Busty_Burst/Banner_Img/banner-octo-octo-beach-panic.png';
import bannerInfiniteSubjugationPastel from '../../assets/images/games/Busty_Burst/Banner_Img/banner-infinite-subjugation.png';
import bannerBladeOfJudgment from '../../assets/images/games/Busty_Burst/Banner_Img/banner-blade-of-judgment.png';
import bannerLapisMain7 from '../../assets/images/games/Busty_Burst/Banner_Img/banner-lapis.png';
import bannerValentineEvent13 from '../../assets/images/games/Busty_Burst/Banner_Img/banner-valentine.png';
import bannerTowerOfTrialsEvent8 from '../../assets/images/games/Busty_Burst/Banner_Img/banner-rosa.png';
import bannerVillainHalloween from '../../assets/images/games/Busty_Burst/Banner_Img/banner-villain-halloween.png';
import bannerInfiniteSubjugationRuru from '../../assets/images/games/Busty_Burst/Banner_Img/banner-infinite-subjugation-ruru.png';
import bannerSmileDance from '../../assets/images/games/Busty_Burst/Banner_Img/banner-smile-dance.png';
import bannerLustRaguen from '../../assets/images/games/Busty_Burst/Banner_Img/banner-lust-raguen.png';
import bannerBattleSeasonSetsuka from '../../assets/images/games/Busty_Burst/Banner_Img/banner-battle-season-setsuka.png';
import bannerBloodstainedBlade from '../../assets/images/games/Busty_Burst/Banner_Img/banner-bloodstained-blade.png';
import bannerSwiftWindUnicorn from '../../assets/images/games/Busty_Burst/Banner_Img/banner-swift-wind-unicorn.png';
import bannerPaladinIntroductionInrine from '../../assets/images/games/Busty_Burst/Banner_Img/banner-paladin-introduction-inrine.png';
import bannerPaladinIntroductionViatrice from '../../assets/images/games/Busty_Burst/Banner_Img/banner-paladin-introduction-viatrice.png';
import bannerPaladinIntroductionTrish from '../../assets/images/games/Busty_Burst/Banner_Img/banner-paladin-introduction-trish.png';
import bannerMagdalena from '../../assets/images/games/Busty_Burst/Banner_Img/banner-magdalena.png';
import bannerPaladinIntroductionDiana from '../../assets/images/games/Busty_Burst/Banner_Img/banner-paladin-introduction-diana.png';
import bannerPriscilla from '../../assets/images/games/Busty_Burst/Banner_Img/banner-priscilla.png';
import bannerLilith from '../../assets/images/games/Busty_Burst/Banner_Img/banner-lilith.png';
import bannerLilirara from '../../assets/images/games/Busty_Burst/Banner_Img/banner-lilirara.png';
import bannerHalfAnniversaryFionore from '../../assets/images/games/Busty_Burst/Banner_Img/banner-half-anniversary-fionore.png';
import bannerProjectBunny from '../../assets/images/games/Busty_Burst/Banner_Img/banner-project-bunny.png';
import bannerFatIsJustice from '../../assets/images/games/Busty_Burst/Banner_Img/banner-fat-is-justice.png';
import bannerChapter10Yaksha from '../../assets/images/games/Busty_Burst/Banner_Img/banner-chapter-10-yaksha.png';
import bannerTwinWitches from '../../assets/images/games/Busty_Burst/Banner_Img/banner-twin-witches.png';
import bannerBurstFes from '../../assets/images/games/Busty_Burst/Banner_Img/banner-burst-fes.png';
import bannerUnderboobCheerleader from '../../assets/images/games/Busty_Burst/Banner_Img/banner-underboob-cheerleader.png';
import bannerFanzine1st from '../../assets/images/games/Busty_Burst/Banner_Img/banner-fanzine-1st.png';
import bannerBurstMonth from '../../assets/images/games/Busty_Burst/Banner_Img/banner-burst-month.png';
import bannerBeastHuntress from '../../assets/images/games/Busty_Burst/Banner_Img/banner-beast-huntress.png';

// Image mapping by banner ID
const bannerImages: Record<string, ImageMetadata> = {
  'vern-founding-festival': bannerVernFestival,
  'shaty-chapter-6': bannerShatyChapter6,
  'holy-night-cookies': bannerHolyNightCookies,
  'new-year-2025-1': bannerNewYear2025_1,
  'new-year-2025-2': bannerNewYear2025_2,
  'new-year-2025-3': bannerNewYear2025_3,
  'season-1-lorelia': bannerSeason1Lorelia,
  'beauty-witch-party-people': bannerBeautyWitchPartyPeople,
  'octo-octo-beach-panic': bannerOctoOctoBeachPanic,
  'infinite-subjugation-pastel': bannerInfiniteSubjugationPastel,
  'blade-of-judgment': bannerBladeOfJudgment,
  'banner-lapis': bannerLapisMain7,
  'banner-valentine': bannerValentineEvent13,
  'banner-rosa': bannerTowerOfTrialsEvent8,
  'banner-villain-halloween': bannerVillainHalloween,
  'banner-infinite-subjugation-ruru': bannerInfiniteSubjugationRuru,
  'banner-smile-dance': bannerSmileDance,
  'banner-lust-raguen': bannerLustRaguen,
  'banner-battle-season-setsuka': bannerBattleSeasonSetsuka,
  'banner-bloodstained-blade': bannerBloodstainedBlade,
  'banner-swift-wind-unicorn': bannerSwiftWindUnicorn,
  'banner-paladin-introduction-inrine': bannerPaladinIntroductionInrine,
  'banner-paladin-introduction-viatrice': bannerPaladinIntroductionViatrice,
  'banner-paladin-introduction-trish': bannerPaladinIntroductionTrish,
  'magdalena-2108': bannerMagdalena,
  'banner-paladin-introduction-diana': bannerPaladinIntroductionDiana,
  'banner-priscilla': bannerPriscilla,
  'banner-lilith': bannerLilith,
  'banner-lilirara': bannerLilirara,
  'banner-half-anniversary-fionore': bannerHalfAnniversaryFionore,
  'banner-project-bunny': bannerProjectBunny,
  'banner-fat-is-justice': bannerFatIsJustice,
  'banner-chapter-10-yaksha': bannerChapter10Yaksha,
  'banner-twin-witches': bannerTwinWitches,
  'banner-burst-fes': bannerBurstFes,
  'banner-underboob-cheerleader': bannerUnderboobCheerleader,
  'banner-fanzine-1st': bannerFanzine1st,
  'banner-burst-month': bannerBurstMonth,
  'banner-beast-huntress': bannerBeastHuntress,
};

export interface Props {
  bannerId: string;
  alt: string;
  width?: number;
  height?: number;
}

const { bannerId, alt, width = 400, height = 225 } = Astro.props;

const imageSrc = bannerImages[bannerId];

// Get original image dimensions
const originalWidth = imageSrc?.width || width;
const originalHeight = imageSrc?.height || height;
---

{
  imageSrc && (
    <div class="bb-banner-image">
      <Image
        src={imageSrc}
        alt={alt}
        width={originalWidth}
        height={originalHeight}
        quality={90}
        class="bb-banner-image__img"
        loading="lazy"
      />
    </div>
  )
}

<style>
  .bb-banner-image {
    border-radius: 12px;
    overflow: hidden;
    flex-shrink: 0;
    border: 3px solid var(--bb-primary);
  }

  .bb-banner-image__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: inherit;
  }
</style>
