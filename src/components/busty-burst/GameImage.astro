---
import { R2 } from './bb-r2';

export interface Props {
  imageName: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
  format?: 'webp' | 'jpg' | 'png';
  quality?: number;
}

const {
  imageName,
  alt,
  width = 1200,
  height = 400,
  class: className,
  loading = 'eager',
} = Astro.props;

// Map image names to imported image modules - using actual Busty Burst game images
const imageMap = {
  'bg_02.webp':	R2 + '/BG/bg_02.webp',
  'gameLogo.webp':	R2 + '/BG/gameLogo.webp',
  'Icon.png':	R2 + '/BG/Icon.webp',
  'icon.png':	R2 + '/BG/Icon.webp',
  'hero.webp':	R2 + '/BG/gameLogo.webp',
  'busty-burst-hero.webp':	R2 + '/BG/gameLogo.webp',
  'busty-burst-bg.webp':	R2 + '/BG/bg_02.webp',
  'busty-burst-logo.webp':	R2 + '/BG/gameLogo.webp',
  'busty-burst-icon.webp':	R2 + '/BG/Icon.webp',
  'BG/bg_02.webp':	R2 + '/BG/bg_02.webp',
  'BG/gameLogo.webp':	R2 + '/BG/gameLogo.webp',
  'BG/Icon.png':	R2 + '/BG/Icon.webp',
};

// Get the image module based on the imageName
const filename = imageName.split('/').pop() || 'gameLogo.webp';
const imageModule = imageMap[imageName] || imageMap[filename] || gameLogo;
---

<!-- Use Astro's Image component for optimization -->
<img
  src={imageModule}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
/>
