---
import { R2 } from './bb-r2';
// LimitBreakIcon Component for Busty Burst
// Displays limit break level icons (0-5)


// Import limit break icons (normal size)

// Large icons

export interface Props {
  level: number; // 0-5
  size?: 'small' | 'medium' | 'large';
  width?: number;
  height?: number;
  class?: string;
}

const { level, size = 'medium', width, height, class: className } = Astro.props;

// Clamp level between 0 and 5
const lbLevel = Math.max(0, Math.min(5, level));

// Icon mappings by size - use normal icons for all sizes (better quality)
const normalIcons: Record<number, string> = { 0: R2 + '/limitover_icons/limitbreak_0.webp', 1: R2 + '/limitover_icons/limitbreak_1.webp', 2: R2 + '/limitover_icons/limitbreak_2.webp', 3: R2 + '/limitover_icons/limitbreak_3.webp', 4: R2 + '/limitover_icons/limitbreak_4.webp', 5: R2 + '/limitover_icons/limitbreak_5.webp' };
const largeIcons: Record<number, string> = { 0: R2 + '/limitover_icons/limitbreak_L_0.webp', 1: R2 + '/limitover_icons/limitbreak_L_1.webp', 2: R2 + '/limitover_icons/limitbreak_L_2.webp', 3: R2 + '/limitover_icons/limitbreak_L_3.webp', 4: R2 + '/limitover_icons/limitbreak_L_4.webp', 5: R2 + '/limitover_icons/limitbreak_L_5.webp' };

// Select icon based on size - use normal icons for small/medium, large icons for large
const iconMap = size === 'large' ? largeIcons : normalIcons;
const icon = iconMap[lbLevel as keyof typeof iconMap];

// Default dimensions based on size
const defaultSizes = {
  small: { width: 16, height: 16 },
  medium: { width: 24, height: 24 },
  large: { width: 32, height: 32 }
};

const finalWidth = width || defaultSizes[size].width;
const finalHeight = height || defaultSizes[size].height;
---

<img
  src={icon}
  alt={`Limit Break ${lbLevel}`}
  width={finalWidth}
  height={finalHeight}
  class:list={['bb-limit-break-icon', className]}
  loading="lazy"
/>

<style>
  .bb-limit-break-icon {
    display: inline-block;
    vertical-align: middle;
    object-fit: contain;
  }
</style>
