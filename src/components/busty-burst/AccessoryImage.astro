---
import { R2 } from './bb-r2';

// Import all accessory images
// Emerald

// Diamond

// Amethyst

// Gold

// Pearl

// Ruby

// Sapphire

// Amber

export interface Props {
  fileName: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { fileName, alt, width = 60, height = 60, class: className, loading = 'lazy' } = Astro.props;

// Map file names to imported image modules
const imageMap: Record<string, string> = {
  // Emerald
  'Emerald_Ring.png':	R2 + '/Accessory/Emerald_Ring.webp',
  'Emerald_Bracelet.png':	R2 + '/Accessory/Emerald_Bracelet.webp',
  'Emerald_Necklace.png':	R2 + '/Accessory/Emerald_Necklace.webp',
  'Emerald_Earrings.png':	R2 + '/Accessory/Emerald_Earrings.webp',
  'Emerald_Tiara.png':	R2 + '/Accessory/Emerald_Tiara.webp',
  // Diamond
  'Diamond_Ring.png':	R2 + '/Accessory/Diamond_Ring.webp',
  'Diamond_Bracelet.png':	R2 + '/Accessory/Diamond_Bracelet.webp',
  'Diamond_Necklace.png':	R2 + '/Accessory/Diamond_Necklace.webp',
  'Diamond_Earrings.png':	R2 + '/Accessory/Diamond_Earrings.webp',
  'Diamond_Tiara.png':	R2 + '/Accessory/Diamond_Tiara.webp',
  // Amethyst
  'Amethyst_Ring.png':	R2 + '/Accessory/Amethyst_Ring.webp',
  'Amethyst_Bracelet.png':	R2 + '/Accessory/Amethyst_Bracelet.webp',
  'Amethyst_Necklace.png':	R2 + '/Accessory/Amethyst_Necklace.webp',
  'Amethyst_Earring.png':	R2 + '/Accessory/Amethyst_Earring.webp',
  'Amethyst_Tiara.png':	R2 + '/Accessory/Amethyst_Tiara.webp',
  // Gold
  'Gold_Ring.png':	R2 + '/Accessory/Gold_Ring.webp',
  'Gold_Bracelet.png':	R2 + '/Accessory/Gold_Bracelet.webp',
  'Gold_Necklace.png':	R2 + '/Accessory/Gold_Necklace.webp',
  'Gold_Earrings.png':	R2 + '/Accessory/Gold_Earrings.webp',
  'Gold_Tiara.png':	R2 + '/Accessory/Gold_Tiara.webp',
  // Pearl
  'Pearl_Ring.png':	R2 + '/Accessory/Pearl_Ring.webp',
  'Pearl_Bracelet.png':	R2 + '/Accessory/Pearl_Bracelet.webp',
  'Pearl_Necklace.png':	R2 + '/Accessory/Pearl_Necklace.webp',
  'Pearl_Earrings.png':	R2 + '/Accessory/Pearl_Earrings.webp',
  'Pearl_Tiara.png':	R2 + '/Accessory/Pearl_Tiara.webp',
  // Ruby
  'Ruby_Ring.png':	R2 + '/Accessory/Ruby_Ring.webp',
  'Ruby_Bracelet.png':	R2 + '/Accessory/Ruby_Bracelet.webp',
  'Ruby_Necklace.png':	R2 + '/Accessory/Ruby_Necklace.webp',
  'Ruby_Earring.png':	R2 + '/Accessory/Ruby_Earring.webp',
  'Ruby_Tiara.png':	R2 + '/Accessory/Ruby_Tiara.webp',
  // Sapphire
  'Sapphire_Ring.png':	R2 + '/Accessory/Sapphire_Ring.webp',
  'Sapphire_Bracelet.png':	R2 + '/Accessory/Sapphire_Bracelet.webp',
  'Sapphire_Necklace.png':	R2 + '/Accessory/Sapphire_Necklace.webp',
  'Sapphire_Earring.png':	R2 + '/Accessory/Sapphire_Earring.webp',
  'Sapphire_Tiara.png':	R2 + '/Accessory/Sapphire_Tiara.webp',
  // Amber
  'Amber_Ring.png':	R2 + '/Accessory/Amber_Ring.webp',
  'Amber_Bracelet.png':	R2 + '/Accessory/Amber_Bracelet.webp',
  'Amber_Necklace.png':	R2 + '/Accessory/Amber_Necklace.webp',
  'Amber_Earring.png':	R2 + '/Accessory/Amber_Earring.webp',
  'Amber_Tiara.png':	R2 + '/Accessory/Amber_Tiara.webp',
};

// Get the image module based on the fileName
const imageModule = imageMap[fileName];
---

{
  imageModule && (
    <div class={`accessory-image-wrapper ${className || ''}`}>
      <img
        src={imageModule}
        alt={alt}
        width={width}
        height={height}
        loading={loading}
        class="accessory-image"
      />
    </div>
  )
}

<style>
  .accessory-image-wrapper {
    display: inline-block;
    overflow: hidden;
  }

  .accessory-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
