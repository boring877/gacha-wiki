---
import { R2 } from './bb-r2';

// Import all weapon inspiration icons

const weaponMap: Record<string, string> = {
  'Slash':	R2 + '/support_bonus_named/307_Slash_Inspiration.webp',
  'Pierce':	R2 + '/support_bonus_named/308_Pierce_Inspiration.webp',
  'Strike':	R2 + '/support_bonus_named/309_Strike_Inspiration.webp',
  'Shot':	R2 + '/support_bonus_named/310_Shot_Inspiration.webp',
  'Throw':	R2 + '/support_bonus_named/311_Throw_Inspiration.webp',
};

export interface Props {
  weapon: string; // Slash, Pierce, Strike, Shot, Throw
  width?: number;
  height?: number;
  class?: string;
}

const { weapon, width = 20, height = 20, class: className } = Astro.props;
const imageSrc = weaponMap[weapon];
---

{imageSrc && (
  <img
    src={imageSrc}
    alt={weapon}
    width={width}
    height={height}
    class={className}
  />
)}
