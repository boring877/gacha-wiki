---
import { R2 } from './bb-r2';

// Import all element images

const imageMap: Record<string, string> = {
  Fire:	R2 + '/Elements/Fire.webp',
  Water:	R2 + '/Elements/Water.webp',
  Wind:	R2 + '/Elements/Wind.webp',
  Light:	R2 + '/Elements/Light.webp',
  Dark:	R2 + '/Elements/Dark.webp',
  Mind:	R2 + '/Elements/Mind.webp',
  Holy: R2 + '/Elements/Light.webp', // Holy uses Light icon
  Magic: R2 + '/Elements/Dark.webp', // Magic uses Dark icon
};

interface Props {
  element: string;
  width?: number;
  height?: number;
  class?: string;
}

const { element, width = 24, height = 24, class: className } = Astro.props;
const imageSrc = imageMap[element];
---

{imageSrc && <img src={imageSrc} alt={element} width={width} height={height} class={className} />}
