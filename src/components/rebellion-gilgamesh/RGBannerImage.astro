---
// Rebellion Gilgamesh banner image component
// Displays gacha banner art from assets/images/games/rebellion-gilgamesh/banners/<id>.png
// Banner art is landscape (wide), so the wrapper uses cover-fit with a fixed aspect ratio.
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/images/games/rebellion-gilgamesh/banners/*.png',
  { eager: true }
);

export interface Props {
  image?: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { image, alt, class: className, loading = 'lazy' } = Astro.props;

function findImage(search: string): ImageMetadata | null {
  if (!search) return null;
  const key = Object.keys(images).find(k => k.includes(search));
  return key ? images[key].default : null;
}

const imageModule = findImage(image || '');
---

{imageModule ? (
  <div class={`rg-banner-img-wrapper ${className || ''}`}>
    <Image
      src={imageModule}
      alt={alt}
      widths={[400, 600]}
      sizes="(max-width: 768px) 100vw, 400px"
      loading={loading}
      format="webp"
      quality={90}
      class="rg-banner-img"
    />
  </div>
) : (
  <div class={`rg-banner-img-fallback ${className || ''}`}>
    <span>{alt.slice(0, 20)}</span>
  </div>
)}
