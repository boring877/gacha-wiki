---
// Rebellion Gilgamesh banner image component
// Displays gacha banner art from public/images/games/rebellion-gilgamesh/banners/<id>.png
// Uses public/ folder (plain URLs) instead of Astro Image to reduce build output.
export interface Props {
  image?: string;
  alt: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { image, alt, class: className, loading = 'lazy' } = Astro.props;
const imgUrl = image ? `/images/games/rebellion-gilgamesh/banners/${image}` : '';
---

{imgUrl ? (
  <div class={`rg-banner-img-wrapper ${className || ''}`}>
    <img
      src={imgUrl}
      alt={alt}
      loading={loading}
      class="rg-banner-img"
      onerror="this.style.display='none';this.parentElement.classList.add('rg-banner-img-fallback');this.parentElement.innerHTML='<span>'+(this.alt.slice(0,20))+'</span>'"
    />
  </div>
) : (
  <div class={`rg-banner-img-fallback ${className || ''}`}>
    <span>{alt.slice(0, 20)}</span>
  </div>
)}
