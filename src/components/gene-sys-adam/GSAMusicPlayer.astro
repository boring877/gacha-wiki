---
// Gene-Sys: Adam background music player with three selectable tracks:
// 1 = the official site theme (the landing page's own BGM, 1:10), 2 = the
// game's main theme (Bgm_Main), 3 = the lobby theme (Bgm_lobby3), tracks 2-3
// extracted from the client's systembgm bundles (mirror-swap descrambled,
// UnityPy AudioClip decode, 128k mp3 on R2). Persists across GSA page
// navigations: preference + track in localStorage, per-track playback position
// in sessionStorage, autoplay-block fallback resumes on first interaction.
interface Props {
  variant?: 'desktop' | 'mobile';
}
const { variant = 'desktop' } = Astro.props;
const R2 = 'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/gene-sys-adam/audio';
const MUSIC_SRC = `${R2}/bgm-site.mp3`;
const MUSIC_SRC_2 = `${R2}/bgm-main.mp3`;
const MUSIC_SRC_3 = `${R2}/bgm-lobby.mp3`;
---

<div class={`gsa-music ${variant === 'mobile' ? 'gsa-music-mobile' : ''}`}>
  <button
    type="button"
    class="gsa-music-btn"
    aria-label="Toggle Gene-Sys: Adam background music"
    aria-pressed="false"
    title="Background music"
  >
    <svg class="gsa-music-icon gsa-music-on-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M9 18V6l10-2v12"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      ></path>
      <circle cx="6.5" cy="18" r="2.5" fill="currentColor"></circle>
      <circle cx="16.5" cy="16" r="2.5" fill="currentColor"></circle>
    </svg>
    <svg class="gsa-music-icon gsa-music-off-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <path
        d="M9 18V6l10-2v12"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      ></path>
      <circle cx="6.5" cy="18" r="2.5" fill="none" stroke="currentColor" stroke-width="2"></circle>
      <line x1="3" y1="3" x2="21" y2="21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-line></line>
    </svg>
    <span class="gsa-music-label">Music</span>
  </button>
  <button
    type="button"
    class="gsa-music-btn gsa-music-track-btn"
    aria-label="Switch background music track"
    title="Background music track"
  >
    <span class="gsa-music-track-num">1</span>
  </button>
  {/* One shared audio per page: only the desktop header instance renders it */}
  {variant === 'desktop' && <audio id="gsa-music-audio" src={MUSIC_SRC} loop preload="none"></audio>}
</div>

<style>
  .gsa-music {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
  }

  .gsa-music-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--gsa-border, #3d3236);
    color: #b3a8ab;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }

  .gsa-music-btn:first-child {
    border-radius: 999px 0 0 999px;
    border-right: none;
  }

  .gsa-music-track-btn {
    border-radius: 0 999px 999px 0;
    min-width: 1.8rem;
    justify-content: center;
    padding: 0.35rem 0.5rem;
  }

  .gsa-music-btn .gsa-music-on-icon {
    display: none;
  }

  .gsa-music-btn.playing {
    color: #e0596b;
    border-color: rgba(224, 89, 107, 0.4);
  }

  .gsa-music-btn.playing + .gsa-music-track-btn {
    border-color: rgba(224, 89, 107, 0.4);
    color: #e0596b;
  }

  .gsa-music-btn.playing .gsa-music-on-icon {
    display: block;
  }

  .gsa-music-btn.playing .gsa-music-off-icon {
    display: none;
  }

  .gsa-music-track-num {
    min-width: 0.6rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .gsa-music-label {
      display: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Desktop + mobile header instances both render; init once, bind all.
    if (window.__gsaMusicInit) return;
    window.__gsaMusicInit = true;

    document.addEventListener('DOMContentLoaded', function () {
      var audio = document.getElementById('gsa-music-audio');
      var playBtns = document.querySelectorAll('.gsa-music-btn:not(.gsa-music-track-btn)');
      var trackBtns = document.querySelectorAll('.gsa-music-track-btn');
      if (!audio || !playBtns.length || !trackBtns.length) return;

      var TRACKS = [
        'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/gene-sys-adam/audio/bgm-site.mp3',
        'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/gene-sys-adam/audio/bgm-main.mp3',
        'https://pub-dd9a9c01bc7a43d0bb977b255815a5c4.r2.dev/gene-sys-adam/audio/bgm-lobby.mp3'
      ];
      var PREF = 'gsa-music-on';
      var TRACK = 'gsa-music-track';

      function posKey() {
        return 'gsa-music-pos-' + currentTrack();
      }

      function currentTrack() {
        var t = parseInt(localStorage.getItem(TRACK) || '0', 10);
        return t >= 0 && t < TRACKS.length ? t : 0;
      }

      function setTrack(t, keepPlaying) {
        localStorage.setItem(TRACK, String(t));
        var wasPlaying = !audio.paused;
        if (!keepPlaying) wasPlaying = false;
        audio.src = TRACKS[t];
        trackBtns.forEach(function (b) {
          b.querySelector('.gsa-music-track-num').textContent = String(t + 1);
        });
        var pos = parseFloat(sessionStorage.getItem(posKey()) || '0');
        if (isFinite(pos) && pos > 0) {
          try {
            audio.currentTime = pos;
          } catch (e) {}
        }
        if (wasPlaying) tryPlay();
      }

      function setPlaying(on) {
        playBtns.forEach(function (b) {
          b.classList.toggle('playing', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }

      function tryPlay() {
        audio.play().then(
          function () {
            setPlaying(true);
            localStorage.setItem(PREF, '1');
          },
          function () {
            // Autoplay blocked - resume on the first user interaction
            setPlaying(false);
            var resume = function () {
              audio.play().then(
                function () {
                  setPlaying(true);
                },
                function () {}
              );
              document.removeEventListener('pointerdown', resume);
              document.removeEventListener('keydown', resume);
            };
            document.addEventListener('pointerdown', resume);
            document.addEventListener('keydown', resume);
          }
        );
      }

      // restore track selection, then position for near-seamless playback
      var t = currentTrack();
      if (audio.src !== TRACKS[t]) audio.src = TRACKS[t];
      trackBtns.forEach(function (b) {
        b.querySelector('.gsa-music-track-num').textContent = String(t + 1);
      });
      var pos = parseFloat(sessionStorage.getItem(posKey()) || '0');
      if (isFinite(pos) && pos > 0) {
        try {
          audio.currentTime = pos;
        } catch (e) {}
      }

      if (localStorage.getItem(PREF) === '1') {
        tryPlay();
      }

      audio.addEventListener('playing', function () {
        setPlaying(true);
      });
      audio.addEventListener('pause', function () {
        setPlaying(false);
      });

      setInterval(function () {
        if (!audio.paused) sessionStorage.setItem(posKey(), String(audio.currentTime));
      }, 1000);
      window.addEventListener('beforeunload', function () {
        if (!audio.paused) sessionStorage.setItem(posKey(), String(audio.currentTime));
      });

      playBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          if (audio.paused) {
            tryPlay();
          } else {
            audio.pause();
            localStorage.removeItem(PREF);
            sessionStorage.removeItem(posKey());
            setPlaying(false);
          }
        });
      });

      trackBtns.forEach(function (b) {
        b.addEventListener('click', function () {
          setTrack((currentTrack() + 1) % TRACKS.length, true);
        });
      });
    });
  })();
</script>
