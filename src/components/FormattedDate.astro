---
// All callers pass date-only data (parsed as UTC midnight), so formatting is
// pinned to UTC to stay identical on any build machine
interface Props {
  date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString('en-us', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    })
  }
</time>
